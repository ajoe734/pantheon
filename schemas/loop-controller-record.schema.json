{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoopControllerRecord",
  "type": "object",
  "required": [
    "loop_id",
    "tenant_id",
    "environment",
    "controller_id",
    "controller_name",
    "deployment_sha",
    "desired_state_query",
    "actual_state_query",
    "desired_state",
    "downstream_actual_state",
    "last_heartbeat_at",
    "last_tick_at",
    "last_success_at",
    "last_failure_at",
    "last_failure_reason",
    "last_repair_at",
    "last_repair_reason",
    "backlog",
    "lag",
    "dlq_count",
    "evidence_refs",
    "truth_level",
    "lease_token",
    "lease_expires_at",
    "payload"
  ],
  "properties": {
    "loop_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "controller_id": { "type": "string", "minLength": 1 },
    "controller_name": { "type": "string", "minLength": 1 },
    "deployment_sha": { "type": "string", "minLength": 1 },
    "desired_state_query": { "type": ["string", "null"] },
    "actual_state_query": { "type": ["string", "null"] },
    "desired_state": {
      "type": ["object", "null"],
      "required": ["present", "source", "checked_at"],
      "properties": {
        "present": { "type": "boolean" },
        "source": { "type": "string", "minLength": 1 },
        "checked_at": { "type": "string", "format": "date-time" },
        "summary": { "type": ["string", "null"] },
        "sources": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "downstream_actual_state": {
      "type": ["object", "null"],
      "required": ["status", "source", "checked_at"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "checked_at": { "type": "string", "format": "date-time" },
        "summary": { "type": ["string", "null"] },
        "sources": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "last_heartbeat_at": { "type": ["string", "null"], "format": "date-time" },
    "last_tick_at": { "type": ["string", "null"], "format": "date-time" },
    "last_success_at": { "type": ["string", "null"], "format": "date-time" },
    "last_failure_at": { "type": ["string", "null"], "format": "date-time" },
    "last_failure_reason": { "type": ["string", "null"] },
    "last_repair_at": { "type": ["string", "null"], "format": "date-time" },
    "last_repair_reason": { "type": ["string", "null"] },
    "backlog": { "type": ["integer", "null"], "minimum": 0 },
    "lag": { "type": ["integer", "null"], "minimum": 0 },
    "dlq_count": { "type": ["integer", "null"], "minimum": 0 },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "truth_level": {
      "type": "string",
      "enum": [
        "seed_fixture",
        "snapshot_fallback",
        "registry_metadata",
        "scheduled_tick",
        "reconciled_live_proof",
        "proven_live_evidence"
      ]
    },
    "lease_token": { "type": ["string", "null"], "minLength": 1 },
    "lease_expires_at": { "type": ["string", "null"], "format": "date-time" },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}

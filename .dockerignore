# The BFF signs canonical-mutation assertions with its private key, and its
# writer verifies them through this one shared module.  Keep every runtime
# artifact out of images, but retain this source-only module so the BFF image
# can import it at startup.
.orchestrator/*
!.orchestrator/canonical_mutation_assertion.py
.venv*
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
node_modules
docs-site
ai-task-archive
support/evidence
support/evidence/**
lean/Tests
lean/Tests/**
current-work.md
ai-status.json
ai-activity-log.jsonl
.coordination
lean/Data
tmp
.worktrees
.worktrees/**
.fe-ep
.fe-ep/**
.fe-human-inbox-persona-focus
.fe-human-inbox-persona-focus/**
archive
archive/**

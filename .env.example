# Pantheon single-VM environment contract.
# Copy to .env and fill in real secrets before running bootstrap.sh.
# All variables listed here are required unless marked OPTIONAL.
#
# Usage:
#   cp .env.example .env
#   # edit .env with real values
#   bash scripts/bootstrap.sh

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pantheon
POSTGRES_PORT=15432

PANTHEON_APP_DB_USER=pantheon_app
PANTHEON_APP_DB_PASSWORD=pantheon_app
PANTHEON_APP_DB_NAME=pantheon
DATABASE_URL=postgresql://pantheon_app:pantheon_app@postgres:5432/pantheon
TELEMETRY_DB_DSN=postgresql://pantheon_app:pantheon_app@postgres:5432/pantheon

# ---------------------------------------------------------------------------
# MinIO / Artifacts
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=pantheon
MINIO_ROOT_PASSWORD=pantheonminio
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_DEFAULT_BUCKETS=pantheon-artifacts
PANTHEON_S3_ENDPOINT=http://minio:9000
PANTHEON_S3_ACCESS_KEY=pantheon
PANTHEON_S3_SECRET_KEY=pantheonminio
PANTHEON_ARTIFACT_BUCKET=pantheon-artifacts

# ---------------------------------------------------------------------------
# NATS / Messaging
# ---------------------------------------------------------------------------
NATS_PORT=14222
NATS_MONITOR_PORT=18222
PANTHEON_NATS_URL=nats://nats:4222

# ---------------------------------------------------------------------------
# BFF / Control plane
# ---------------------------------------------------------------------------
BFF_PORT=8001
# OPTIONAL: set to "live" once the execution plane is running
BFF_READ_SURFACE_STATE=degraded
PANTHEON_BFF_ALLOW_LOCAL_SNAPSHOT_FALLBACK=false
PANTHEON_BFF_SERVICE_TIMEOUT_SECONDS=2.0
# Persona create/readback state is durable by default. Compose maps its DSN
# directly from DATABASE_URL so the BFF cannot drift to a second database.
PANTHEON_PERSONA_PROVISIONING_STORE_BACKEND=postgres
PANTHEON_PERSONA_PROVISIONING_STORE_SCHEMA=bff
PANTHEON_PAPER_FLEET_RECONCILER_URL=http://paper-fleet-reconciler:8011
# Required by persona scheduling. The single-VM stack owns this adapter service;
# production/control deployments must instead configure an explicitly reachable
# endpoint and must never leave the value blank (blank would select dry-run).
PANTHEON_OPENCLAW_GATEWAY_ADAPTER_URL=http://openclaw-gateway-adapter:8104
PANTHEON_OPENCLAW_ADAPTER_SERVICE_TOKEN=replace-me-openclaw-adapter-service-token
# OPTIONAL: URL of the internal command API (execution plane)
PANTHEON_INTERNAL_API_URL=
PANTHEON_INTERNAL_API_TOKEN=
# OPTIONAL: URL of the runtime-manager (VM-2)
PANTHEON_RUNTIME_MANAGER_URL=
PANTHEON_RUNTIME_MANAGER_TOKEN=
# Governance-api service family discovery URLs.
PANTHEON_GOVERNANCE_APPROVAL_API_URL=http://governance:8082
PANTHEON_DEPLOYMENT_API_URL=http://deployment:8095
PANTHEON_CAPITAL_API_URL=http://capital:8092
PANTHEON_EVOLUTION_API_URL=http://evolution:8093
PANTHEON_INCIDENTS_API_URL=http://incidents:8090
PANTHEON_POSTMORTEMS_API_URL=http://postmortems:8091
PANTHEON_TELEMETRY_API_URL=http://telemetry:8083
PANTHEON_LINEAGE_READ_URL=http://lineage-read:8094
PANTHEON_REGISTRY_API_URL=http://registry:8087

# ---------------------------------------------------------------------------
# Persona service
# ---------------------------------------------------------------------------
PERSONA_PORT=8002
# Backend for LLM calls: anthropic | openai | stub
LLM_BACKEND=anthropic
# OPTIONAL: API keys used by the chosen LLM_BACKEND
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Telemetry service
# ---------------------------------------------------------------------------
TELEMETRY_PORT=8083
TELEMETRY_STORAGE_DIR=/data/telemetry

# ---------------------------------------------------------------------------
# Evaluation service
# ---------------------------------------------------------------------------
EVALUATION_PORT=8084

# ---------------------------------------------------------------------------
# Feedback service
# ---------------------------------------------------------------------------
FEEDBACK_PORT=8085

# ---------------------------------------------------------------------------
# Memory service
# ---------------------------------------------------------------------------
MEMORY_PORT=8086

# ---------------------------------------------------------------------------
# Registry service
# ---------------------------------------------------------------------------
REGISTRY_PORT=8087

# ---------------------------------------------------------------------------
# Optimizer service
# ---------------------------------------------------------------------------
OPTIMIZER_PORT=8088

# ---------------------------------------------------------------------------
# Promotion service
# ---------------------------------------------------------------------------
PROMOTION_PORT=8089
PROMOTION_DATA_DIR=/data/promotion

# ---------------------------------------------------------------------------
# Incidents service
# ---------------------------------------------------------------------------
INCIDENTS_PORT=8090
INCIDENTS_DATA_DIR=/data/incidents
# Tenant used when Incident validates canonical Telemetry lineage. It must be
# included in PANTHEON_TELEMETRY_SERVICE_TENANTS.
PANTHEON_INCIDENTS_TENANT_ID=
# A runtime-binding projection may include thousands of canonical event refs.
PANTHEON_TELEMETRY_TIMEOUT_SECONDS=45
# Each drift report carries one event. Reconciliation waits for Incident's
# projection plus that event trace, with margin below the 120-second work lease.
PANTHEON_INCIDENTS_API_TIMEOUT_SECONDS=110

# ---------------------------------------------------------------------------
# Postmortems service
# ---------------------------------------------------------------------------
POSTMORTEMS_PORT=8091

# ---------------------------------------------------------------------------
# Capital service
# ---------------------------------------------------------------------------
CAPITAL_PORT=8092
CAPITAL_DATA_DIR=/data/capital

# ---------------------------------------------------------------------------
# Evolution service
# ---------------------------------------------------------------------------
EVOLUTION_PORT=8093
EVOLUTION_DATA_DIR=/data/evolution

# ---------------------------------------------------------------------------
# Deployment service
# ---------------------------------------------------------------------------
DEPLOYMENT_PORT=8095
DEPLOYMENT_DATA_DIR=/data/governance

# ---------------------------------------------------------------------------
# Lineage-read service
# ---------------------------------------------------------------------------
LINEAGE_PORT=8094
LINEAGE_DATA_DIR=/data/lineage

# ---------------------------------------------------------------------------
# Assistant OpenClaw Gateway Credential Mounts
# ---------------------------------------------------------------------------
PANTHEON_ASSISTANT_CODEX_HOST_HOME=/srv/pantheon-assistant/.codex
PANTHEON_ASSISTANT_CODEX_CONTAINER_HOME=/home/pantheon-assistant/.codex
PANTHEON_ASSISTANT_CLAUDE_HOST_CONFIG_DIR=/srv/pantheon-assistant/.claude
PANTHEON_ASSISTANT_CLAUDE_CONTAINER_CONFIG_DIR=/home/pantheon-assistant/.claude
PANTHEON_ASSISTANT_CREDENTIAL_MOUNT_MODE=rw
PANTHEON_ASSISTANT_REPAIR_WORKTREE_ROOT=/srv/pantheon-assistant/worktrees

# ---------------------------------------------------------------------------
# Assistant orchestrator status readback
# ---------------------------------------------------------------------------
# BFF reads these files without shell access so Management AI can report
# supervisor, worker, queue, PR, deployment, and DevTaskPacket bridge state.
# Point the host path at the runtime repo/status root on the VM; it is mounted
# read-only inside the BFF container.
PANTHEON_STATUS_ROOT_HOST=.
PANTHEON_STATUS_ROOT_CONTAINER=/workspace/status-root

# ---------------------------------------------------------------------------
# Assistant kernel control mode
# ---------------------------------------------------------------------------
# Keep disabled unless a non-production operator has configured the passphrase
# through /bff/assistant/control-mode/passphrase and needs short-lived
# SA/SD/dev-task handoff or repair workflows.
PANTHEON_ASSISTANT_KERNEL_ENABLED=false
PANTHEON_ASSISTANT_CONTROL_MODE_STORE_PATH=/data/bff/assistant-control-mode.json
PANTHEON_ASSISTANT_CONTROL_IDLE_TTL_SECONDS=300
# Dev stub auth only: comma-separated claims added to colon-format bearer tokens.
# Example for local repair smoke: assistant.kernel.debug,assistant.kernel.repair
PANTHEON_BFF_STUB_CAPABILITIES=

# ---------------------------------------------------------------------------
# Policy-learning imitation loop (L12-IMIT-001)
# ---------------------------------------------------------------------------
# The direct shadow-eval and worker routes are authenticated and tenant-bound.
# policy-learning-svc and the policy-learning-shadow-eval-scheduler sidecar must
# share one credential and one tenant scope, or every scheduled tick is a 401.
# Compose defaults to a published local-cluster token, and the placeholder
# below is published here. The service refuses BOTH once
# PANTHEON_PERSISTENCE_POSTURE is staging/prod - it reports itself unconfigured
# and answers 401 rather than authenticating a credential anyone can read off
# GitHub - so mint a real secret here for any deployment beyond a developer
# laptop. Other unedited fill-me-in shapes (changeme, example-*, your-*, a bare
# "secret") are refused the same way.
POLICY_LEARNING_SERVICE_TOKEN=replace-me-policy-learning-service-token
# Separate operator-BFF internal handoff credential. It must not equal the
# policy-learning credential above; the scheduler refuses credential replay.
AGORA_HANDOFF_SERVICE_TOKEN=replace-me-agora-handoff-service-token
AGORA_HANDOFF_SERVICE_TENANTS=
# Tenants the service credential is authorized for. Defaults to the scheduler's
# tenant; widen it (comma-separated) when more than one tenant is scheduled.
POLICY_LEARNING_SERVICE_TENANTS=
# Tenant the scheduler discovers Agora DatasetVersions under. Required.
POLICY_LEARNING_AGORA_TENANT_ID=pantheon-local
# OPTIONAL: narrow discovery to one user inside that tenant.
POLICY_LEARNING_AGORA_USER_ID=
# OPTIONAL: read agora.agora_dataset_records through a dedicated read role
# instead of the shared DATABASE_URL identity.
AGORA_DATASET_STORE_BACKEND=
AGORA_DATASET_STORE_DSN=
AGORA_DATASET_STORE_SCHEMA=agora

# Consultation executor -> Governance advisory handoff boundary. These are
# machine credentials, not BFF/Governance user JWTs.
CONSULTATION_HANDOFF_TOKEN=replace-me-consultation-handoff-token
CONSULTATION_HANDOFF_ALLOWED_TENANTS=

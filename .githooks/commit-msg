#!/usr/bin/env bash
# Enforce Pantheon commit conventions documented in
# docs/conventions/GIT_WORKFLOW.md §7.
#
# Runs two checks against the in-progress commit:
#   1. check_commit_trailers.py — required trailers + subject format
#   2. check_commit_scope.py    — index sweep-in / task scope guard
#
# Bypass envvars:
#   PANTHEON_TRAILER_CHECK_DISABLED=1
#   PANTHEON_SCOPE_CHECK_DISABLED=1

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MSG_FILE="$1"

python3 "$ROOT_DIR/scripts/git/check_commit_trailers.py" --message-file "$MSG_FILE"

if [[ "${PANTHEON_SCOPE_CHECK_DISABLED:-0}" != "1" ]]; then
  mapfile -t staged_paths < <(git diff --cached --name-only --diff-filter=ACMR)
  if [ "${#staged_paths[@]}" -gt 0 ]; then
    PANTHEON_COMMIT_MSG_FILE="$MSG_FILE" \
      python3 "$ROOT_DIR/scripts/git/check_commit_scope.py" "${staged_paths[@]}"
  fi
fi

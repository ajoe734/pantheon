#!/usr/bin/env bash
# Pantheon pre-commit gate: reject staged runtime mirrors that should never
# enter git history (orchestrator-regenerated artifacts).
#
# The shared-index scope check lives in commit-msg (it needs the message
# file path argv[1] to read the Task-ID trailer).
#
# Bypass:
#   PANTHEON_GENERATED_FILES_CHECK_DISABLED=1

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

mapfile -t staged_paths < <(git diff --cached --name-only --diff-filter=ACMR)
if [ "${#staged_paths[@]}" -eq 0 ]; then
  exit 0
fi

if [[ "${PANTHEON_GENERATED_FILES_CHECK_DISABLED:-0}" != "1" ]]; then
  exec python3 "$ROOT_DIR/scripts/check_staged_generated_files.py" "${staged_paths[@]}"
fi

{
  "paths": {
    "status_file": "ai-status.json",
    "activity_log": "ai-activity-log.jsonl",
    "current_work": "current-work.md",
    "dashboard": "docs-site/index.html",
    "state_file": ".orchestrator/state.json",
    "approval_queue": ".orchestrator/approval-queue.json",
    "sidecar_catalog": ".orchestrator/sidecar_catalog.json",
    "github_bus_state": ".orchestrator/github-bus-state.json",
    "provider_capabilities": ".orchestrator/provider_capabilities.json",
    "claude_mcp_config": ".orchestrator/claude-approval-broker.mcp.json"
  },
  "task_state_store": {
    "mode": "authoritative",
    "event_log": ".orchestrator/task-state-events-v2.jsonl"
  },
  "permission_broker": {
    "allowed_workspace_roots": [
      ".",
      "../execute-plans"
    ]
  },
  "supervisor": {
    "poll_interval_seconds": 2.0,
    "heartbeat_warn_after_seconds": 10.0,
    "stall_after_seconds": 300,
    "adaptive_stall_detection": true,
    "observe_worker_commit_progress": true,
    "lease_requires_work_progress": true,
    "max_worker_history": 200
  },
  "worker_runtime": {
    "worker_lease_seconds": 600,
    "queue_lease_seconds": 1800,
    "heartbeat_stale_seconds": 300,
    "heartbeat_grace_seconds": 60,
    "work_progress_stale_seconds": 360,
    "runner_heartbeat_interval_seconds": 15
  },
  "watchdog": {
    "enabled": true,
    "state_file": ".orchestrator/watchdog-state.json",
    "metrics_file": ".orchestrator/metrics/supervisor-watchdog.jsonl",
    "heartbeat_stale_seconds": 900,
    "restart_budget_window_seconds": 900,
    "max_restarts_per_window": 2,
    "max_restarts_per_hour": 4,
    "backoff_schedule_seconds": [
      30,
      120,
      300,
      900
    ],
    "circuit_cooldown_seconds": 1800,
    "safe_mode_seconds": 120,
    "min_disk_free_gb": 2.0,
    "max_disk_used_percent": 95.0,
    "min_memory_available_mb": 512,
    "max_load_1m": 24.0,
    "max_active_workers": 12
  },
  "delivery_health": {
    "evidence_ttl_seconds": 300,
    "retry_after_seconds": 60,
    "refresh_max_per_cycle": 4
  },
  "worker_tree_guard": {
    "enabled": false,
    "mode": "warn",
    "blocking_globs": [
      ".orchestrator/supervisor.py",
      "supervisor.py",
      ".orchestrator/skills/**",
      "branch-strategy.md",
      "docs/conventions/GIT_WORKFLOW.md",
      "config*.json",
      ".orchestrator/config*.json",
      "docs/**"
    ],
    "auto_restore_globs": [
      "ai-activity-log.jsonl",
      "ai-status.json",
      "current-work.md",
      "dashboard-bundle.json",
      "docs-site/**"
    ],
    "auto_restore_enabled": false
  },
  "worker_worktrees": {
    "enabled": true,
    "root": "/tmp/pantheon-worker-worktrees",
    "source_root": "",
    "base_ref": "origin/dev",
    "reuse_existing": true,
    "execution_reasons": [
      "owned_ready_dispatch",
      "owned_in_progress_dispatch",
      "owned_finalize_dispatch",
      "review_ready_dispatch"
    ]
  },
  "worker_worktree_cleanup": {
    "enabled": true,
    "cleanup_inactive_leases": true,
    "archive_dirty_worktrees": true,
    "force_remove_archived_dirty": true,
    "archive_root": "/tmp/pantheon-worker-worktree-archive",
    "archive_max_file_bytes": 20971520,
    "max_removals_per_tick": 25,
    "base_branches": [
      "dev",
      "master",
      "main"
    ],
    "orphan_unmerged_max_age_days": 14
  },
  "worker_retry": {
    "enabled": true,
    "max_attempts": 5,
    "backoff_schedule_seconds": [
      5,
      15,
      30,
      60,
      120
    ],
    "jitter_seconds": 3,
    "transient_error_patterns": [
      "429",
      "resource_exhausted",
      "rate limit",
      "rate limited",
      "timed out",
      "etimedout",
      "econnreset",
      "temporarily unavailable",
      "try again later",
      "server overloaded",
      "deadline exceeded",
      "terminalquotaerror",
      "retryablequotaerror",
      "quota_exhausted",
      "quota exhausted",
      "exhausted your capacity",
      "no capacity available for model"
    ]
  },
  "worker_reassignment": {
    "enabled": true,
    "owner_fallbacks": {
      "Claude": [
        "Codex"
      ],
      "Gemini": [
        "Codex",
        "Claude"
      ],
      "Gemini2": [
        "Codex",
        "Claude"
      ],
      "Codex": [
        "Claude"
      ],
      "Copilot": [
        "Codex",
        "Claude"
      ]
    },
    "reviewer_fallbacks": {
      "Claude": [
        "Codex"
      ],
      "Gemini": [
        "Codex",
        "Claude"
      ],
      "Gemini2": [
        "Codex",
        "Claude"
      ],
      "Codex": [
        "Claude"
      ],
      "Copilot": [
        "Codex",
        "Claude"
      ]
    },
    "max_reassignments_per_cycle": 4
  },
  "approvals": {
    "stale_pending_seconds": 1800
  },
  "github_bus": {
    "enabled": true,
    "command_timeout_seconds": 8,
    "poll_interval_seconds": 30,
    "repo": null,
    "delivery_base_branches": {
      "pantheon": "dev",
      "execute_plans": "dev"
    },
    "offline_backoff_seconds": 300,
    "auto_request_reviewers": true,
    "close_resolved_issues": true,
    "labels": {
      "review": [
        "pantheon-bus",
        "pantheon-review"
      ],
      "ops": [
        "pantheon-bus",
        "pantheon-ops",
        "approval-needed"
      ],
      "resolved": [
        "resolved"
      ]
    },
    "commands": [
      "/approve",
      "/deny",
      "/retry",
      "/recheck",
      "/status"
    ],
    "reviewers": {
      "Claude": [
        "your-github-handle"
      ],
      "Gemini": [
        "your-github-handle"
      ],
      "Codex": [
        "your-github-handle"
      ],
      "Copilot": [
        "your-github-handle"
      ]
    },
    "templates": {
      "ops_issue": ".orchestrator/templates/github_ops_issue.md",
      "review_pr": ".orchestrator/templates/github_review_pr.md"
    }
  },
  "schema": {
    "tasks_path": "tasks",
    "handoffs_path": "handoffs",
    "task_id_field": "id",
    "status_field": "status",
    "assignee_field": "owner",
    "reviewer_field": "reviewer",
    "artifacts_field": "artifacts",
    "next_field": "next",
    "last_update_field": "last_update"
  },
  "agents": {
    "claude": {
      "display_name": "Claude",
      "provider": "claude",
      "max_parallel": 3,
      "adapter": "claude_cli",
      "wake_template": ".orchestrator/templates/wakeup.txt"
    },
    "gemini": {
      "display_name": "Gemini",
      "provider": "gemini",
      "max_parallel": 1,
      "adapter": "gemini",
      "wake_template": ".orchestrator/templates/wakeup.txt"
    },
    "gemini2": {
      "display_name": "Gemini2",
      "provider": "gemini2",
      "max_parallel": 1,
      "adapter": "gemini",
      "wake_template": ".orchestrator/templates/wakeup.txt"
    },
    "codex": {
      "display_name": "Codex",
      "provider": "codex",
      "max_parallel": 4,
      "adapter": "codex",
      "wake_template": ".orchestrator/templates/wakeup.txt"
    },
    "copilot": {
      "display_name": "Copilot",
      "provider": "copilot",
      "max_parallel": 1,
      "adapter": "copilot_local",
      "wake_template": ".orchestrator/templates/wakeup.txt"
    }
  },
  "providers": {
    "claude": {
      "delivery_mode": "claude_cli",
      "account": "claude",
      "runtime": {
        "cli": "claude",
        "output_format": "stream-json",
        "include_hook_events": true,
        "permission_mode": "acceptEdits",
        "resume_permission_mode_after_approval": "acceptEdits",
        "resume_use_allowed_tools_from_approval": true,
        "enable_auto_mode_if_supported": true,
        "auto_permission_mode": "auto",
        "mcp_config": ".orchestrator/claude-approval-broker.mcp.json",
        "permission_prompt_tool": "mcp__orchestrator_approval_broker__approval_prompt"
      },
      "broker": {
        "approval_wait_seconds": 3600,
        "http_host": "127.0.0.1",
        "http_port": 8765,
        "persist_allow_by_default": false
      },
      "approval": {
        "workspace_permission_mode": "acceptEdits",
        "allow_dangerous_skip": false,
        "copilot_allow_dangerous_skip": false,
        "rule_default_mode": "acceptEdits",
        "disable_bypass_permissions": true
      }
    },
    "gemini": {
      "delivery_mode": "gemini",
      "account": "gemini",
      "gemini": {
        "cli": "gemini",
        "include_directories": true
      },
      "approval": {
        "default_approval_mode": "auto_edit",
        "workspace_agent_yolo_mode": false,
        "enable_permanent_tool_approval": true,
        "auto_add_to_policy_by_default": true,
        "disable_yolo_mode": false,
        "disable_always_allow": false
      }
    },
    "gemini2": {
      "delivery_mode": "gemini",
      "account": "gemini2",
      "gemini": {
        "cli": ".orchestrator/bin/gemini2",
        "config_home": "~/.gemini2",
        "home": "~/.gemini2",
        "include_directories": true,
        "model": "gemini-2.5-flash-lite",
        "output_format": "json",
        "env": {
          "GEMINI_CLI_TRUST_WORKSPACE": "true",
          "GOOGLE_GENAI_USE_GCA": "true",
          "GOOGLE_CLOUD_PROJECT": "YOUR_GEMINI_CODE_ASSIST_PROJECT",
          "GOOGLE_CLOUD_PROJECT_ID": "YOUR_GEMINI_CODE_ASSIST_PROJECT",
          "GOOGLE_CLOUD_LOCATION": "us-central1"
        }
      },
      "approval": {
        "default_approval_mode": "yolo",
        "workspace_agent_yolo_mode": false,
        "enable_permanent_tool_approval": true,
        "auto_add_to_policy_by_default": true,
        "disable_yolo_mode": false,
        "disable_always_allow": false
      }
    },
    "codex": {
      "delivery_mode": "codex",
      "account": "codex1",
      "codex": {
        "cli": "codex",
        "ask_for_approval": "never",
        "sandbox_mode": "workspace-write",
        "dangerously_bypass": true
      },
      "approval": {
        "orchestrator_only": true,
        "ask_for_approval": "never",
        "sandbox_mode": "workspace-write",
        "dangerously_bypass": true
      }
    },
    "copilot": {
      "delivery_mode": "copilot_local",
      "account": "copilot",
      "local": {
        "cli": "copilot",
        "autopilot": true,
        "max_autopilot_continues": 12,
        "allow_all_tools": true,
        "add_workspace_dir": true,
        "no_ask_user": true,
        "allow_tools": [],
        "deny_tools": [],
        "extra_args": []
      },
      "cloud": {
        "cli": "gh",
        "enabled": true,
        "min_version": "2.80.0",
        "follow": false,
        "base_branch": "main",
        "repo": null,
        "extra_args": []
      },
      "model_preference": {
        "default": null,
        "grok": null,
        "supported": [
          "claude"
        ]
      }
    }
  },
  "ready_dispatcher": {
    "enabled": true,
    "seen_event_history_limit": 2000,
    "pending_handoff_statuses": [
      "pending"
    ],
    "review_statuses": [
      "review"
    ],
    "finalize_statuses": [
      "review_approved"
    ],
    "owned_statuses": [
      "in_progress",
      "todo"
    ],
    "dependency_done_statuses": [
      "done"
    ],
    "worker_terminal_statuses": [
      "review",
      "done",
      "review_approved"
    ],
    "active_worker_statuses": [
      "running",
      "waiting_approval",
      "suspended_approval",
      "retry_backoff",
      "stalled"
    ],
    "max_dispatches_per_tick": 2,
    "max_active_workers_per_task": 1,
    "max_concurrent_per_account": {
      "claude": 3,
      "gemini": 1,
      "gemini2": 1,
      "codex1": 4,
      "copilot": 1
    },
    "max_concurrent_workers": 2
  },
  "branch_workflow": {
    "enabled": true,
    "task_branch_prefix": "task/",
    "publish_branch_prefix": "publish/",
    "release_tag_prefix": "release/",
    "prod_tag_prefix": "prod/",
    "archive_tag_prefix": "archive/",
    "dev_branch": "dev",
    "main_branch": "master",
    "nightly_publish": {
      "enabled": true,
      "cron_utc": "0 3 * * *",
      "version_format": "vYYYY.MM.DD.N",
      "release_state_file": ".orchestrator/release-state.json",
      "skip_if_no_new_commits": true
    },
    "promote": {
      "trigger": "ci_green",
      "soak_days": 0,
      "regression_label_prefix": "regression/",
      "block_labels": [
        "hold-promote",
        "regression"
      ],
      "promote_pr_label": "auto-promote",
      "auto_merge": true,
      "auto_revert_on_red_master_ci": true
    },
    "task_pr": {
      "auto_merge": true,
      "required_status_checks": [
        "Commit trailers",
        "Runtime mirror guard",
        "Smoke acceptance"
      ],
      "max_open_hours": 24
    },
    "drift_alarms": {
      "task_pr_must_merge_within_minutes": 120,
      "publish_must_promote_within_minutes": 30,
      "dev_must_not_diverge_from_master_more_than_minutes": 60
    },
    "orchestrator_sync_webhook": {
      "enabled": false,
      "url_env": "PANTHEON_ORCHESTRATOR_SYNC_URL",
      "secret_env": "PANTHEON_ORCHESTRATOR_SYNC_SECRET"
    }
  }
}

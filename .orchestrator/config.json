{
  "paths": {
    "status_file": "ai-status.json",
    "activity_log": "ai-activity-log.jsonl",
    "current_work": "current-work.md",
    "dashboard": "docs-site/index.html",
    "state_file": ".orchestrator/state.json",
    "event_queue": ".orchestrator/event-queue.jsonl",
    "approval_queue": ".orchestrator/approval-queue.json",
    "github_bus_state": ".orchestrator/github-bus-state.json",
    "github_webhook_events": ".orchestrator/github-webhook-events.jsonl",
    "github_relay_state": ".orchestrator/github-relay-state.json",
    "provider_capabilities": ".orchestrator/provider_capabilities.json",
    "claude_mcp_config": ".orchestrator/claude-approval-broker.mcp.json"
  },
  "coordination": {
    "enabled": true
  },
  "watcher": {
    "poll_interval_seconds": 300,
    "replay_on_start": false,
    "max_seen_events": 2000
  },
  "supervisor": {
    "poll_interval_seconds": 15,
    "heartbeat_warn_after_seconds": 45.0,
    "stall_after_seconds": 300,
    "max_worker_history": 200,
    "auto_refresh_provider_capabilities": true
  },
  "chair_review": {
    "enabled": true,
    "cooldown_seconds": 1800,
    "candidates": [
      "Codex",
      "Codex2",
      "Claude",
      "Claude2"
    ],
    "task_id": "OPS-CHAIR-REVIEW",
    "output_dir": ".orchestrator/chair-reviews",
    "recent_summary_lines": 6
  },
  "provider_guardrails": {
    "pause_on_capacity_failure": true,
    "pause_on_auth_failure": true,
    "capacity_pause_seconds": 900,
    "auth_pause_seconds": 900
  },
  "worker_retry": {
    "enabled": true,
    "max_attempts": 5,
    "backoff_schedule_seconds": [
      5,
      15,
      30,
      60,
      120
    ],
    "jitter_seconds": 3,
    "transient_error_patterns": [
      "429",
      "resource_exhausted",
      "rate limit",
      "rate limited",
      "timed out",
      "etimedout",
      "econnreset",
      "temporarily unavailable",
      "try again later",
      "server overloaded",
      "deadline exceeded",
      "terminalquotaerror",
      "retryablequotaerror",
      "quota_exhausted",
      "quota exhausted",
      "exhausted your capacity",
      "no capacity available for model"
    ],
    "fallback_mode": null
  },
  "worker_reassignment": {
    "enabled": true,
    "after_attempts": 2,
    "reassign_on_terminal_failure": true,
    "eligible_statuses": [
      "todo",
      "in_progress",
      "review",
      "review_approved"
    ],
    "owner_fallbacks": {
      "Claude": [
        "Codex",
        "Codex2"
      ],
      "Claude2": [
        "Codex",
        "Codex2",
        "Claude"
      ],
      "Gemini": [
        "Codex",
        "Codex2",
        "Claude"
      ],
      "Gemini2": [
        "Codex",
        "Codex2",
        "Claude"
      ],
      "Codex": [
        "Codex2",
        "Claude",
        "Claude2"
      ],
      "Codex2": [
        "Codex",
        "Claude",
        "Claude2"
      ],
      "Copilot": [
        "Codex",
        "Codex2",
        "Claude"
      ]
    },
    "reviewer_fallbacks": {
      "Claude": [
        "Codex",
        "Codex2"
      ],
      "Claude2": [
        "Codex",
        "Codex2",
        "Claude"
      ],
      "Gemini": [
        "Codex",
        "Codex2",
        "Claude"
      ],
      "Gemini2": [
        "Codex",
        "Codex2",
        "Claude"
      ],
      "Codex": [
        "Codex2",
        "Claude",
        "Claude2"
      ],
      "Codex2": [
        "Codex",
        "Claude",
        "Claude2"
      ],
      "Copilot": [
        "Codex",
        "Codex2",
        "Claude"
      ]
    }
  },
  "approvals": {
    "stale_pending_seconds": 1800
  },
  "github_bus": {
    "enabled": true,
    "command_timeout_seconds": 8,
    "poll_interval_seconds": 30,
    "repo": "ajoe734/pantheon",
    "default_branch": "master",
    "offline_backoff_seconds": 300,
    "auto_request_reviewers": true,
    "close_resolved_issues": true,
    "labels": {
      "review": [
        "pantheon-bus",
        "pantheon-review"
      ],
      "ops": [
        "pantheon-bus",
        "pantheon-ops",
        "approval-needed"
      ],
      "resolved": [
        "resolved"
      ]
    },
    "commands": [
      "/approve",
      "/deny",
      "/retry",
      "/resume",
      "/recheck",
      "/status"
    ],
    "reviewers": {
      "Claude": [
        "ajoe734"
      ],
      "Gemini": [
        "ajoe734"
      ],
      "Codex": [
        "ajoe734"
      ],
      "Copilot": [
        "ajoe734"
      ]
    },
    "templates": {
      "ops_issue": ".orchestrator/templates/github_ops_issue.md",
      "review_pr": ".orchestrator/templates/github_review_pr.md"
    },
    "phase3": {
      "github_app": {
        "enabled": false,
        "app_id_env": "PANTHEON_GITHUB_APP_ID",
        "private_key_env": "PANTHEON_GITHUB_APP_PRIVATE_KEY",
        "installation_id_env": "PANTHEON_GITHUB_INSTALLATION_ID"
      },
      "webhook": {
        "enabled": false,
        "host": "127.0.0.1",
        "port": 8776,
        "secret_env": "PANTHEON_GITHUB_WEBHOOK_SECRET"
      },
      "cloud_relay": {
        "enabled": false,
        "url_env": "PANTHEON_GITHUB_RELAY_URL",
        "token_env": "PANTHEON_GITHUB_RELAY_TOKEN"
      }
    }
  },
  "schema": {
    "tasks_path": "tasks",
    "handoffs_path": "handoffs",
    "task_id_field": "id",
    "status_field": "status",
    "assignee_field": "owner",
    "reviewer_field": "reviewer",
    "artifacts_field": "artifacts",
    "next_field": "next",
    "last_update_field": "last_update"
  },
  "events": {
    "enqueue_runtime_events": false,
    "review_statuses": [
      "review"
    ],
    "status_targets": {
      "needs_reply": "owner",
      "needs_input": "owner",
      "handoff": "owner"
    },
    "waiting_status_patterns": [
      "^waiting_on_(?P<agent>[A-Za-z0-9_-]+)$"
    ],
    "watch_assignee_changes": false,
    "watch_reviewer_changes": false,
    "watch_handoffs": false,
    "pending_handoff_statuses": [
      "pending"
    ]
  },
  "agents": {
    "claude": {
      "display_name": "Claude",
      "provider": "claude",
      "adapter": "claude_cli",
      "wake_template": ".orchestrator/templates/wakeup.txt",
      "file_inbox_path": ".llm-inbox/claude.md"
    },
    "claude2": {
      "display_name": "Claude2",
      "provider": "claude2",
      "adapter": "claude_cli",
      "wake_template": ".orchestrator/templates/wakeup.txt",
      "file_inbox_path": ".llm-inbox/claude2.md"
    },
    "gemini": {
      "display_name": "Gemini",
      "provider": "gemini",
      "adapter": "gemini",
      "wake_template": ".orchestrator/templates/wakeup.txt",
      "file_inbox_path": ".llm-inbox/gemini.md"
    },
    "gemini2": {
      "display_name": "Gemini2",
      "provider": "gemini2",
      "adapter": "gemini",
      "wake_template": ".orchestrator/templates/wakeup.txt",
      "file_inbox_path": ".llm-inbox/gemini2.md"
    },
    "codex": {
      "display_name": "Codex",
      "provider": "codex",
      "adapter": "codex",
      "wake_template": ".orchestrator/templates/wakeup.txt",
      "file_inbox_path": ".llm-inbox/codex.md"
    },
    "codex2": {
      "display_name": "Codex2",
      "provider": "codex2",
      "adapter": "codex",
      "wake_template": ".orchestrator/templates/wakeup.txt",
      "file_inbox_path": ".llm-inbox/codex2.md"
    },
    "copilot": {
      "display_name": "Copilot",
      "provider": "copilot",
      "adapter": "copilot_local",
      "wake_template": ".orchestrator/templates/wakeup.txt",
      "file_inbox_path": ".llm-inbox/copilot.md"
    },
    "grok": {
      "display_name": "Copilot (legacy alias)",
      "provider": "copilot",
      "adapter": "copilot_local",
      "wake_template": ".orchestrator/templates/wakeup.txt",
      "file_inbox_path": ".llm-inbox/grok.md"
    }
  },
  "providers": {
    "claude": {
      "delivery_mode": "claude_cli",
      "allow_inbox_fallback": false,
      "file_inbox": {
        "path": ".llm-inbox/claude.md",
        "open_in_vscode": false
      },
      "runtime": {
        "cli": ".orchestrator/bin/claude",
        "output_format": "stream-json",
        "include_hook_events": true,
        "permission_mode": "acceptEdits",
        "resume_permission_mode_after_approval": "acceptEdits",
        "resume_use_allowed_tools_from_approval": true,
        "enable_auto_mode_if_supported": true,
        "auto_permission_mode": "auto",
        "mcp_config": ".orchestrator/claude-approval-broker.mcp.json",
        "permission_prompt_tool": "mcp__orchestrator_approval_broker__approval_prompt",
        "env": {
          "CLAUDE_CONFIG_DIR": "/home/lupin/.claude"
        }
      },
      "broker": {
        "approval_wait_seconds": 3600,
        "http_host": "127.0.0.1",
        "http_port": 8765,
        "persist_allow_by_default": false
      },
      "approval": {
        "workspace_permission_mode": "acceptEdits",
        "allow_dangerous_skip": false,
        "copilot_allow_dangerous_skip": false,
        "rule_default_mode": "acceptEdits",
        "disable_bypass_permissions": true
      },
      "retry": {
        "fallback_mode": null
      }
    },
    "claude2": {
      "delivery_mode": "claude_cli",
      "allow_inbox_fallback": false,
      "file_inbox": {
        "path": ".llm-inbox/claude2.md",
        "open_in_vscode": false
      },
      "runtime": {
        "cli": ".orchestrator/bin/claude",
        "output_format": "stream-json",
        "include_hook_events": true,
        "permission_mode": "acceptEdits",
        "resume_permission_mode_after_approval": "acceptEdits",
        "resume_use_allowed_tools_from_approval": true,
        "enable_auto_mode_if_supported": true,
        "auto_permission_mode": "auto",
        "mcp_config": ".orchestrator/claude-approval-broker.mcp.json",
        "permission_prompt_tool": "mcp__orchestrator_approval_broker__approval_prompt",
        "home": "/home/lupin/.claude2"
      },
      "broker": {
        "approval_wait_seconds": 3600,
        "http_host": "127.0.0.1",
        "http_port": 8765,
        "persist_allow_by_default": false
      },
      "approval": {
        "workspace_permission_mode": "acceptEdits",
        "allow_dangerous_skip": false,
        "copilot_allow_dangerous_skip": false,
        "rule_default_mode": "acceptEdits",
        "disable_bypass_permissions": true
      },
      "retry": {
        "fallback_mode": null
      }
    },
    "gemini": {
      "delivery_mode": "gemini",
      "allow_inbox_fallback": false,
      "file_inbox": {
        "path": ".llm-inbox/gemini.md",
        "open_in_vscode": false
      },
      "gemini": {
        "cli": ".orchestrator/bin/gemini",
        "include_directories": true
      },
      "approval": {
        "default_approval_mode": "auto_edit",
        "workspace_agent_yolo_mode": false,
        "enable_permanent_tool_approval": true,
        "auto_add_to_policy_by_default": true,
        "disable_yolo_mode": false,
        "disable_always_allow": false
      },
      "retry": {
        "max_attempts": 5,
        "fallback_mode": null
      }
    },
    "gemini2": {
      "delivery_mode": "gemini",
      "allow_inbox_fallback": false,
      "file_inbox": {
        "path": ".llm-inbox/gemini2.md",
        "open_in_vscode": false
      },
      "gemini": {
        "cli": ".orchestrator/bin/gemini2",
        "config_home": "/home/lupin/.gemini2",
        "home": "/home/lupin/.gemini2",
        "include_directories": true,
        "model": "gemini-2.5-flash-lite",
        "output_format": "json",
        "env": {
          "GEMINI_CLI_TRUST_WORKSPACE": "true",
          "GOOGLE_GENAI_USE_GCA": "true",
          "GOOGLE_CLOUD_PROJECT": "pantheon-493602",
          "GOOGLE_CLOUD_PROJECT_ID": "pantheon-493602",
          "GOOGLE_CLOUD_LOCATION": "us-central1"
        }
      },
      "approval": {
        "default_approval_mode": "yolo",
        "workspace_agent_yolo_mode": false,
        "enable_permanent_tool_approval": true,
        "auto_add_to_policy_by_default": true,
        "disable_yolo_mode": false,
        "disable_always_allow": false
      },
      "retry": {
        "max_attempts": 5,
        "fallback_mode": null
      }
    },
    "codex": {
      "delivery_mode": "codex",
      "file_inbox": {
        "path": ".llm-inbox/codex.md",
        "open_in_vscode": false
      },
      "codex": {
        "cli": "codex",
        "api_key_env": "OPENAI_API_KEY",
        "ask_for_approval": "never",
        "sandbox_mode": "workspace-write",
        "dangerously_bypass": true
      },
      "approval": {
        "orchestrator_only": true,
        "ask_for_approval": "never",
        "sandbox_mode": "workspace-write",
        "dangerously_bypass": true
      }
    },
    "codex2": {
      "delivery_mode": "codex",
      "file_inbox": {
        "path": ".llm-inbox/codex2.md",
        "open_in_vscode": false
      },
      "codex": {
        "cli": "codex",
        "codex_home": "~/.codex2",
        "ask_for_approval": "never",
        "sandbox_mode": "workspace-write",
        "dangerously_bypass": true
      },
      "approval": {
        "orchestrator_only": true,
        "ask_for_approval": "never",
        "sandbox_mode": "workspace-write",
        "dangerously_bypass": true
      }
    },
    "copilot": {
      "delivery_mode": "copilot_local",
      "allow_inbox_fallback": false,
      "file_inbox": {
        "path": ".llm-inbox/copilot.md",
        "open_in_vscode": false,
        "agent_paths": {
          "grok": ".llm-inbox/grok.md",
          "copilot": ".llm-inbox/copilot.md"
        }
      },
      "local": {
        "cli": ".orchestrator/bin/copilot",
        "autopilot": true,
        "max_autopilot_continues": 12,
        "allow_all_tools": true,
        "add_workspace_dir": true,
        "no_ask_user": true,
        "allow_tools": [],
        "deny_tools": [],
        "extra_args": []
      },
      "cloud": {
        "cli": ".orchestrator/bin/gh",
        "enabled": true,
        "min_version": "2.80.0",
        "follow": false,
        "base_branch": "main",
        "repo": null,
        "extra_args": []
      },
      "model_preference": {
        "default": null,
        "grok": null,
        "supported": [
          "claude"
        ]
      },
      "retry": {
        "fallback_mode": null
      }
    }
  },
  "ready_dispatcher": {
    "enabled": true,
    "review_statuses": [
      "review"
    ],
    "finalize_statuses": [
      "review_approved"
    ],
    "owned_statuses": [
      "in_progress",
      "todo"
    ],
    "sidecar_only_agents": [],
    "disabled_agents": [
      "Copilot",
      "Gemini"
    ],
    "dependency_done_statuses": [
      "done"
    ],
    "worker_terminal_statuses": [
      "done",
      "review_approved"
    ],
    "active_worker_statuses": [
      "running",
      "waiting_approval",
      "suspended_approval",
      "retry_backoff",
      "manual_pending",
      "stalled"
    ],
    "helper_claim": {
      "enabled": true,
      "task_statuses": [
        "todo",
        "in_progress"
      ],
      "require_owner_higher_priority_load": true
    },
    "max_tasks_per_agent": 1,
    "max_dispatches_per_tick": 4
  }
}

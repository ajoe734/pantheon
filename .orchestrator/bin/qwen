#!/usr/bin/env bash
set -euo pipefail

node_bin="$(ls -d "$HOME"/.vscode-server/cli/servers/Stable-*/server/node 2>/dev/null | sort -V | tail -n1)"
qwen_js="$(ls -d "$HOME"/.vscode-server/extensions/qwenlm.qwen-code-vscode-ide-companion-*/dist/qwen-cli/cli.js 2>/dev/null | sort -V | tail -n1)"

if [[ -z "${node_bin}" ]]; then
  echo "VS Code server node binary not found." >&2
  exit 1
fi
if [[ -z "${qwen_js}" ]]; then
  echo "Qwen CLI entrypoint not found under ~/.vscode-server/extensions." >&2
  exit 1
fi

exec "${node_bin}" "${qwen_js}" "$@"

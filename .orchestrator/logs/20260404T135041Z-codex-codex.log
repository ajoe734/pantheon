def ensure_agent(name: str) -> dict[str, Any]:
    if name not in KNOWN_AGENTS:
        raise SystemExit(f"Unknown agent: {name}")
    return KNOWN_AGENTS[name]


def get_agent(state: dict[str, Any], name: str) -> dict[str, Any]:
    ensure_agent(name)

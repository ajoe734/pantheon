    if not LOG_FILE.exists():
        return []
    logs: list[dict[str, Any]] = []
    for line in LOG_FILE.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line:
            continue
        logs.append(json.loads(line))
    return logs



{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pantheon/agora/version_compare/v1",
  "title": "VersionCompare",
  "type": "object",
  "required": [
    "spec_version",
    "comparison_id",
    "workshop_id",
    "strategy_id",
    "base_version",
    "candidate_versions",
    "field_diffs",
    "metric_diffs",
    "readiness_diffs",
    "created_at"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "comparison_id": {
      "type": "string",
      "pattern": "^vcmp_[A-Za-z0-9_-]+$"
    },
    "workshop_id": {
      "type": "string"
    },
    "strategy_id": {
      "type": "string"
    },
    "base_version": {
      "$ref": "#/definitions/version_ref"
    },
    "candidate_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/definitions/version_ref"
      }
    },
    "field_diffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "change_kind",
          "candidate_version_id"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "change_kind": {
            "type": "string",
            "enum": [
              "added",
              "removed",
              "changed",
              "unchanged"
            ]
          },
          "candidate_version_id": {
            "type": "string"
          },
          "before": {},
          "after": {},
          "source_proposal_id": {
            "type": "string"
          },
          "materiality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "metric_diffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric",
          "candidate_version_id",
          "evidence_class"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "candidate_version_id": {
            "type": "string"
          },
          "base_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "candidate_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "absolute_delta": {
            "type": [
              "number",
              "null"
            ]
          },
          "relative_delta_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "ci_lower": {
            "type": "number"
          },
          "ci_upper": {
            "type": "number"
          },
          "evidence_class": {
            "type": "string",
            "enum": [
              "predicted",
              "backtested_in_sample",
              "backtested_oos",
              "paper_observed"
            ]
          },
          "source_ref": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "risk_diffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_version_id",
          "risk_domain",
          "change"
        ],
        "properties": {
          "candidate_version_id": {
            "type": "string"
          },
          "risk_domain": {
            "type": "string"
          },
          "change": {
            "type": "string",
            "enum": [
              "improved",
              "worsened",
              "unchanged",
              "uncertain"
            ]
          },
          "summary": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/evidence_ref"
            }
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "readiness_diffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_version_id",
          "gate",
          "base_state",
          "candidate_state"
        ],
        "properties": {
          "candidate_version_id": {
            "type": "string"
          },
          "gate": {
            "type": "string",
            "enum": [
              "preliminary_research",
              "full_validation",
              "trading_room"
            ]
          },
          "base_state": {
            "type": "string"
          },
          "candidate_state": {
            "type": "string"
          },
          "changed_requirement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "recommended_version_id": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision_authority": {
          "type": "string",
          "enum": [
            "trader"
          ]
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_cutoff": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "version_ref": {
      "type": "object",
      "required": [
        "workshop_version_id",
        "strategy_spec_registry_id",
        "label"
      ],
      "properties": {
        "workshop_version_id": {
          "type": "string"
        },
        "strategy_spec_registry_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "document_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "evidence_ref": {
      "type": "object",
      "required": [
        "ref_type",
        "ref_id"
      ],
      "properties": {
        "ref_type": {
          "type": "string",
          "enum": [
            "evidence_bundle",
            "evidence_item",
            "source_record",
            "citation",
            "experiment_artifact",
            "registry_entry",
            "consult_memo",
            "research_run",
            "telemetry_snapshot",
            "market_context"
          ]
        },
        "ref_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "data_cutoff": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

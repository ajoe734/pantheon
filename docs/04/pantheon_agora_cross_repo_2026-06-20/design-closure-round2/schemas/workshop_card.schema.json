{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pantheon/agora/workshop_card/v1",
  "title": "WorkshopCard",
  "type": "object",
  "required": [
    "spec_version",
    "card_id",
    "card_type",
    "workshop_id",
    "sequence_no",
    "status",
    "title",
    "payload",
    "created_at"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "card_id": {
      "type": "string"
    },
    "card_type": {
      "type": "string",
      "enum": [
        "user_strategy_description",
        "servant_reconstruction",
        "completeness_update",
        "missing_definition",
        "next_question",
        "research_plan_proposal",
        "research_progress",
        "research_result",
        "consult_result",
        "version_patch_proposal",
        "version_compare",
        "readiness_gate"
      ]
    },
    "workshop_id": {
      "type": "string"
    },
    "sequence_no": {
      "type": "integer",
      "minimum": 1
    },
    "source_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workshop_version_id": {
      "type": "string"
    },
    "strategy_spec_registry_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "informational",
        "action_required",
        "running",
        "completed",
        "failed",
        "stale"
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/evidence_ref"
      }
    },
    "allowed_actions": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "evidence_ref": {
      "type": "object",
      "required": [
        "ref_type",
        "ref_id"
      ],
      "properties": {
        "ref_type": {
          "type": "string",
          "enum": [
            "evidence_bundle",
            "evidence_item",
            "source_record",
            "citation",
            "experiment_artifact",
            "registry_entry",
            "consult_memo",
            "research_run",
            "telemetry_snapshot",
            "market_context"
          ]
        },
        "ref_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "data_cutoff": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

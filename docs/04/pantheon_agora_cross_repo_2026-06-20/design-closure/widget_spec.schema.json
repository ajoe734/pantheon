{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pantheon.local/schemas/agora/widget_spec.v1.json",
  "title": "WidgetSpec",
  "type": "object",
  "required": ["widget_id", "widget_type", "title", "data_source", "query", "chart_spec", "interactions", "sensitivity", "can_export"],
  "properties": {
    "widget_id": {"type": "string", "minLength": 1},
    "widget_type": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "why_this_widget": {"type": "string"},
    "data_source": {"type": "string", "minLength": 1},
    "query": {
      "type": "object",
      "required": ["filters"],
      "properties": {
        "filters": {"type": "object"},
        "sort": {"type": "object", "additionalProperties": {"enum": ["asc", "desc"]}},
        "limit": {"type": "integer", "minimum": 1, "maximum": 10000},
        "window": {"type": "string"}
      },
      "additionalProperties": false
    },
    "chart_spec": {"$ref": "chart_spec.schema.json"},
    "interactions": {"type": "array", "items": {"$ref": "chart_spec.schema.json#/$defs/interaction"}},
    "sensitivity": {"enum": ["public_market", "user_private", "broker_sensitive", "restricted"]},
    "can_export": {"type": "boolean"},
    "registry_version": {"const": "widget_registry.v1"}
  },
  "additionalProperties": false
}

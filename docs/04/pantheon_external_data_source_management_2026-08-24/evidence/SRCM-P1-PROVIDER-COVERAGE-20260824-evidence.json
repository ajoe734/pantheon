  "acceptance_summary": {
    "provider_reconciliation": "Admitted StockTwits for governed social discussion with dedicated SOCIAL source class, normalized symbol dicts, stable user ID hashing, tombstone body/identity sanitization, and platform-tagged sentiment; FMP for External Alpha DB with strict RFC3339 AlphaSignalRecord contract, SHA-256 body_hash schema, date exclusion from values, and indicator mapping.",
    "fixture_isolation": "Isolated example-alpha-db as test fixture only with explicit exception guard preventing live configuration.",
    "tdcc_completion": "Implemented TDCC official weekly shareholding distribution with smart open data endpoint provenance, 5MB bounded streaming read, early stopping on max_records, 15 holding tiers, weekly watermark progression, backfill windows, and restatement/correction handling.",
    "taifex_completion": "Implemented TAIFEX official daily futures and options chip context with live OpenAPI endpoint provenance, 3rd Wednesday settlement calendar/contract-roll policy, front-month resolution, bounded normalization, and daily watermark progression.",
    "canary_search_readback": "Validated bounded canary durable readback across TWSE, TDCC, TAIFEX, StockTwits, and External Alpha DB factor streams with verified search citation indexing."
  },

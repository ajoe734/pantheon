{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pantheon SD-03 SourceConnector",
  "type": "object",
  "required": ["connector_id", "source_type", "provider", "auth_type", "supported_modes", "license_scope", "status"],
  "properties": {
    "connector_id": {"type": "string", "minLength": 1},
    "source_type": {
      "type": "string",
      "enum": ["paper", "repo", "internal_note", "filing", "news", "social", "alpha_db", "macro", "market", "telemetry"]
    },
    "provider": {"type": "string", "minLength": 1},
    "auth_type": {"type": "string", "enum": ["none", "api_key", "oauth", "secret_ref", "broker_ref"]},
    "secret_ref_id": {"type": ["string", "null"]},
    "supported_modes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["batch", "streaming", "webhook"]}
    },
    "license_scope": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["enabled", "disabled", "degraded"]},
    "rate_limit_policy_ref": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}

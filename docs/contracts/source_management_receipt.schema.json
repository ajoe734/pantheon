{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pantheon/source-management-receipt/v1",
  "title": "Pantheon SourceManagementReceipt",
  "description": "Durable execution and readback receipt for source management commands.",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "command_id",
    "idempotency_key_hash",
    "source_instance_id",
    "command_type",
    "status",
    "before_revision",
    "after_revision",
    "effect_refs",
    "readback",
    "actor_id",
    "service_deployment_sha",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "source_management_receipt.v1"
      ]
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key_hash": {
      "type": "string",
      "minLength": 1
    },
    "source_instance_id": {
      "type": "string",
      "minLength": 1
    },
    "command_type": {
      "type": "string",
      "enum": [
        "create",
        "validate",
        "canary",
        "enable",
        "disable",
        "degrade",
        "resume",
        "change_schedule",
        "replace",
        "retire"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "running",
        "succeeded",
        "failed",
        "rejected"
      ]
    },
    "before_revision": {
      "type": "integer",
      "minimum": 0
    },
    "after_revision": {
      "type": "integer",
      "minimum": 0
    },
    "effect_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "readback": {
      "type": "object",
      "properties": {
        "desired_revision": {
          "type": [
            "integer",
            "null"
          ]
        },
        "observed_revision": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reconciliation_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_lifecycle": {
          "type": [
            "string",
            "null"
          ]
        },
        "validation_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "canary_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "health_state": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "failure": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "service_deployment_sha": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}

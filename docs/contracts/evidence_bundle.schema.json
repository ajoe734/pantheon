{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pantheon SD-03 EvidenceBundle",
  "type": "object",
  "required": [
    "evidence_bundle_id",
    "source_ids",
    "evidence_item_ids",
    "summary",
    "citation_refs",
    "confidence",
    "license_scope",
    "access_scope",
    "created_by",
    "created_at"
  ],
  "properties": {
    "evidence_bundle_id": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_item_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "summary": {"type": "string", "minLength": 1},
    "citation_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "license_scope": {"type": "string", "minLength": 1},
    "access_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "available_time": {"type": ["string", "null"]},
    "entitlement_tags": {"type": "array", "items": {"type": "string"}},
    "trace_refs": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}

  "schemas": {
    "scope_envelope": {
      "type": "object",
      "required": ["tenant_id", "user_id", "actor_id", "roles", "trace_id"],
      "properties": {
        "tenant_id": {"type": "string"},
        "user_id": {"type": "string"},
        "actor_id": {"type": "string"},
        "actor_type": {"type": "string", "enum": ["user", "service"]},
        "roles": {"type": "array", "items": {"type": "string"}},
        "trace_id": {"type": "string"}
      }
    },
    "command_envelope": {
      "type": "object",
      "required": ["command_id", "operation", "aggregate_type", "aggregate_id", "idempotency_key", "request_hash", "payload", "scope", "submitted_at"],
      "properties": {
        "command_id": {"type": "string"},
        "operation": {"type": "string"},
        "aggregate_type": {"type": "string"},
        "aggregate_id": {"type": "string"},
        "expected_revision": {"type": "integer"},
        "idempotency_key": {"type": "string"},
        "request_hash": {"type": "string"},
        "payload": {"type": "object"},
        "scope": {"$ref": "#/schemas/scope_envelope"},
        "submitted_at": {"type": "string", "format": "date-time"}
      }
    },
    "command_receipt": {
      "type": "object",
      "required": ["receipt_id", "command_id", "idempotency_key", "status", "aggregate_id", "current_revision", "updated_at"],
      "properties": {
        "receipt_id": {"type": "string"},
        "command_id": {"type": "string"},

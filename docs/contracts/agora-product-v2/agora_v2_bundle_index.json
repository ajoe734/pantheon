        "status": {"type": "string", "enum": ["accepted", "processing", "succeeded", "failed_retryable", "failed_terminal", "compensated"]},
        "aggregate_id": {"type": "string"},
        "current_revision": {"type": "integer"},
        "result": {"type": "object"},
        "error": {"type": "object"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "strategy_reconstruction_result": {
      "type": "object",
      "required": ["reconstruction_id", "workshop_id", "based_on_sequence_no", "strategy_map", "completeness", "created_at"],

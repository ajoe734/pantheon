          "type": "object",
          "properties": {
            "question_id": {"type": "string"},
            "text": {"type": "string"},
            "resolves": {"type": "array", "items": {"type": "string"}},
            "why_now": {"type": "string"}
          }
        },
        "draft_proposal": {"type": "object"},
        "provider_lineage": {"type": "object"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "trading_decision_event": {
      "type": "object",
      "required": ["event_id", "tenant_id", "user_id", "strategy_id", "version_id", "probability", "expected_value", "risk_evaluation", "status", "created_at"],
      "properties": {
        "event_id": {"type": "string"},
        "tenant_id": {"type": "string"},
        "user_id": {"type": "string"},
        "strategy_id": {"type": "string"},
        "version_id": {"type": "string"},
        "signal_summary": {"type": "object"},
        "probability": {"type": "number"},
        "expected_value": {"type": "number"},
        "invalidation_criteria": {"type": "object"},
        "risk_evaluation": {
          "type": "object",
          "required": ["risk_score", "status"],

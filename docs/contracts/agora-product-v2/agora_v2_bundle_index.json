          "properties": {
            "grade": {"type": "string", "enum": ["insufficient", "draftable", "researchable", "trading_room_ready"]},
            "blockers": {"type": "array", "items": {"type": "string"}},
            "confirmed_fields": {"type": "array", "items": {"type": "string"}},
            "unconfirmed_fields": {"type": "array", "items": {"type": "string"}}
          }
        },

  "verification_script": "import hashlib,json,re,subprocess\nfrom pathlib import Path\nmanifest=Path('docs/deployment/evidence/SD-PERSONA-CYCLE-RECONNECT-20261112/evidence.json')\ne=json.loads(manifest.read_text());p=Path(e['document']);s=p.read_text();base=e['repo_base']\noriginal=subprocess.check_output(['git','show','d1d854a31:'+str(p)],text=True)\nquotes=lambda text: re.findall(r'^> (.*)$',text,re.M)\nassert quotes(s)==quotes(original)==e['operator_statements_2026_11_12'], 'operator quotes changed'\nassert e['hosted_behavior_claimed'] is False\nassert e['hosted_observation_provenance']['independently_reverified'] is False\nsection=s.split('\\n## 2.')[1].split('\\n## 4.')[0]\nrefs=[]\nfor token in re.findall(r'`([^`]+)`',section):\n    m=re.fullmatch(r'([^:]+\\.(?:md|py|json))(?::(\\d+)(?:-(\\d+))?)?',token)\n    assert not token.startswith(':'), f'shorthand reference: {token}'\n    if not m: continue\n    path,start,end=m.groups(); source=Path(path)\n    assert source.is_file(), f'missing {token}'\n    delivered=source.read_bytes();baseline=subprocess.check_output(['git','show',base+':'+path])\n    assert delivered==baseline, f'reference changed from checked base: {path}'\n    lines=delivered.decode().splitlines()\n    if start: assert 1<=int(start)<=int(end or start)<=len(lines), f'bad line {token}'\n    refs.append({'reference':token,'base_blob':subprocess.check_output(['git','rev-parse',base+':'+path],text=True).strip()})\nassert refs\nrefs=list({r['reference']:r for r in refs}.values())\ndecisions=s.split('\\n## 4.')[1].split('\\n## 5.')[0]\nrows=re.findall(r'^\\| D(\\d+) \\| (.*)$',decisions,re.M)\nassert [int(n) for n,_ in rows]==list(range(1,14))\nfor n,row in rows:\n    assert re.search(r'`[^`]+\\.(md|py|json)(?::[^`]*)?`',row), f'D{n} missing source'\nallowed={str(p),str(manifest)}\nchanged=set(subprocess.check_output(['git','diff','--name-only',base],text=True).splitlines())\nassert changed==allowed, f'out-of-scope change: {changed}'\nsubprocess.run(['git','diff','--check',base],check=True)\nprint(f'PASS: {len(refs)} citations resolve at {base}; 7 verbatim statements; D1-D13 cite sources; exact two-file scope; JSON false hosted claim; diff whitespace clean')\n",

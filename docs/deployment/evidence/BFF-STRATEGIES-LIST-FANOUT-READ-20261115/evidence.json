  "design": {
    "approach": "Single-flight plus a short process-local memo of validated bounded Registry summary pages; no memo of BFF responses, persona/ranking projection or full catalog.",
    "ttl_seconds": 5,
    "max_completed_keys_per_port": 64,
    "max_in_flight_keys_per_port": 64,
    "key": [
      "verified caller tenant",
      "SHA256 of caller authorization",
      "Registry URL",
      "state",
      "exclude_state",
      "persona_id",
      "page_token",
      "page_size"
    ],
    "failure_policy": "Exceptions and malformed/forbidden owner payloads are never inserted into the cross-request memo. Concurrent waiters receive their in-flight outcome; the next independent request retries. Existing request-scoped owner-read semantics remain unchanged.",
    "isolation": "Each port owns its memo. Hits and joined results are deep-copied; leader results are detached from the saved value. Unrelated keys do not wait under an I/O lock.",
    "deadline": "A waiter uses remaining_management_read_budget; at capacity an unrelated key reads directly without growing the in-flight map. No timeout or budget changes.",
    "freshness": "Successful Registry summary pages may be up to 5 seconds old. Hits do not extend TTL. Persona and ranking reads still use the existing request-scoped flow.",
    "composition": "Follows sibling PR #7362 single-flight/memo pattern at the strategy owner-page layer; preserves existing strategy route parallel prefetch and leaves personas and artifact paging untouched."
  },

    "hosted_sources": {
      "risk-hosted-read.py": "import json, os, time, urllib.request\nbase = 'http://127.0.0.1:8001'\nprefix = 'PANTHEON_BFF_DEV_LOGIN_VIEWER_'\nbody = {'grant_type':'client_credentials', 'client_id':os.environ[prefix+'CLIENT_ID'], 'client_secret':os.environ[prefix+'CLIENT_SECRET']}\nwith urllib.request.urlopen(urllib.request.Request(base+'/bff/auth/dev-login', data=json.dumps(body).encode(), headers={'Content-Type':'application/json'}), timeout=20) as r:\n    token = json.load(r)['access_token']\nheaders = {'Authorization':'Bearer '+token}\nout = {'measured_at':time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()), 'measurements':{}}\nfor path in ['/bff/version','/bff/me','/bff/strategies?page_size=200', '/bff/alerts','/bff/artifacts?page_size=100']:\n    start = time.perf_counter()\n    with urllib.request.urlopen(urllib.request.Request(base+path,headers=headers),timeout=30) as r:\n        data = json.load(r)\n    out['measurements'][path] = {'seconds':time.perf_counter()-start, 'keys':list(data), 'page_info':data.get('page_info'), 'total':data.get('total_count'), 'rows':len(data.get('data',data.get('alerts',[]))) if isinstance(data.get('data',data.get('alerts',[])),list) else None}\n    if path == '/bff/version': out['version'] = data\n    if path == '/bff/me': out['identity'] = {'tenant': data.get('tenant_id'), 'data_keys':list(data.get('data',{}))}\nprint(json.dumps(out))\n",
      "risk-owner-profile.py": "import cProfile, json, os, pstats, time, urllib.request\nfrom services.control_plane.bff.core.owner_reads import authorization, selected_tenant, request_read_scope\nfrom services.control_plane.bff.ports.research_knowledge_source import DefaultResearchKnowledgeSourcePort\nbase='http://127.0.0.1:8001'\nprefix='PANTHEON_BFF_DEV_LOGIN_VIEWER_'\nbody={'grant_type':'client_credentials','client_id':os.environ[prefix+'CLIENT_ID'],'client_secret':os.environ[prefix+'CLIENT_SECRET']}\nwith urllib.request.urlopen(urllib.request.Request(base+'/bff/auth/dev-login',data=json.dumps(body).encode(),headers={'Content-Type':'application/json'}),timeout=20) as r:\n    token=json.load(r)['access_token']\nauthorization.set('Bearer '+token)\nwith urllib.request.urlopen(urllib.request.Request(base+'/bff/me',headers={'Authorization':'Bearer '+token}),timeout=20) as r:\n    identity=json.load(r)['data']\ntenant=identity['tenant_id']\nselected_tenant.set(tenant)\nport=DefaultResearchKnowledgeSourcePort()\nout={'tenant_id':tenant,'profiles':{}}\nfor name, fn in [('strategies_page',lambda:port.list_strategy_specs_page(exclude_state='draft',page_size=200)),('registry_artifacts',port.read_registry_strategy_artifacts),('research_artifacts',port.read_research_artifact_catalog_rows)]:\n    prof=cProfile.Profile()\n    with request_read_scope(): result=prof.runcall(fn)\n    stats=pstats.Stats(prof)\n    top=sorted(stats.stats.items(), key=lambda x:x[1][3], reverse=True)[:16]\n    out['profiles'][name]={'rows':len(result.items) if hasattr(result,'items') and not isinstance(result,dict) else len(result.get('items',[])), 'total_time':stats.total_tt,'total_calls':stats.total_calls,'top_cumulative':[{'file':k[0],'line':k[1],'name':k[2],'calls':v[1],'self_seconds':v[2],'cumulative_seconds':v[3]} for k,v in top]}\nprint(json.dumps(out))\n",
      "risk-hosted-benchmark.py": "import concurrent.futures, json, math, os, time, urllib.request\nbase='http://127.0.0.1:8001'\nprefix='PANTHEON_BFF_DEV_LOGIN_VIEWER_'\nbody={'grant_type':'client_credentials','client_id':os.environ[prefix+'CLIENT_ID'],'client_secret':os.environ[prefix+'CLIENT_SECRET']}\nwith urllib.request.urlopen(urllib.request.Request(base+'/bff/auth/dev-login',data=json.dumps(body).encode(),headers={'Content-Type':'application/json'}),timeout=20) as r:\n    token=json.load(r)['access_token']\nheaders={'Authorization':'Bearer '+token}\npaths=['/bff/strategies?exclude_state=draft&page_size=200','/bff/personas?page_size=200','/bff/capital-pools?page_size=200','/bff/runtimes?page_size=200','/bff/tools','/bff/mcp-servers','/bff/skills','/bff/alerts','/bff/incidents?status=open%2Cinvestigating%2Cmitigating%2Cin_progress&page_size=200']\ndef read(path):\n    start=time.perf_counter()\n    with urllib.request.urlopen(urllib.request.Request(base+path,headers=headers),timeout=15) as r: data=json.load(r)\n    return time.perf_counter()-start,data\ndef stats(values):\n    values=sorted(values)\n    return {'p50_seconds':values[math.ceil(len(values)*.5)-1],'p95_seconds':values[math.ceil(len(values)*.95)-1],'max_seconds':values[-1],'rounds':len(values)}\nsamples={p:[] for p in paths}\nartifact=[]\nwith concurrent.futures.ThreadPoolExecutor(max_workers=9) as pool:\n    for _ in range(20):\n        pending={p:pool.submit(read,p) for p in paths}\n        for p,f in pending.items(): samples[p].append(f.result()[0])\nfor _ in range(20):\n    start=time.perf_counter(); token=None; rows=0; pages=0\n    while True:\n        _,data=read('/bff/artifacts?page_size=100'+('&page_token='+token if token else ''))\n        rows+=len(data['data']); pages+=1\n        token=data['page_info'].get('next_page_token')\n        if not token: break\n    artifact.append(time.perf_counter()-start)\nprint(json.dumps({'at':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime()),'scope':'Read-only served baseline, real hosted population; not a 2x fixture acceptance run or an after-change result','fanout':{p:{**stats(v),'samples_seconds':v} for p,v in samples.items()},'artifact_full_walk':{**stats(artifact),'samples_seconds':artifact,'rows':rows,'pages':pages}}))\n"

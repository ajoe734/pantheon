{
  "task_id": "PERSONA-CYCLE-OWNER-PORTS-WIRING-20261115",
  "title": "Persona daily cycle and pool publish and quarterly paper allocation reach their owner services on the deployed dev stack: fix unresolved and unset owner addresses and credentials and show every missing port on health",
  "owner": "Antigravity",
  "reviewer": "Antigravity2",
  "hosted_readback_reproduction": {
    "observed_failures_before_fix": [
      {
        "flow": "persona_daily_cycle_and_pool_cycle",
        "symptom": "persona container in docker-compose.yml was missing owner URLs and credentials for research, memory, registry, evolution, consultation, governance, and search, or pointed RESEARCH_API_URL at unresolvable http://research-orchestrator:8100 instead of http://research-orchestrator-svc:8101",
        "fix": "Wired all 7 owner ports and their least-privilege token files / service tokens on persona in docker-compose.yml and scripts/issue_dev_paper_principals.py"
      },
      {
        "flow": "evolution_and_consultation_owner_authentication",
        "symptom": "evolution (services/evolution/main.py:303) and consultation-svc (services/consultation/auth.py:79) verify static bearer tokens via hmac.compare_digest against EVOLUTION_AUTH_TOKEN and CONSULTATION_SERVICE_TOKEN rather than JWT signatures; pointing persona at rotating JWT files rejected persona cycle requests with 401/403",
        "fix": "Wired persona EVOLUTION_AUTH_TOKEN and CONSULTATION_SERVICE_TOKEN / CONSULTATION_API_TOKEN to match evolution and consultation-svc service tokens while keeping JWT principal files for research, memory, registry, governance, and search"
      },
      {
        "flow": "pool_publish_and_canonical_dataset_authority",
        "symptom": "operator-bff lacked PANTHEON_PERSONA_API_URL / PANTHEON_PERSONA_SERVICE_URL, _sync_canonical_dataset_pointer wrapped a 2-argument governed_dataset_loader(persona, candidate) in a 0-argument callable, and research-orchestrator-svc lacked RESEARCH_RETRAIN_CANONICAL_DATASET_PATH and RESEARCH_RETRAIN_THRESHOLD_POLICY_PATH",
        "fix": "Wired PANTHEON_PERSONA_API_URL and PANTHEON_PERSONA_SERVICE_URL on operator-bff, updated _sync_canonical_dataset_pointer(*args, **kwargs) to accept (persona, candidate) and sync dataset-version-*.json to /data/bff/persona-pool-dataset-authority/canonical-dataset-version.json, and wired RESEARCH_RETRAIN_CANONICAL_DATASET_PATH and RESEARCH_RETRAIN_THRESHOLD_POLICY_PATH on research-orchestrator-svc"
      },
      {
        "flow": "paper_quarterly_allocation",
        "symptom": "capital defaulted PANTHEON_ENV to local and lacked RANKING_STORE_DSN/RANKING_STORE_TABLE; persona-evaluator-agent lacked PERSONA_EVALUATOR_PAPER_POOL_ID and PERSONA_EVALUATOR_ACTOR_ID, and PERSONA_EVALUATOR_BFF_TOKEN lacked operator role and azp=control-plane-bff required by POST /bff/management/allocation-policy/evaluate -> capital POST /api/allocation-evaluations",
        "fix": "Wired PANTHEON_ENV=${PANTHEON_ENV:-dev}, RANKING_STORE_DSN, and RANKING_STORE_TABLE on capital; wired PERSONA_EVALUATOR_PAPER_POOL_ID and PERSONA_EVALUATOR_ACTOR_ID on persona-evaluator-agent; granted viewer, registry-reader, operator and azp=control-plane-bff to PERSONA_EVALUATOR_BFF_TOKEN"
      },
      {
        "flow": "persona_health_and_per_persona_ooda_heartbeat",
        "symptom": "GET /health returned ok without checking owner ports, and run_controller filtered report['failures'] by f.get('persona_id') in owned, dropping owner-port failures without persona_id and recording downstream_actual_state={'status': 'ready'} on per_persona_ooda",
        "fix": "Added services/persona/owner_port_health.py with OwnerPortEnvView (no os.environ mutation) and attached owned persona_id entries to owner_port failure records so both /health and per_persona_ooda / persona_daily_cycle heartbeats report degraded and name every missing or unreachable owner port"
      }
    ]
  },

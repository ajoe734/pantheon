    "failure_and_degraded_behavior": {
      "proof": [
        "Bounded failures enter the DLQ and only an operator replay with a new replay identity creates a new generation.",
        "Research authority failure remains retryable and never creates a local run file as authoritative truth."
      ],
      "status": "pass"
    },
    "request_receipt_downstream_correlation": {
      "proof": [
        "Queue acknowledgement preserves domain ExperimentTask and ExperimentRun IDs separately from resolvable research-authority task and run IDs.",

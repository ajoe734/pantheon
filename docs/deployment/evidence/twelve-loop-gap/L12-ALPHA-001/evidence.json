  "behavioral_proof": {
    "duplicate_safety": {
      "proof": [
        "Queue identity is tenant_id plus strategy_spec_id, so duplicate discovery converges to one durable record per tenant.",
        "Every consumed replay ID remains durable; replay-A, replay-B, process restart, and reused replay-A leave replay_count unchanged at two."

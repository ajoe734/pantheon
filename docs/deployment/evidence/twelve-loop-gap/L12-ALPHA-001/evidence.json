      ],
      "status": "pass"
    },
    "restart_and_recovery": {
      "proof": [
        "Expired claims return to pending and the previous fencing token cannot acknowledge reclaimed work.",
        "A crash after authority persistence reclaims the same deterministic task and run identity without duplicate authority state.",
        "The A-B-A replay identity remains rejected after the queue process restarts."
      ],
      "status": "pass"
    },
    "rollback_or_compensation": {
      "proof": [
        "Lease token and generation fencing prevent stale acknowledgements after expiry or reclaim.",

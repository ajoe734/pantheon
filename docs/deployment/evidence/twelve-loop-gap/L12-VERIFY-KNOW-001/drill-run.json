  "gaps": [
    {
      "correlation_id": "d7cef595fcce49ca91aee70cf76d64f0",
      "detail": "SourceProvisioningReconciler._reconcile_requirement returns 'verified_existing_custom_connector' without calling _ensure_connector, so metadata['persona_source_reconciliation'] is never written. /api/source-ingest/controller/readback therefore reports an empty desired_state for the connector, and controller_worker._validate_terminal_readback fails closed on desired_dataset_mismatch (and, because cadence is unknown, source_data_stale). Loop 1 can only reach terminal reconciled truth through the two built-in TW live providers, never through an operator-approved bounded connector.",
      "found_at": "2026-08-04T21:22:50Z",
      "gap_id": "G2",
      "loop_id": "source_ingestion",
      "observed": "terminal source readback failed closed: conn-l12-know-bounded-paper:desired_dataset_mismatch, conn-l12-know-bounded-paper:source_data_stale",
      "owning_surface": "services/source_ingestion/persona_source_reconciler.py",
      "title": "Operator-managed connectors bound to a Persona requirement never receive the persona_source_reconciliation desired-state marker"
    },
    {
      "correlation_id": "d7cef595fcce49ca91aee70cf76d64f0",
      "detail": "_queue_payload_from_registry_entry requires metadata['tenant_id'] or an embedded strategy_spec['tenant_id'] on the approved Registry entry. The distillation controller builds the entry from StrategySpecConversionService.convert_seed and adds only a metadata['distillation'] block, so no tenant binding is ever written. Even with the discovery join repaired, every approved distilled spec is rejected at queue admission.",
      "found_at": "2026-08-04T21:22:50Z",
      "gap_id": "G3",
      "loop_id": "strategy_distillation",
      "observed": "ValueError: approved StrategySpec tenant_id is required",
      "owning_surface": "services/source_ingestion/distillation_controller.py -> services/research/alpha_replication/replication_controller.py",
      "title": "Distilled StrategySpec Registry entries carry no tenant binding, so alpha replication rejects them even when discovery succeeds"
    },
    {
      "correlation_id": "d7cef595fcce49ca91aee70cf76d64f0",
      "detail": "run_controller_tick reads discovery keys from the distillation seed store field 'source_id' and passes each one to _get_approved_specs_for_strategy, which queries /api/registry/strategies/{strategy_id}/strategy-specs. The distillation controller registers the spec under strategy_id 'strat-<source_id>-<digest12>' (distillation_controller._build_registry_payload), and the seed record carries no registry or strategy identity at all. The two keys can never match, so an approved StrategySpec is never admitted as alpha replication desired state. docker-compose.yml points both services at the same STRATEGY_SPEC_SEED_STORE_PATH, so the deployed configuration has the same break.",
      "found_at": "2026-08-04T21:22:50Z",
      "gap_id": "G1",
      "loop_id": "alpha_replication",
      "observed": "approved_spec_count=0 while the Registry holds approved reg-strategy-spec-src-l12-know-d7cef595-001-f076620b3053 under strategy_id strat-src-l12-know-d7cef595-001-fdad5818c7fb",
      "owning_surface": "services/research/alpha_replication/replication_controller.py",
      "title": "Alpha replication discovery joins the distillation seed store's source_id against the Registry strategy_id"
    },
    {
      "correlation_id": "d7cef595fcce49ca91aee70cf76d64f0",
      "detail": "services/registry/storage.RegistryStore is a process-local in-memory dict behind a module singleton, and services/registry/main.py mounts that app unchanged. The deployed registry container receives DATABASE_URL and an object-store config but never uses them for entry storage and mounts no volume. Every StrategySpec \u2014 including approved, immutable, review-decided ones \u2014 is lost when the process restarts. The L12-DIST-001 immutability guarantee and the L12-ALPHA-001 approved-only admission gate both rest on this authority.",
      "found_at": "2026-08-04T21:22:54Z",
      "gap_id": "G5",
      "loop_id": "strategy_distillation",
      "observed": "reg-strategy-spec-src-l12-know-d7cef595-001-f076620b3053 was approved at 2026-08-04T21:22:50Z and returns 404 after 1 restart(s)",
      "owning_surface": "services/registry/storage.py",
      "title": "The Registry artifact authority has no durable storage, so approved immutable StrategySpecs do not survive a restart"
    },
    {
      "correlation_id": "d7cef595fcce49ca91aee70cf76d64f0",
      "detail": "Because discovery (G1) never admits the approved spec, the controller records a successful tick with approved_spec_count=0, backlog 0, and no evidence refs. The projected BFF truth is therefore 'healthy' and shows no backlog, so an operator cannot see that an approved artifact is waiting. The live deployment shows the same shape: the running alpha-replication controller has recorded tens of thousands of successful ticks with approved_spec_count=0.",
      "found_at": "2026-08-04T21:22:57Z",
      "gap_id": "G4",
      "loop_id": "alpha_replication",
      "observed": "controller approved_spec_count=0 while the Registry holds 1 approved StrategySpec and the research authority holds 0 ExperimentRun(s)",
      "owning_surface": "services/research/alpha_replication/replication_controller.py",
      "title": "alpha_replication operator truth reports a healthy, empty loop while an approved StrategySpec is stranded"
    }

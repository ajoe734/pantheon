  "owner_contract_notes": {
    "capability_snapshots": "PersonaRegistryHttpStore batches via GET /api/capability-snapshots once per request when supported and falls back to per-persona snapshot payloads embedded in GET /api/personas records without extra per-persona HTTP calls.",
    "sessions": "ReadSurfacePorts.list_persona_sessions batches via list_persona_sessions(None) (GET /api/sessions) once per request when backed by PersonaRegistryHttpStore and filters by persona_id in memory.",
    "teaching_sessions": "PersonaRegistryHttpStore does not expose a cross-persona GET /api/teaching-sessions bulk endpoint on the Persona owner; ReadSurfacePorts.list_persona_teaching_sessions uses store.list_teaching_sessions() when available and caches per-persona teaching session reads within the request while skipping retired personas.",
    "retired_personas": "Retired personas remain included in persona-league, persona-fleet (including archived state=retired views), and persona-health, but skip live owner enrichment (runtime_bindings, bindings, sessions, paper reconciler sessions, telemetry, capability snapshots, route policies, allowed actions, and source-health overlay).",
    "ranking_snapshot_invariance": "PersonaService.get_persona_league computes _pm12_attach_ranking_snapshot over the full set of ranked rows (while retired personas skip live enrichment) and applies state/archetype/q filtering and page_size slicing before per-persona route_policy/health/allowed_action enrichment, so summary.ranking_snapshot_id and per-item ranking_snapshot_id are identical for filtered and unfiltered league requests."
  },

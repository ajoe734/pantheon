{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ajoe734/pantheon/docs/deployment/loop-catalog.schema.json",
  "title": "Pantheon Loop Catalog",
  "description": "Static machine-readable catalog for Pantheon loop desired state, actual state, ownership, and controller contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "created_at",
    "source_documents",
    "catalog_decisions",
    "loops",
    "composite_overlays"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "loop_catalog.v2"
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^global-loop-catalog-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_documents": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "catalog_decisions": {
      "$ref": "#/definitions/CatalogDecisions"
    },
    "loops": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/definitions/CanonicalLoopCatalogEntry"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "loop_id": {
                "const": "source_ingestion"
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "loop_id": {
                "const": "strategy_distillation"
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "loop_id": {
                "const": "alpha_replication"
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "loop_id": {
                "const": "persona_teaching"
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "loop_id": {
                "const": "agora_interaction_evidence"
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "loop_id": {
                "const": "human_imitation_shadow_evaluation"
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "loop_id": {
                "const": "consultation"
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "loop_id": {
                "const": "promotion_deployment"
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "loop_id": {
                "const": "capital_pool_execution"
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "loop_id": {
                "const": "telemetry_reconciliation"
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "loop_id": {
                "const": "evolution"
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "loop_id": {
                "const": "bff_health_monitoring"
              }
            }
          }
        }
      ]
    },
    "composite_overlays": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/LoopCatalogEntry"
          },
          {
            "properties": {
              "loop_id": {
                "const": "per_persona_ooda"
              },
              "classification": {
                "const": "composite_overlay"
              },
              "composed_of": {
                "$ref": "#/definitions/PerPersonaOodaComposition"
              }
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "LoopClassification": {
      "type": "string",
      "enum": [
        "canonical",
        "composite_overlay"
      ]
    },
    "CanonicalLoopCatalogEntry": {
      "allOf": [
        {
          "$ref": "#/definitions/LoopCatalogEntry"
        },
        {
          "properties": {
            "classification": {
              "const": "canonical"
            }
          }
        }
      ]
    },
    "PerPersonaOodaComposition": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "source_ingestion",
          "strategy_distillation",
          "alpha_replication",
          "persona_teaching",
          "agora_interaction_evidence",
          "human_imitation_shadow_evaluation",
          "consultation",
          "promotion_deployment",
          "telemetry_reconciliation",
          "evolution"
        ]
      }
    },
    "CatalogDecisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placement",
        "registry_artifact",
        "read_model_followup_task",
        "guardrail_followup_task",
        "rationale"
      ],
      "properties": {
        "placement": {
          "type": "string",
          "const": "static-json-first"
        },
        "registry_artifact": {
          "type": "string",
          "const": "docs/deployment/loop-catalog.registry.json"
        },
        "read_model_followup_task": {
          "type": "string",
          "const": "LOOP-AUTO-001"
        },
        "guardrail_followup_task": {
          "type": "string",
          "const": "LOOP-AUTO-002"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "LoopCatalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loop_id",
        "classification",
        "name",
        "policy_ref",
        "owner",
        "trigger_model",
        "desired_state",
        "actual_state",
        "controller_contract"
      ],
      "properties": {
        "loop_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "classification": {
          "$ref": "#/definitions/LoopClassification"
        },
        "composed_of": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "policy_ref": {
          "$ref": "#/definitions/PolicyRef"
        },
        "owner": {
          "$ref": "#/definitions/LoopOwner"
        },
        "trigger_model": {
          "$ref": "#/definitions/TriggerModel"
        },
        "desired_state": {
          "$ref": "#/definitions/StateProbe"
        },
        "actual_state": {
          "$ref": "#/definitions/StateProbe"
        },
        "controller_contract": {
          "$ref": "#/definitions/ControllerContract"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "const": "composite_overlay"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "policy_ref": {
                "properties": {
                  "document": {
                    "const": "Pantheon_總索引版系統分析文件.md"
                  },
                  "section": {
                    "const": "6.4"
                  }
                }
              }
            },
            "required": [
              "composed_of"
            ]
          },
          "else": {
            "properties": {
              "policy_ref": {
                "properties": {
                  "document": {
                    "const": "LOOP_TRIGGER_AND_CONCURRENCY_POLICY.md"
                  },
                  "section": {
                    "pattern": "^3\\.[0-9]+$"
                  }
                }
              }
            },
            "not": {
              "required": [
                "composed_of"
              ]
            }
          }
        }
      ]
    },
    "PolicyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "section",
        "section_title"
      ],
      "properties": {
        "document": {
          "type": "string",
          "enum": [
            "LOOP_TRIGGER_AND_CONCURRENCY_POLICY.md",
            "Pantheon_總索引版系統分析文件.md"
          ]
        },
        "section": {
          "type": "string",
          "pattern": "^(3\\.[0-9]+|6\\.4)$"
        },
        "section_title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "LoopOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "service_or_doc",
        "authoritative_write_owner"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "service_or_doc": {
          "type": "string",
          "minLength": 1
        },
        "authoritative_write_owner": {
          "type": "string",
          "minLength": 1
        },
        "current_controller_owner": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "TriggerModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "continuous",
        "output_artifacts",
        "race_policy"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "continuous": {
          "type": "boolean"
        },
        "output_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "race_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "StateProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "query",
        "query_status"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "query": {
          "type": [
            "string",
            "null"
          ]
        },
        "query_status": {
          "type": "string",
          "enum": [
            "missing",
            "planned",
            "implemented",
            "historical"
          ]
        }
      }
    },
    "ControllerContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "controller_name",
        "desired_state_query",
        "actual_state_query",
        "idempotency_key",
        "duplicate_event_policy",
        "restart_behavior",
        "liveness_metric",
        "operator_truth_projection"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_implemented",
            "planned",
            "implemented",
            "proven_live"
          ]
        },
        "controller_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "desired_state_query": {
          "type": [
            "string",
            "null"
          ]
        },
        "actual_state_query": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "duplicate_event_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "restart_behavior": {
          "type": [
            "string",
            "null"
          ]
        },
        "liveness_metric": {
          "type": [
            "string",
            "null"
          ]
        },
        "operator_truth_projection": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}

# Example environment for the dedicated VM-2 execution-plane stack.
# Usage:
#   docker compose --env-file env/prod-exec.env.example -f docker-compose.exec.yml up -d
#
# This stack intentionally excludes BFF, persona, registry, promotion,
# lineage-read, governance, telemetry, incidents, and other VM-1 services.
# Broker / exchange credentials belong here, not on the control-plane VM.

# ---------------------------------------------------------------------------
# Execution infra
# ---------------------------------------------------------------------------
SIGNAL_STORE_PORT=26379
SIGNAL_STORE_URL=redis://signal-store:6379

RUNTIME_MANAGER_PORT=28081
PANTHEON_RUNTIME_MANAGER_URL=http://runtime-manager:8081
PANTHEON_RUNTIME_MANAGER_TOKEN=runtime-control-internal
PANTHEON_RUNTIME_BINDING_STORE_PATH=/data/runtime/runtime_bindings.json
PANTHEON_SINGLE_RUNTIME_ENFORCED=true
PANTHEON_WORKSPACE_REF=workspace-paper
PANTHEON_AUTH_PROFILE_REF=auth-profile-paper
PANTHEON_PERSONA_ID=persona-paper-ops
PANTHEON_SESSION_ID=session-paper-runtime
PANTHEON_TRACE_ID=trace-paper-runtime
PANTHEON_REQUEST_ID=request-paper-runtime
# VM-2 publishes execution telemetry back to VM-1.
# Local single-host split-stack example:
# PANTHEON_TELEMETRY_URL=http://host.docker.internal:18083
PANTHEON_TELEMETRY_URL=http://10.140.0.4:38083

# ---------------------------------------------------------------------------
# Paper execution runtime
# ---------------------------------------------------------------------------
PANTHEON_EXECUTION_MODE=paper
PANTHEON_PAPER_RUNTIME_ID=paper-runtime-001
PANTHEON_STRATEGY_ID=strategy-paper
PANTHEON_SIGNAL_QUEUE_KEY=pantheon:signals:pending
PANTHEON_BROKER_RUNTIME_ID=broker-adapter-001
PANTHEON_EXCHANGE_RUNTIME_ID=exchange-adapter-001
LEAN_PAPER_PORT=28110

# Optional profile for future live runtime bring-up
PANTHEON_LIVE_RUNTIME_ID=live-runtime-001
LEAN_LIVE_PORT=28111

# ---------------------------------------------------------------------------
# Broker / exchange sidecars
# ---------------------------------------------------------------------------
BROKER_ADAPTER_PORT=28097
BROKER_ADAPTER_MODE=mock
EXCHANGE_ADAPTER_PORT=28098
EXCHANGE_ADAPTER_MODE=mock

# Set to false once real paper/live credentials are mounted on VM-2
PANTHEON_SECRETS_OPTIONAL=true

# Governed provider boundary for execution / research-grade datasource bring-up.
EXECUTION_BROKER_PROVIDER=IBKR
TW_EXECUTION_PROVIDER=Shioaji
CRYPTO_EXECUTION_PROVIDER=Kraken
TW_RESEARCH_PROVIDER=TEJ
US_MARKET_DATA_PROVIDER=Massive / Polygon
CANARY_BROKER_ACCOUNT_REF=broker-subaccount-paper-us-equities
CANARY_VENUE_REF=venue-nyse-arca-smart
US_MARKET_DATA_SECRET_REF=pantheon-dev-us-market-data
SHIOAJI_ACCOUNT_NAME=paper-tw-equities
TEJ_DATASET_CODE=TWN/APRCD1

# Paper / sandbox broker secrets
BROKER_API_KEY=
BROKER_API_SECRET=

# Exchange adapter secrets
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Taiwan / crypto / research-grade provider secrets
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
TEJ_API_KEY=

# ---------------------------------------------------------------------------
# Optional metadata for operator automation
# ---------------------------------------------------------------------------
BROKER_API_KEY_SECRET_NAME=pantheon-dev-broker-api-key
BROKER_API_SECRET_SECRET_NAME=pantheon-dev-broker-api-secret
EXCHANGE_API_KEY_SECRET_NAME=pantheon-dev-exchange-api-key
EXCHANGE_API_SECRET_SECRET_NAME=pantheon-dev-exchange-api-secret
SHIOAJI_API_KEY_SECRET_NAME=pantheon-dev-shioaji-api-key
SHIOAJI_SECRET_KEY_SECRET_NAME=pantheon-dev-shioaji-secret-key
KRAKEN_API_KEY_SECRET_NAME=pantheon-dev-kraken-api-key
KRAKEN_API_SECRET_SECRET_NAME=pantheon-dev-kraken-api-secret
TEJ_API_KEY_SECRET_NAME=pantheon-dev-tej-api-key

# Provider smoke defaults for datasource contract validation.
IBKR_SMOKE_SYMBOL=AAPL.US
SHIOAJI_SMOKE_SYMBOL=2330.TWSE
KRAKEN_SMOKE_SYMBOL=BTC/USD.KRAKEN
TEJ_SMOKE_SYMBOL=2330
TEJ_SMOKE_AS_OF_DATE=2026-04-24

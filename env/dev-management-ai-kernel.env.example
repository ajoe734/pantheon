# Development-only Management AI kernel/control-mode overlay.
#
# Use only on an internal dev VM when an operator needs Management AI to enter
# short-lived control mode for SA/SD generation or DevTaskPacket handoff.
# Product and staging defaults must remain user mode with kernel disabled.
PANTHEON_ENV=dev
PANTHEON_DEPLOYMENT_STAGE=dev
PANTHEON_ASSISTANT_ENABLED=true
PANTHEON_MANAGEMENT_NL_ASSISTANT_PROVIDER_ENABLED=true
PANTHEON_ASSISTANT_KERNEL_ENABLED=true
PANTHEON_ASSISTANT_CONTROL_MODE_STORE_PATH=/data/bff/assistant-control-mode.json
PANTHEON_ASSISTANT_CONTROL_IDLE_TTL_SECONDS=300
# Preserve an existing governed hash; never place the cleartext passphrase here.
PANTHEON_ASSISTANT_CONTROL_PASSPHRASE_HASH=

# The BFF must mount the same status root that the supervisor drains from.
# On the shared dev VM, the live supervisor config points at /home/lupin/code/pantheon.
# Adjust this path if your supervisor config uses a different status_file root.
PANTHEON_STATUS_ROOT_HOST=/home/lupin/code/pantheon
PANTHEON_STATUS_ROOT_CONTAINER=/workspace/status-root

# OpenClaw adapter prepares repair worktrees by cloning the read-only status
# root into /srv/pantheon-assistant/worktrees, then resetting origin to the
# canonical GitHub remote for normal branch/PR closeout.
PANTHEON_ASSISTANT_REPAIR_REPO_URL=/workspace/status-root
PANTHEON_ASSISTANT_REPAIR_REMOTE_URL=https://github.com/ajoe734/pantheon.git
PANTHEON_ASSISTANT_REPAIR_REPO_URL_EXECUTE_PLANS=https://github.com/ajoe734/execute-plans.git
PANTHEON_ASSISTANT_REPAIR_REMOTE_URL_EXECUTE_PLANS=https://github.com/ajoe734/execute-plans.git

# Dev remains on strict signed-JWT auth even when kernel mode is enabled.
# The public browser identity is capability-free and read-only. Privileged
# capabilities must be carried by a governed short-lived identity.
PANTHEON_BFF_AUTH_STUB=false
PANTHEON_BFF_AUTH_MODE=strict
PANTHEON_BFF_STUB_CAPABILITIES=
PANTHEON_BFF_STUB_LEGACY_BARE_TOKENS=

# Supply JWT signing and a server-side client profile map from the governed
# runtime secret store. Each client profile fixes its own subject, roles,
# tenant/allowed-tenants, capabilities, and MFA state. Do not commit values.
PANTHEON_BFF_JWT_SECRET=
PANTHEON_BFF_JWT_ISSUER=pantheon-dev
PANTHEON_BFF_JWT_AUDIENCE=bff-operators
PANTHEON_BFF_DEV_LOGIN_CLIENT_PROFILES_JSON=
# OIDC/JWKS trust inputs are independent of dev-login credentials. Preserve
# their deployed values exactly when the external IdP path is configured.
PANTHEON_BFF_JWKS_URI=
PANTHEON_BFF_OIDC_DISCOVERY_URL=
PANTHEON_BFF_OIDC_ISSUER=
PANTHEON_BFF_OIDC_AUDIENCE=
PANTHEON_BFF_TENANT_ID=tenant-dev
PANTHEON_BFF_ALLOWED_TENANTS=tenant-dev
PANTHEON_BFF_ROLE_CLAIMS=roles,role
PANTHEON_BFF_ROLE_MAP=
PANTHEON_BFF_ROLE_MAP_MODE=passthrough
PANTHEON_BFF_DEFAULT_ROLE=viewer
PANTHEON_BFF_MFA_REQUIRED=false
PANTHEON_BFF_MFA_CLAIMS=amr,acr,mfa,mfa_verified
PANTHEON_BFF_MFA_VALUES=true,1,yes,mfa,otp,totp,webauthn

# Shioaji TW broker sandbox credentials (operator-only)
#
# Copy to env/.env.shioaji and fill in the real values.
# env/.env.shioaji is gitignored — never commit real keys.
#
# Loaded by supervisor restart wrapper:
#   set -a; source env/.env.shioaji; set +a
#   nohup python3 -u .orchestrator/supervisor.py --verbose > .orchestrator/logs/supervisor-restart-<ts>.log 2>&1 &

# Gate (must be true for sandbox; live orders always rejected regardless)
BROKER_SHIOAJI_SANDBOX_ENABLED=true

# Sinopac Securities API credentials (永豐金證券)
BROKER_SHIOAJI_API_KEY=
BROKER_SHIOAJI_SECRET_KEY=

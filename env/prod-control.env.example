# Example environment for the dedicated VM-1 control-plane stack.
# Usage:
#   docker compose --env-file env/prod-control.env.example -f docker-compose.control.yml up -d
#
# This stack intentionally excludes `runtime-manager`, execution sidecars,
# broker/exchange secrets, and `router`.
# Runtime/backend URLs point from VM-1 to the VM-2 execution plane.
# Published ports use a dedicated 34xxx/35xxx/38xxx/39xxx range so this stack
# can run alongside the repo's root docker-compose.yml during local validation.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pantheon
POSTGRES_PORT=35432

PANTHEON_APP_DB_USER=pantheon_app
PANTHEON_APP_DB_PASSWORD=pantheon_app
PANTHEON_APP_DB_NAME=pantheon
DATABASE_URL=postgresql://pantheon_app:pantheon_app@postgres:5432/pantheon
TELEMETRY_DB_DSN=postgresql://pantheon_app:pantheon_app@postgres:5432/pantheon

# Service data ownership wave 2
# Keep local development rollback by setting these back to json/jsonl.
CONSULTATION_STORE_BACKEND=postgres
SOURCE_INGEST_EVIDENCE_BACKEND=postgres
SEARCH_INDEX_STORE_BACKEND=postgres
SEARCH_EVIDENCE_BACKEND=postgres
TRAINING_SESSION_EVENT_STORE_BACKEND=postgres
POLICY_LEARNING_STORE_BACKEND=postgres
RESEARCH_ORCHESTRATOR_EVENT_STORE_BACKEND=postgres
RESEARCH_WORKER_GATEWAY_EVENT_STORE_BACKEND=postgres

# Service data ownership wave 3
# Keep local development rollback by setting these back to json/jsonl.
GOVERNANCE_STORE_BACKEND=postgres
GOVERNANCE_AUDIT_BACKEND=postgres
CAPITAL_STORE_BACKEND=postgres
CAPITAL_AUDIT_BACKEND=postgres
INCIDENT_STORE_BACKEND=postgres
POSTMORTEM_STORE_BACKEND=postgres
PROMOTION_STORE_BACKEND=postgres
PANTHEON_MEMORY_STORE_BACKEND=postgres
RECONCILIATION_DRIFT_STORE_BACKEND=postgres

# MinIO / artifacts
MINIO_ROOT_USER=pantheon
MINIO_ROOT_PASSWORD=pantheonminio
MINIO_API_PORT=39000
MINIO_CONSOLE_PORT=39001
PANTHEON_S3_ENDPOINT=http://minio:9000
PANTHEON_S3_ACCESS_KEY=pantheon
PANTHEON_S3_SECRET_KEY=pantheonminio
PANTHEON_ARTIFACT_BUCKET=pantheon-artifacts

# NATS
NATS_PORT=34222
NATS_MONITOR_PORT=38222
PANTHEON_NATS_URL=nats://nats:4222

# Staging-live BFF / external VM-2 command backend
BFF_READ_SURFACE_STATE=fresh
PANTHEON_BFF_ALLOW_LOCAL_SNAPSHOT_FALLBACK=false
PANTHEON_ENV=staging-live
PANTHEON_LIVE_BROKER_ENABLED=true
PANTHEON_BFF_CORS_ORIGINS=https://pantheon-ai-system-front-staging-live.lovable.app
PANTHEON_INTERNAL_API_URL=http://10.140.0.5:28081
PANTHEON_RUNTIME_MANAGER_URL=http://10.140.0.5:28081
PANTHEON_RUNTIME_MANAGER_TOKEN=replace-me-runtime-manager-token
PANTHEON_INTERNAL_API_TOKEN=replace-me-runtime-manager-token

# Staging-live BFF operator auth / IdP posture.
# Prefer OIDC discovery or JWKS URI for staging. Leave JWT_SECRET blank unless
# intentionally running the explicit HS256 dev fallback in a non-staging env.
PANTHEON_BFF_AUTH_STUB=false
PANTHEON_BFF_AUTH_MODE=strict
PANTHEON_BFF_JWT_SECRET=
PANTHEON_BFF_JWT_ISSUER=
PANTHEON_BFF_JWT_AUDIENCE=
PANTHEON_BFF_JWKS_URI=
PANTHEON_BFF_OIDC_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
PANTHEON_BFF_OIDC_ISSUER=https://idp.example.com
PANTHEON_BFF_OIDC_AUDIENCE=pantheon-staging-bff
PANTHEON_BFF_ROLE_CLAIMS=groups,roles
PANTHEON_BFF_ROLE_MAP=pantheon-staging-admins=admin;pantheon-staging-operators=operator;pantheon-staging-reviewers=reviewer;pantheon-staging-approvers=approver
PANTHEON_BFF_ROLE_MAP_MODE=strict
PANTHEON_BFF_DEFAULT_ROLE=viewer
PANTHEON_BFF_MFA_REQUIRED=true
PANTHEON_BFF_MFA_CLAIMS=amr,acr,mfa,mfa_verified
PANTHEON_BFF_MFA_VALUES=mfa,otp,totp,webauthn,true

# Persona service
LLM_BACKEND=anthropic

# Published service ports
BFF_PORT=38001
PERSONA_PORT=38002
GOVERNANCE_PORT=38082
TELEMETRY_PORT=38083
EVALUATION_PORT=38084
FEEDBACK_PORT=38085
MEMORY_PORT=38086
REGISTRY_PORT=38087
OPTIMIZER_PORT=38088
PROMOTION_PORT=38089
INCIDENTS_PORT=38090
POSTMORTEMS_PORT=38091
CAPITAL_PORT=38092
EVOLUTION_PORT=38093
LINEAGE_PORT=38094
DEPLOYMENT_PORT=38095

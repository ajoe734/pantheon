# Example environment for the EP5-001 canary-readiness entry path.
#
# Copy this file to env/canary-exec.env on VM-2 and fill in machine-local
# values. This template is for readiness validation and rollback rehearsal.
# It does not by itself prove a real canary runtime.

# ---------------------------------------------------------------------------
# Execution boundary
# ---------------------------------------------------------------------------
PANTHEON_EXECUTION_MODE=canary
PANTHEON_RUNTIME_MANAGER_URL=http://127.0.0.1:28081
PANTHEON_RUNTIME_MANAGER_TOKEN=replace-me-runtime-manager-token
PANTHEON_TELEMETRY_URL=http://127.0.0.1:38083
PANTHEON_SECRETS_OPTIONAL=false

# Sidecar modes must be real for canary readiness.
BROKER_ADAPTER_MODE=real
EXCHANGE_ADAPTER_MODE=real
BROKER_ADAPTER_PORT=28097
EXCHANGE_ADAPTER_PORT=28098

# ---------------------------------------------------------------------------
# Broker / venue boundary
# ---------------------------------------------------------------------------
CANARY_BROKER_ACCOUNT_REF=broker-subaccount-canary-us-equities
CANARY_VENUE_REF=venue-nyse-arca-smart

# Raw secrets are VM-2 only. Keep real values out of tracked files.
BROKER_API_KEY=
BROKER_API_SECRET=
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Secret-name refs may be tracked for operator automation.
BROKER_API_KEY_SECRET_NAME=pantheon-prod-broker-api-key
BROKER_API_SECRET_SECRET_NAME=pantheon-prod-broker-api-secret
EXCHANGE_API_KEY_SECRET_NAME=pantheon-prod-exchange-api-key
EXCHANGE_API_SECRET_SECRET_NAME=pantheon-prod-exchange-api-secret

# ---------------------------------------------------------------------------
# Canary gate metadata
# ---------------------------------------------------------------------------
CANARY_PLAN_ID=plan-canary-001
CANARY_APPROVAL_DECISION_ID=apv-canary-001
CANARY_POOL_ID=pool-canary-001
CANARY_OPERATOR_ID=operator-oncall
CANARY_PERSONA_ID=persona-live-ops
CANARY_PERSONA_CAPITAL_BINDING_ID=pcb-canary-001
CANARY_ALLOWED_DEPLOYMENT_SCOPE=canary
CANARY_REGISTRY_ID=reg-canary-001
CANARY_REGISTRY_VERSION=2.0.0
CANARY_ARTIFACT_TYPE=model_artifact
CANARY_ARTIFACT_CHECKSUM=sha256-canary-artifact-checksum
CANARY_STRATEGY_ID=strategy-canary
CANARY_CURRENT_STAGE=paper
CANARY_TARGET_STAGE=canary
CANARY_RUNTIME_ID=canary-runtime-001
CANARY_RUNTIME_CONFIG_REF=runtime-config://canary/primary
CANARY_ACTIVE_BINDING_ID=rb-canary-active-001

# Policy-default scale for the first canary envelope.
CANARY_CAPITAL_SCALE_PCT=5
CANARY_GROSS_SCALE_PCT=25
CANARY_RAMP_SCHEDULE=day1:1%;day2:2.5%;day3:5%

# ---------------------------------------------------------------------------
# Rollback drill defaults
# ---------------------------------------------------------------------------
CANARY_KILL_SWITCH_REASON=canary_underperformance
CANARY_ROLLBACK_ACTION_TYPE=pause_then_replace
CANARY_FALLBACK_ALLOWED_SCOPE=paper
CANARY_FALLBACK_TARGET_STAGE=paper
CANARY_FALLBACK_PLAN_ID=plan-canary-001-rollback
CANARY_FALLBACK_ARTIFACT_ID=reg-paper-baseline-001
CANARY_FALLBACK_ARTIFACT_VERSION=1.1.9
CANARY_FALLBACK_RUNTIME_ID=paper-runtime-rollback-001

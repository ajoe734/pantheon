# Pantheon FE-BFF integration gate.
# Copy values into CI/repo secrets or local env; do not commit real secrets.

PANTHEON_FE_BASE_URL=https://pantheon-dev.lovable.app
PANTHEON_BFF_BASE_URL=https://pantheon-lupin-dev-bff.34.81.75.241.sslip.io

# CI exchanges these client credentials for a short-lived JWT through:
#   POST /bff/auth/dev-login
PANTHEON_BFF_OIDC_CLIENT_ID=
PANTHEON_BFF_OIDC_CLIENT_SECRET=

# Optional local override when a token has already been acquired.
PANTHEON_BFF_ACCESS_TOKEN=

VITE_BFF_MODE=live
VITE_BFF_FALLBACK=strict
PANTHEON_E2E_STRICT=1
PANTHEON_AUDIT_OUT_DIR=.lovable/audits

# Pantheon Lovable preview - BFF-CONSOL-022 strict cutover soak.
# This env is for the isolated Lovable preview branch only.
# Do not apply it to the main Lovable deployment.
# Target: the existing dev BFF (Pantheon only deploys dev today; staging/prod
# are future tiers and must not be assumed to exist).

VITE_BFF_MODE=live
VITE_BFF_BASE_URL=https://pantheon-lupin-dev-bff.35.201.239.38.sslip.io
VITE_BFF_FALLBACK=strict
VITE_BFF_REAL_WRITES=false
VITE_BFF_DEV_LOGIN_PATH=/bff/auth/dev-login
VITE_BFF_OIDC_CLIENT_ID=<set-in-lovable-dev-only>
VITE_BFF_OIDC_CLIENT_SECRET=<set-in-lovable-dev-only>

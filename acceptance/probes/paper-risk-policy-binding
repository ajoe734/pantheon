def dev_transport_configured():
    return bool(os.environ.get("DEV_DEPLOY_SSH_HOST") and os.environ.get("DEV_DEPLOY_SSH_KEY_FILE"))


def dev_owner_read(kind, identity, tenant, *, timeout):
    if (kind not in {"capital", "telemetry", "approvals"} or not tenant
            or os.environ.get("ACCEPTANCE_BFF_URL", "").rstrip("/") != "https://api.dev.mvl-cap.tw"):
        raise RuntimeError("dev_owner_read_scope_invalid")
    container = "pantheon-operator-bff-1" if kind == "approvals" else "pantheon-paper-signal-producer-1"
    command = "timeout 15s docker exec -i " + container + " python3 -c " + shlex.quote(DEV_OWNER_READ)
    transport = Path(__file__).resolve().parents[2] / "scripts/dev_vm_ssh.sh"
    try:
        result = subprocess.run([str(transport), "exec", command],
            input=json.dumps({"kind": kind, "identity": identity, "tenant": tenant}),
            text=True, capture_output=True, timeout=min(15, timeout))
    except (OSError, subprocess.TimeoutExpired):
        raise RuntimeError("dev_owner_transport_failed") from None
    if result.returncode or len(result.stdout.encode()) > MAX_BYTES:
        raise RuntimeError("dev_owner_read_failed")
    try:
        return json.loads(result.stdout)
    except ValueError:
        raise RuntimeError("dev_owner_response_invalid") from None


def data(body):
    return body.get("data", body) if isinstance(body, dict) else body


def policy_digest(policy):
    return hashlib.sha256(json.dumps(policy, sort_keys=True, separators=(",", ":"),
                                     ensure_ascii=True).encode()).hexdigest()


def effective_policy(pool, referenced_policy_reader=None):
    """Follow owner ref precedence. A null ref can have a valid inline policy.

    A referenced policy needs an authoritative loader; a nearby inline policy
    cannot substitute for an unreadable reference.
    """
    ref = pool.get("risk_policy_ref")
    if ref:
        if referenced_policy_reader is None:
            raise ValueError("referenced_policy_owner_readback_unavailable")
        return referenced_policy_reader(ref), "reference"
    policy = pool.get("risk_policy") or (pool.get("metadata") or {}).get("risk_policy")
    if not isinstance(policy, dict) or not policy:
        raise ValueError("no_effective_policy")
    return policy, "inline"


def policy_errors(policy):
    errors = []
    if not isinstance(policy, dict):
        return ["malformed_policy"]
    if not policy.get("risk_policy_id") or not policy.get("version"):
        errors.append("policy_identity_or_version_missing")
    if policy.get("status") != "active":
        errors.append("policy_not_active")
    # gross_limit is required by the deployed expression input assembler.
    if policy.get("gross_limit") is None:
        errors.append("policy_gross_limit_missing")
    for key in ("gross_limit", "net_limit", "max_leverage", "max_single_name_weight"):
        value = policy.get(key)
        if value is not None and (isinstance(value, bool) or not isinstance(value, (float, int))
                                  or not math.isfinite(value) or value < 0):
            errors.append("policy_limit_invalid:" + key)
    if policy.get("allowed_stages") and "paper" not in policy["allowed_stages"]:
        errors.append("policy_not_paper")
    return errors


DRAFT_PROFILES = ("low",)
DRAFT_SOURCE = "risk_officer_draft"


def _positive_below_one(value):
    return (not isinstance(value, bool) and isinstance(value, (int, float))
            and math.isfinite(value) and 0 < value < 1)


def _bounded_limits(policy):
    """Single-name cap < 1 and a positive cash reserve; the reserve may be a pct or an absolute amount."""
    errors = []
    if not _positive_below_one(policy.get("max_single_name_weight")):
        errors.append("draft_single_name_cap_missing_or_not_below_1")
    pct, absolute = policy.get("min_cash_reserve_pct"), policy.get("min_cash_reserve")
    if not (_positive_below_one(pct) or (not isinstance(absolute, bool) and isinstance(absolute, (int, float))
                                          and math.isfinite(absolute) and absolute > 0)):
        errors.append("draft_cash_reserve_missing_or_not_positive")
    return errors + _outer_bound_errors(policy)


def _outer_bound_errors(policy, profile="low"):
    """A draft limit outside the operator outer bound (gross, leverage, single name, cash reserve) fails."""
    errors = []
    limits = profile_outer_bounds().get(profile) or {}
    for name in ("gross_limit", "max_leverage", "max_single_name_weight"):
        cap, value = limits.get(name), policy.get(name)
        if cap is not None and isinstance(value, (int, float)) and not isinstance(value, bool) and value > cap + 1e-12:
            errors.append("draft_outside_bound:" + name)
    reserve, pct = limits.get("min_cash_reserve_pct"), policy.get("min_cash_reserve_pct")
    if reserve is not None and isinstance(pct, (int, float)) and not isinstance(pct, bool) and pct + 1e-12 < reserve:
        errors.append("draft_outside_bound:min_cash_reserve_pct")
    return errors


def pending_risk_officer_draft(approvals, persona, pool):
    """A pending Governance proposal that carries a risk-officer drafted policy for this pool, or None."""
    for approval in approvals:
        subject = (approval.get("metadata") or {}).get("subject") or {}
        draft = subject.get("risk_officer_draft") or {}
        policy = draft.get("policy")
        if (approval.get("tenant_id") == persona.get("tenantId")
                and approval.get("target_type") == "capital_pool_activation"
                and approval.get("target_id") == pool.get("pool_id")
                and approval.get("decision_state") in {"proposed", "under_review"}
                and subject.get("pool_id") == pool.get("pool_id")
                and (subject.get("requested_risk") or subject.get("requested_profile")) == persona.get("risk")
                and isinstance(policy, dict)
                and (policy.get("metadata") or {}).get("risk_officer_draft", {}).get("source") == DRAFT_SOURCE
                and not _bounded_limits(policy)
                and subject.get("risk_policy_digest") in {policy_digest(policy), risk_policy_digest(policy)}):
            return approval.get("decision_id")
    return None


def risk_officer_draft_errors(policy, approvals, persona, pool):
    """Active policy must be bounded and carry risk-officer provenance; else a pending draft must exist.

    The former hardcoded 2x v1.0 (no single-name cap, no cash reserve, no provenance) fails here.
    Returns (errors, pending_decision_id).
    """
    errors = _bounded_limits(policy)
    prov = ((policy.get("metadata") or {}).get("risk_officer_draft") or {})
    if prov.get("source") != DRAFT_SOURCE or prov.get("risk_persona_id") != "persona-risk-officer":
        errors.append("draft_provenance_missing")
    if not errors:
        return [], None
    pending = pending_risk_officer_draft(approvals, persona, pool)
    return ([], pending) if pending else (errors, None)


def computed_direction_errors(approval, subject):
    """Risk direction is computed from the per-limit comparison, never a constant; paper gate decisions
    must be decided by the dedicated automated gate subject (operator decision P-4)."""
    gate = approval.get("actor_role") == "automated_gate"
    if gate and approval.get("actor_id") != DEV_PAPER_PROVISIONER_SUBJECT:
        return True
    if subject.get("risk_direction") not in {"increase", "reduce", "neutral"}:
        return True
    comparison = subject.get("risk_comparison")
    if (gate or subject.get("risk_direction") != "increase") and not (isinstance(comparison, dict) and comparison):
        return True
    if isinstance(comparison, dict):
        looser = "looser" in comparison.values() or comparison.get("_effective_policy") == "absent"
        if looser != (subject.get("risk_direction") == "increase"):
            return True
    return False


def approved_mapping(approvals, persona, pool, policy, now):
    """Look for explicit owner proof in existing governance decision subjects.

    These are audit evidence requirements, not a new runtime mapping contract.
    No such subject was found on hosted. Registry admission risk_level=low and
    pool activation digests alone do not bind the financial policy contents.
    """
    matches = set()
    digests = {policy_digest(policy), risk_policy_digest(policy)}
    for approval in approvals:
        subject = (approval.get("metadata") or {}).get("subject") or {}
        policy_target = (approval.get("target_id") == policy.get("risk_policy_id")
                         and not str(policy.get("risk_policy_id")).startswith("rp-pool-"))
        target_ok = (
            approval.get("target_version") in digests | {str(policy.get("version"))}
            and subject.get("pool_id") in {pool.get("pool_id"), policy.get("risk_policy_id"), "*"}
        ) if policy_target else (
            approval.get("target_id") == pool.get("pool_id")
            and bool(pool.get("approval_digest"))
            and approval.get("target_version") == pool.get("approval_digest")
            and subject.get("pool_id") == pool.get("pool_id")
        )
        if (approval.get("tenant_id") != persona.get("tenantId")
                or approval.get("target_type") != "capital_pool_activation"
                or not target_ok
                or approval.get("decision_state") != "decided"
                or approval.get("decision") != "approved"
                or not approval.get("decision_id")
                or approval.get("authority_status") != "authoritative"
                or not approval.get("actor_role")
                or not approval.get("actor_id") or not approval.get("decided_at")
                or not approval.get("recorded_at") or not approval.get("controller_record_ref")
                or not is_authorized_to_decide(approval.get("actor_role"), approval.get("risk_level"))
                or approval.get("conditions") or approval.get("revoked_at")
                or approval.get("superseded_by")
                or (subject.get("requested_risk") or subject.get("requested_profile") or subject.get("risk_profile")) != persona.get("risk")
                or computed_direction_errors(approval, subject)
                or subject.get("risk_policy_id") != policy.get("risk_policy_id")
                or subject.get("risk_policy_version") != policy.get("version")
                or subject.get("risk_policy_digest") not in digests):
            continue
        try:
            expiry = datetime.fromisoformat(approval["expires_at"].replace("Z", "+00:00"))
            decided = datetime.fromisoformat(approval["decided_at"].replace("Z", "+00:00"))
            if expiry.tzinfo is None or decided.tzinfo is None or expiry <= now or decided > now:
                continue
            require_dedicated_subject_scope(actor_id=approval["actor_id"],
                owner_user_id=approval.get("owner_user_id"), authorization_scope=approval.get("authorization_scope"))
            enforce_authorization_scope(approval.get("authorization_scope"),
                ApprovalUsageContext(environment="dev", target_stage="paper", capital_scale_pct=0.0))
        except (KeyError, AttributeError, ValueError, TypeError):
            continue
        matches.add(approval["decision_id"])
    return next(iter(matches)) if len(matches) == 1 else None


def rows(body):
    value = data(body)
    if not isinstance(value, list) or len(value) > MAX_ROWS or any(not isinstance(x, dict) for x in value):
        raise ValueError("owner_collection_invalid_or_over_budget")
    return value


def run(fetch, expected=DEFAULT_PERSONAS, *, now=None, referenced_policy_reader=None,
        pool_policy_reader=None):
    now = now or datetime.now(timezone.utc)
    expected = tuple(expected)
    report = {"checked": 0, "expected": len(expected), "personas": {}, "failed": [],
              "observed_at": now.isoformat(), "outer_bounds": profile_outer_bounds()}
    if not expected or len(expected) > 10 or len(set(expected)) != len(expected):
        report.update(passed=False, failed=["expected_personas_empty_duplicate_or_over_budget"])
        return report
    bindings = rows(fetch("/api/v1/runtime-bindings?deployment_mode=paper"))
    try:
        approvals = rows(fetch("/api/v1/approval-decisions"))
        report["approval_rows"] = len(approvals)
    except (RuntimeError, ValueError) as exc:
        approvals = []
        report["mapping_source_error"] = str(exc)
    for pid in expected:
        failures = []
        result = {"failed": failures}
        report["personas"][pid] = result
        try:
            persona = data(fetch("/bff/personas/" + urllib.parse.quote(pid, safe="")))
            if not isinstance(persona, dict) or persona.get("id") != pid:
                raise ValueError("persona_identity_missing")
            if (persona.get("ownerLifecycleState") != "paper_owner"
                    or persona.get("capitalMode") != "paper"
                    or persona.get("is_probe") is True
                    or str(persona.get("name") or "").startswith(("Pantheon Dev Paper Release", "probe-", "test-"))):
                raise ValueError("expected_persona_not_trading")
            tenant = persona.get("tenantId")
            active = [b for b in bindings if b.get("status") == "active"
                      and (b.get("metadata") or {}).get("persona_id") == pid
                      and (b.get("metadata") or {}).get("tenant_id") == tenant]
            if not tenant or len(active) != 1:
                raise ValueError("active_tenant_binding_missing_or_ambiguous")
            binding = active[0]
            pool_id = binding.get("capital_pool_id")
            if not isinstance(pool_id, str) or not pool_id:
                raise ValueError("binding_pool_missing")
            pool = data(fetch("/bff/capital-pools/" + urllib.parse.quote(pool_id, safe="")))
            if (pool.get("pool_id") != pool_id or pool.get("tenant_id") != tenant
                    or pool.get("owner_id") != tenant or pool.get("status") != "active"
                    or (pool.get("metadata") or {}).get("persona_id") != pid):
                raise ValueError("pool_owner_identity_or_status_invalid")
            report["checked"] += 1
            result.update(name=persona.get("name"), tenant_id=tenant, requested_risk=persona.get("risk"),
                          runtime_id=binding.get("runtime_id"), binding_id=binding.get("binding_id"),
                          pool_id=pool_id, artifact_id=binding.get("artifact_id"),
                          artifact_version=binding.get("artifact_version"), risk_policy_ref=pool.get("risk_policy_ref"),
                          persona_display_binding_id=persona.get("runtimeBindingId"))
            owner = data(pool_policy_reader(pool)) if pool_policy_reader else None
            if owner is not None:
                if (owner.get("capital_pool_id") != pool_id or owner.get("tenant_id") != tenant
                        or owner.get("stage") != "paper" or owner.get("resolved") is not True):
                    raise ValueError("policy_owner_resolution_invalid")
            reader = (lambda ref: owner["policy"]) if owner is not None else referenced_policy_reader
            policy, origin = effective_policy(pool, reader)
            failures.extend(policy_errors(policy))
            if persona.get("risk") in DRAFT_PROFILES:
                draft_errors, pending_draft = risk_officer_draft_errors(policy, approvals, persona, pool)
                failures.extend(draft_errors)
                result["risk_officer_draft"] = "pending:" + pending_draft if pending_draft else (
                    "active" if not draft_errors else "missing")
            policy_meta = policy.get("metadata") or {}
            if (policy.get("tenant_id") or policy_meta.get("tenant_id")) not in (None, tenant):
                failures.append("policy_tenant_mismatch")
            for container in (policy, policy_meta):
                if container.get("superseded_by") or container.get("stale") or container.get("revoked_at"):
                    failures.append("policy_stale_or_revoked")
                for key in ("expires_at", "effective_to"):
                    if container.get(key) and datetime.fromisoformat(container[key].replace("Z", "+00:00")) <= now:
                        failures.append("policy_expired")
            result.update(policy_origin=origin, effective_policy=policy)
            if origin == "reference" and policy.get("risk_policy_id") != pool.get("risk_policy_ref"):
                failures.append("referenced_policy_identity_mismatch")
            mapping = approved_mapping(approvals, persona, pool, policy, now)
            result["profile_mapping_approval"] = mapping
            if not persona.get("risk") or not mapping:
                failures.append("required_profile_mapping_unresolved")
        except (RuntimeError, ValueError, TypeError, AttributeError) as exc:
            failures.append(str(exc))
        report["failed"].extend(pid + ":" + f for f in failures)
    if not report["checked"]:
        report["failed"].append("no_expected_personas_checked")
    report["passed"] = report["checked"] == len(expected) and not report["failed"]
    return report


def main(report_runner=None):
    missing = [key for key in REQUIRED if not os.environ.get(key, "").strip()]
    if missing:
        print("skipped: missing " + ", ".join(missing))
        return 77
    base = os.environ["ACCEPTANCE_BFF_URL"].rstrip("/")
    deadline, requests = time.monotonic() + MAX_SECONDS, 0

    def request(path, body=None, token=None, origin=None, tenant=None):
        nonlocal requests
        requests += 1
        remaining = deadline - time.monotonic()
        if requests > MAX_REQUESTS or remaining <= 0:
            raise RuntimeError("probe_budget_exceeded")
        headers = {"Content-Type": "application/json"}
        if token:
            headers["Authorization"] = "Bearer " + token
        if tenant:
            headers["X-Tenant-Id"] = tenant
        req = urllib.request.Request((origin or base) + path, data=json.dumps(body).encode() if body else None,
                                     method="POST" if body else "GET", headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=min(15, remaining)) as response:
                payload = response.read(MAX_BYTES + 1)
            if len(payload) > MAX_BYTES:
                raise RuntimeError("response_size_exceeded")
            return json.loads(payload)
        except urllib.error.HTTPError as exc:
            raise RuntimeError("http_" + str(exc.code)) from None
        except RuntimeError:
            raise
        except Exception as exc:
            raise RuntimeError("request_failed:" + type(exc).__name__) from None

    def owner_read(kind, identity, tenant):
        nonlocal requests
        if kind == "capital":
            base_owner = os.environ.get("ACCEPTANCE_CAPITAL_OWNER_URL", "").rstrip("/")
            owner_token = os.environ.get("ACCEPTANCE_CAPITAL_OWNER_TOKEN", "")
            path = "/api/capital-pools/" + urllib.parse.quote(identity, safe="") + "/risk-policy?stage=paper"
        else:
            base_owner = os.environ.get("ACCEPTANCE_TELEMETRY_URL", "").rstrip("/")
            owner_token = os.environ.get("ACCEPTANCE_TELEMETRY_TOKEN", "")
            path = "/api/telemetry/events/" + urllib.parse.quote(identity, safe="")
        if kind != "approvals" and base_owner and owner_token:
            return request(path, origin=base_owner, token=owner_token, tenant=tenant)
        if dev_transport_configured():
            requests += 2 if kind == "approvals" else 1
            remaining = deadline - time.monotonic()
            if requests > MAX_REQUESTS or remaining <= 0:
                raise RuntimeError("probe_budget_exceeded")
            return dev_owner_read(kind, identity, tenant, timeout=remaining)
        if not base_owner or not owner_token:
            raise RuntimeError("referenced_policy_owner_readback_unavailable" if kind == "capital"
                               else "immutable_telemetry_owner_readback_unavailable")

    try:
        token = request("/bff/auth/dev-login", {
            "grant_type": "client_credentials", "client_id": os.environ[REQUIRED[1]],
            "client_secret": os.environ[REQUIRED[2]],
        }).get("access_token")
        if not token:
            raise RuntimeError("access_token_missing")
        policy_token = token
        policy_id = os.environ.get("ACCEPTANCE_POLICY_READER_CLIENT_ID")
        policy_secret = os.environ.get("ACCEPTANCE_POLICY_READER_CLIENT_SECRET")
        if bool(policy_id) != bool(policy_secret):
            raise RuntimeError("policy_reader_credentials_incomplete")
        if policy_id:
            policy_token = request("/bff/auth/dev-login", {
                "grant_type": "client_credentials", "client_id": policy_id, "client_secret": policy_secret,
            }).get("access_token")
            if not policy_token:
                raise RuntimeError("policy_reader_access_token_missing")
        configured = os.environ.get("ACCEPTANCE_EXPECTED_PERSONA_IDS")
        expected = DEFAULT_PERSONAS if configured is None else tuple(x.strip() for x in configured.split(",") if x.strip())
        def fetch(path):
            if path == "/api/v1/approval-decisions":
                if not policy_id and dev_transport_configured():
                    return owner_read("approvals", "", "tenant-dev")
                return request(path, token=policy_token)
            return request(path, token=token)
        pool_reader = lambda pool: owner_read("capital", pool["pool_id"], pool["tenant_id"]) if pool.get("risk_policy_ref") else None
        if report_runner:
            report = report_runner(fetch, expected, pool_reader,
                lambda: request("/deployment.json", origin=os.environ["ACCEPTANCE_FE_URL"].rstrip("/")), owner_read)
        else:
            report = run(fetch, expected, pool_policy_reader=pool_reader)
    except (RuntimeError, ValueError) as exc:
        print(json.dumps({"passed": False, "failed": [str(exc)]}))
        return 1
    print(json.dumps(report, sort_keys=True, ensure_ascii=False))
    return report.get("exit_code", 0 if report["passed"] else 1)


if __name__ == "__main__":
    sys.exit(main())

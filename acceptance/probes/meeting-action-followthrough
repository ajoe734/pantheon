#!/usr/bin/env python3
# acceptance-owner: MEETING-ACTION-TWO-MEETING-PROOF-20261123
"""Read-only probe: two same-series meetings form a real execution loop (see acceptance/meeting_action_followthrough.py).

Logs in as the read-only viewer (ACCEPTANCE_VIEWER_CLIENT_ID/SECRET via /bff/auth/dev-login; token stays in memory)
and uses GET only. The meetings to observe are named by ACCEPTANCE_MEETING_ACTION_M1 / _M2 (the recorded M1 and the
natural next meeting from MEETING-HOSTED-ACCEPTANCE-20261115). When they are not yet known the observation is
pending: this prints ``pending`` and exits 77 (skipped), never 0. Exit 0 passed, 1 failed.
"""
from __future__ import annotations

import importlib.util
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

REQUIRED = ("ACCEPTANCE_BFF_URL", "ACCEPTANCE_VIEWER_CLIENT_ID", "ACCEPTANCE_VIEWER_CLIENT_SECRET")
MAX_BYTES = 8 * 1024 * 1024


def _load():
    path = Path(__file__).resolve().parent.parent / "meeting_action_followthrough.py"
    spec = importlib.util.spec_from_file_location("meeting_action_followthrough", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _request(request: urllib.request.Request) -> dict:
    try:
        with urllib.request.urlopen(request, timeout=15) as response:  # noqa: S310 - operator-supplied BFF URL
            raw = response.read(MAX_BYTES + 1)
        if len(raw) > MAX_BYTES:
            raise RuntimeError("response_too_large")
        return json.loads(raw.decode("utf-8"))
    except urllib.error.HTTPError as exc:
        raise RuntimeError(f"http_{exc.code}") from None
    except RuntimeError:
        raise
    except Exception as exc:  # never echo URLs, tokens, or bodies
        raise RuntimeError(f"request_failed:{type(exc).__name__}") from None


def main() -> int:
    missing = [n for n in REQUIRED if not os.environ.get(n, "").strip()]
    if missing:
        print("skipped: missing " + ", ".join(missing))
        return 77
    m1 = os.environ.get("ACCEPTANCE_MEETING_ACTION_M1", "").strip()
    m2 = os.environ.get("ACCEPTANCE_MEETING_ACTION_M2", "").strip()
    if not (m1 and m2):
        print(json.dumps(_load().check_chain(lambda p: None, None, None), sort_keys=True))
        return 77
    base = os.environ["ACCEPTANCE_BFF_URL"].rstrip("/")
    try:
        login = json.dumps({"grant_type": "client_credentials", "client_id": os.environ["ACCEPTANCE_VIEWER_CLIENT_ID"],
                            "client_secret": os.environ["ACCEPTANCE_VIEWER_CLIENT_SECRET"]}).encode()
        token = str(_request(urllib.request.Request(base + "/bff/auth/dev-login", data=login, method="POST",
                                                    headers={"Content-Type": "application/json"})).get("access_token") or "")
        if not token:
            raise RuntimeError("no_access_token")
    except RuntimeError as exc:
        print(f"failed: {exc}")
        return 1
    report = _load().check_chain(
        lambda path: _request(urllib.request.Request(base + path, method="GET", headers={"Authorization": "Bearer " + token})),
        m1, m2)
    print(json.dumps(report, sort_keys=True))
    return 0 if report["passed"] else 1


if __name__ == "__main__":
    sys.exit(main())

# Ephemeral Staging Safe Defaults (Non-Secret)
# Sourced by scripts/deploy/staging_provision.sh, scripts/deploy/staging_ops.sh,
# deploy/staging/bootstrap.sh, and scripts/deploy/staging_verify.sh.
# Any override that enables providers, live brokers, real writes, auth stubs, or broker
# credentials on the control VM is rejected fail-closed.

PANTHEON_ENV=staging
PANTHEON_COMPOSE_PROJECT=pantheon-staging
PANTHEON_PROVIDER_ENABLED=false
PANTHEON_LIVE_BROKER_ENABLED=false
PANTHEON_REAL_WRITES_ENABLED=false
PANTHEON_DEV_STUB_WRITES_ENABLED=false
PANTHEON_CONTROL_VM_BROKER_CREDENTIALS_PRESENT=false
PANTHEON_MANAGEMENT_NL_ASSISTANT_PROVIDER_ENABLED=false
PANTHEON_MGMT_NL_ASSISTANT_PROVIDER_ENABLED=false
PANTHEON_ASSISTANT_PROVIDER=disabled
PANTHEON_BFF_AUTH_MODE=strict
PANTHEON_BFF_AUTH_STUB=false
PANTHEON_EXECUTION_MODE=paper
VITE_BFF_MODE=live
VITE_BFF_FALLBACK=strict
STAGING_DEFAULT_TTL_SECONDS=7200
STAGING_MAX_TTL_SECONDS=86400
STAGING_MACHINE_TYPE=e2-standard-2
STAGING_BOOT_DISK_SIZE_GB=50
STAGING_DATA_DISK_SIZE_GB=100
STAGING_ROOT=/var/lib/pantheon-staging-root
STAGING_DATA_MOUNT=/var/lib/pantheon-staging
STAGING_FE_ROOT=/var/www/pantheon-staging-fe
STAGING_BFF_PORT=18001
STAGING_POSTGRES_USER=pantheon_stg
STAGING_POSTGRES_DB=pantheon_staging
STAGING_JWT_ISSUER=https://auth.stg.pantheon.internal
STAGING_JWT_AUDIENCE=pantheon-staging-api
STAGING_IDP_ISSUER=https://idp.stg.pantheon.internal
STAGING_POSTGRES_IMAGE=postgres:16-alpine@sha256:6b202572e5a92a4938fa080be515ad270515fc2d4a5850fa4ca10b0bd3efad89
STAGING_NATS_IMAGE=nats:2.10-alpine@sha256:d3eb053c882d39324bf4b1be5b4cb4dc1aa4bbbe0bf6ce3cdca90f2f2b0b12a7

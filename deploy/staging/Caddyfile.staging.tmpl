# Pantheon Ephemeral Staging — Caddy Reverse Proxy + Static FE Bundle + External Runtime Config
# Rendered per ephemeral release (`__STAGING_BFF_HOST__`, `__STAGING_FE_HOST__`,
# `__STAGING_FE_ROOT__`, `__STAGING_CONFIG_DIR__`, `__STAGING_BFF_UPSTREAM__`).
# /runtime-config.js is served from __STAGING_CONFIG_DIR__ outside the sealed FE release
# directory with Cache-Control: no-store.
# Both private `.internal` HTTPS sites use `tls internal` (Debian Caddy 2.6 does not treat
# `.internal` as an internal subject). The FE routes are shared through a snippet with a
# loopback-only HTTP site at 127.0.0.1:__STAGING_FE_HTTP_PORT__ used by pantheon-staging-collect-gates
# for runtime-config/FE readback; no additional service or process.

__STAGING_BFF_HOST__ {
	tls internal
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Pantheon-Environment "staging"
		-Server
	}
	request_body {
		max_size 10MB
	}
	reverse_proxy __STAGING_BFF_UPSTREAM__
}

(staging_fe_routes) {
	root * __STAGING_FE_ROOT__/current
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		X-Pantheon-Environment "staging"
		-Server
	}

	handle /runtime-config.js {
		root * __STAGING_CONFIG_DIR__
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		header Content-Type "application/javascript; charset=utf-8"
		file_server
	}

	handle /deployment.json {
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		file_server
	}

	@hashed_assets path /assets/*
	header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

	@spa_shell {
		not path /assets/*
		not path /deployment.json
		not path /runtime-config.js
	}
	header @spa_shell Cache-Control "no-store, no-cache, must-revalidate, max-age=0"

	encode zstd gzip
	handle {
		try_files {path} /index.html
		file_server
	}
}

__STAGING_FE_HOST__ {
	tls internal
	import staging_fe_routes
}

http://127.0.0.1:__STAGING_FE_HTTP_PORT__ {
	bind 127.0.0.1
	import staging_fe_routes
}

{
  "schema_version": 1,
  "template_name_prefix": "pantheon-stg-template",
  "name": "pantheon-stg-template-20261024",
  "description": "Pantheon ephemeral staging instance template (non-Spot e2-standard-2, bare Debian 12 bookworm, IAP SSH + HTTPS only).",
  "properties": {
    "machineType": "e2-standard-2",
    "scheduling": {
      "automaticRestart": true,
      "onHostMaintenance": "MIGRATE",
      "preemptible": false,
      "provisioningModel": "STANDARD"
    },
    "disks": [
      {
        "boot": true,
        "autoDelete": true,
        "mode": "READ_WRITE",
        "type": "PERSISTENT",
        "initializeParams": {
          "diskSizeGb": "50",
          "diskType": "pd-balanced",
          "sourceImage": "projects/debian-cloud/global/images/debian-12-bookworm-v20261023"
        }
      }
    ],
    "networkInterfaces": [
      {
        "network": "projects/pantheon-stg-20260902/global/networks/pantheon-staging",
        "subnetwork": "projects/pantheon-stg-20260902/regions/asia-east1/subnetworks/pantheon-staging-asia-east1",
        "accessConfigs": [
          {
            "name": "External NAT",
            "type": "ONE_TO_ONE_NAT",
            "networkTier": "PREMIUM"
          }
        ]
      }
    ],
    "serviceAccounts": [
      {
        "email": "pantheon-stg-runtime@pantheon-stg-20260902.iam.gserviceaccount.com",
        "scopes": [
          "https://www.googleapis.com/auth/cloud-platform"
        ]
      }
    ],
    "shieldedInstanceConfig": {
      "enableIntegrityMonitoring": true,
      "enableSecureBoot": false,
      "enableVtpm": true
    },
    "tags": {
      "items": [
        "pantheon-iap",
        "pantheon-https"
      ]
    },
    "labels": {
      "environment": "staging",
      "cleanup_policy": "automatic",
      "managed_by": "pantheon-ephemeral-staging",
      "owner": "pantheon-release-ops",
      "role": "staging-candidate"
    },
    "metadata": {
      "items": [
        {
          "key": "block-project-ssh-keys",
          "value": "TRUE"
        },
        {
          "key": "enable-oslogin",
          "value": "TRUE"
        },
        {
          "key": "serial-port-enable",
          "value": "FALSE"
        }
      ]
    }
  }
}

# Example environment configuration for the third-location collector host.
# Copy to /opt/pantheon-collector/.env and fill with host-generated values.
# NEVER commit real tokens or API keys to git.

COLLECTOR_DOMAIN=collector.pantheon-collector.invalid
COLLECTOR_CONTACT_EMAIL=collector-ops@example.invalid
COLLECTOR_DATA_ROOT=/var/lib/pantheon-collector
COLLECTOR_SECRETS_DIR=/etc/pantheon-collector

# Generate on the collector host with: openssl rand -hex 32
# Store the matching value in Pantheon's secret store under PANTHEON_COLLECTOR_BUNDLE_TOKEN
COLLECTOR_BUNDLE_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32_ON_HOST

# Gemini model used by collector-youtube-gemini-notes. It must appear in the model list returned for
# your key:  curl -H "x-goog-api-key: $(cat /etc/pantheon-collector/gemini_api_key)" \
#   https://generativelanguage.googleapis.com/v1beta/models
COLLECTOR_GEMINI_MODEL=gemini-2.5-flash

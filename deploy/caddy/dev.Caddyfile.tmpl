# Pantheon dev BFF + FE — Caddy HTTPS termination + ACME.
#
# Rendered and deployed by deploy/caddy/sync-caddy.sh — DO NOT hand-edit the
# copy on the VM. __BFF_HOST__ and __FE_HOST__ are replaced with the env's
# sslip.io hostnames at deploy time so a project/IP cutover updates cert SNI
# automatically.
#
# Upstream is the operator-bff container published on the dev compose stack.
__BFF_HOST__ {
	# Edge HSTS + drop the upstream Server banner. The app itself sets
	# X-Content-Type-Options / X-Frame-Options / Referrer-Policy (BFF
	# _SecurityHeadersMiddleware), so they are not duplicated here.
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# DoS backstop: the operator API only takes JSON command/metadata bodies
	# (no multipart uploads), so 10MB is far above any legitimate request and
	# rejects memory-exhausting oversized bodies at the edge.
	request_body {
		max_size 10MB
	}
	reverse_proxy 127.0.0.1:18001
}

# Static execute-plans build installed by the dev FE deploy flow.
__FE_HOST__ {
	root * __FE_ROOT__
	# Baseline security headers for the browser-facing operator SPA. CSP is
	# intentionally omitted here (it needs the FE build's script/style origins
	# to avoid breaking the app) and tracked as a follow-up.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	@release_manifest path /deployment.json
	header @release_manifest Cache-Control "no-store, no-cache, must-revalidate, max-age=0"

	@hashed_assets path /assets/*
	header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

	@spa_shell {
		not path /assets/*
		not path /deployment.json
	}
	header @spa_shell Cache-Control "no-store, no-cache, must-revalidate, max-age=0"

	encode zstd gzip
	try_files {path} /index.html
	file_server
}

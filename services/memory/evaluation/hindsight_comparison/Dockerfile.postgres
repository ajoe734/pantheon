# Evaluation-only PostgreSQL carrying BOTH pgroonga (from the digest-pinned base)
# and pgvector (Debian package).  No official single image ships both.
FROM groonga/pgroonga@sha256:8360a0cd959687f92451f89c4ed2a59ebdf87e44dfbf744a77ca014ba177b738
RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql-17-pgvector \
 && rm -rf /var/lib/apt/lists/*

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pantheon Registry Entry",
  "type": "object",
  "required": [
    "registry_id",
    "artifact_type",
    "strategy_id",
    "version",
    "artifact_state",
    "lineage",
    "storage_ref",
    "checksum"
  ],
  "properties": {
    "registry_id": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "strategy_spec",
        "model_artifact",
        "behavior_policy",
        "feature_set",
        "prompt_bundle",
        "signal_snapshot",
        "execution_bundle",
        "evaluation_result",
        "critique_result",
        "optimizer_result",
        "allocation_policy"
      ]
    },
    "strategy_id": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "artifact_state": {
      "type": "string",
      "enum": [
        "draft",
        "candidate",
        "approved",
        "retired"
      ]
    },
    "lineage": {
      "type": "object",
      "properties": {
        "parent_registry_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_dataset_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_strategy_spec_id": {
          "type": "string"
        }
      }
    },
    "storage_ref": {
      "type": "object",
      "required": [
        "backend",
        "path"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "object_store",
            "gcs",
            "db",
            "inline"
          ]
        },
        "path": {
          "type": "string"
        }
      }
    },
    "checksum": {
      "type": "string"
    },
    "producer_run_id": {
      "type": "string"
    },
    "evaluation_summary": {
      "type": "object"
    },
    "approval_decision_id": {
      "type": "string"
    },
    "approver": {
      "type": "string",
      "$comment": "Read-only actor from the verified Governance decision; caller approver input is retired."
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "rollback_target": {
      "type": "string"
    },
    "deployment_summary": {
      "type": "object",
      "properties": {
        "current_stage": {
          "type": "string",
          "enum": [
            "none",
            "paper",
            "canary",
            "live",
            "frozen"
          ]
        },
        "deployment_plan_id": {
          "type": "string"
        },
        "runtime_binding_id": {
          "type": "string"
        },
        "last_transition_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true,
      "$comment": "Derived deployment read model only. Deployment stage authority lives outside the registry entry."
    },
    "metadata": {
      "type": "object"
    },
    "approval_evidence": {
      "type": [
        "object",
        "null"
      ],
      "description": "Verified exact Governance owner evidence captured atomically with the approval transition; consumers revalidate at new use time."
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pantheon/registry/strategy-artifact/v1",
  "title": "Pantheon Evolvable Strategy Artifact",
  "description": "A deployable strategy payload registered as the existing execution_bundle artifact type.",
  "type": "object",
  "required": [
    "artifact_schema_version",
    "artifact_id",
    "strategy_id",
    "version",
    "algorithm_ref",
    "strategy_logic",
    "parameters",
    "mutation_surface",
    "lineage"
  ],
  "properties": {
    "artifact_schema_version": {
      "const": "1.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "algorithm_ref": {
      "type": "object",
      "required": [
        "engine",
        "repository",
        "commit",
        "path",
        "entrypoint",
        "signal_interface",
        "signal_schema_version",
        "logic_interpreter"
      ],
      "properties": {
        "engine": {
          "const": "lean"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "signal_interface": {
          "type": "string",
          "minLength": 1
        },
        "signal_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "logic_interpreter": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "strategy_logic": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "lookback_parameter",
            "threshold_parameter",
            "positive_action",
            "non_positive_action"
          ],
          "properties": {
            "kind": {
              "const": "close_to_close_momentum"
            },
            "lookback_parameter": {
              "type": "string",
              "minLength": 1
            },
            "threshold_parameter": {
              "type": "string",
              "minLength": 1
            },
            "positive_action": {
              "enum": ["BUY", "SELL", "HOLD"]
            },
            "non_positive_action": {
              "enum": ["BUY", "SELL", "HOLD"]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "inputs",
            "signal",
            "entry",
            "exit",
            "strength"
          ],
          "properties": {
            "kind": {
              "const": "factor_rule_v1"
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "dataset",
                  "field",
                  "availability_lag_days"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                  },
                  "dataset": {
                    "type": "string",
                    "minLength": 1
                  },
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "availability_lag_days": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "signal": {
              "$ref": "#/$defs/factor_expression"
            },
            "entry": {
              "type": "object",
              "required": [
                "long_when",
                "short_when"
              ],
              "properties": {
                "long_when": {
                  "anyOf": [
                    { "$ref": "#/$defs/factor_expression" },
                    { "type": "null" }
                  ]
                },
                "short_when": {
                  "anyOf": [
                    { "$ref": "#/$defs/factor_expression" },
                    { "type": "null" }
                  ]
                }
              },
              "additionalProperties": false
            },
            "exit": {
              "type": "object",
              "required": [
                "max_holding_bars",
                "flat_when"
              ],
              "properties": {
                "max_holding_bars": {
                  "anyOf": [
                    { "$ref": "#/$defs/const_param_ref" },
                    { "type": "null" }
                  ]
                },
                "flat_when": {
                  "anyOf": [
                    { "$ref": "#/$defs/factor_expression" },
                    { "type": "null" }
                  ]
                }
              },
              "additionalProperties": false
            },
            "strength": {
              "$ref": "#/$defs/factor_expression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "combination_rule",
            "members",
            "risk_limits"
          ],
          "properties": {
            "kind": {
              "const": "persona_portfolio_v1"
            },
            "combination_rule": {
              "const": "clipped_weighted_sum_v1"
            },
            "members": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "required": [
                  "member_id",
                  "artifact_id",
                  "version",
                  "checksum",
                  "risk_weight",
                  "virtual_only",
                  "artifact"
                ],
                "properties": {
                  "member_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "artifact_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+$"
                  },
                  "checksum": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "risk_weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "virtual_only": {
                    "type": "boolean"
                  },
                  "artifact": {
                    "type": "object"
                  }
                },
                "additionalProperties": false
              }
            },
            "risk_limits": {
              "type": "object",
              "required": [
                "max_net_strength",
                "gross_weight_limit"
              ],
              "properties": {
                "max_net_strength": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "gross_weight_limit": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          {
            "not": {
              "pattern": "^prefer_.*_when_.*$"
            }
          }
        ]
      },
      "additionalProperties": {
        "anyOf": [
          {"type": "string"},
          {"type": "number"},
          {"type": "integer"},
          {"type": "boolean"},
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        ]
      }
    },
    "mutation_surface": {
      "type": "object",
      "required": [
        "controls",
        "immutable_parameters"
      ],
      "properties": {
        "controls": {
          "type": "array",
          "minItems": 0,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "parameter_key",
                  "value_type",
                  "current_value",
                  "allowed_range",
                  "step"
                ],
                "properties": {
                  "parameter_key": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                    "not": {
                      "anyOf": [
                        {
                          "pattern": "^prefer_.*_when_.*$"
                        },
                        {
                          "enum": [
                            "max_leverage",
                            "gross_limit",
                            "net_limit",
                            "allowed_asset_classes",
                            "allow_pyramiding",
                            "close_before_reverse"
                          ]
                        }
                      ]
                    }
                  },
                  "value_type": {"const": "integer"},
                  "current_value": {"type": "integer"},
                  "allowed_range": {
                    "type": "object",
                    "required": ["min", "max"],
                    "properties": {
                      "min": {"type": "integer"},
                      "max": {"type": "integer"}
                    },
                    "additionalProperties": false
                  },
                  "step": {"type": "integer", "minimum": 1}
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "parameter_key",
                  "value_type",
                  "current_value",
                  "allowed_range",
                  "step"
                ],
                "properties": {
                  "parameter_key": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                    "not": {
                      "anyOf": [
                        {
                          "pattern": "^prefer_.*_when_.*$"
                        },
                        {
                          "enum": [
                            "max_leverage",
                            "gross_limit",
                            "net_limit",
                            "allowed_asset_classes",
                            "allow_pyramiding",
                            "close_before_reverse"
                          ]
                        }
                      ]
                    }
                  },
                  "value_type": {"const": "number"},
                  "current_value": {"type": "number"},
                  "allowed_range": {
                    "type": "object",
                    "required": ["min", "max"],
                    "properties": {
                      "min": {"type": "number"},
                      "max": {"type": "number"}
                    },
                    "additionalProperties": false
                  },
                  "step": {"type": "number", "exclusiveMinimum": 0}
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "immutable_parameters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "properties": {
        "parent_registry_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "source_run_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "source_dataset_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "source_strategy_spec_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {"required": ["parent_registry_ids"]},
        {"required": ["source_run_ids"]},
        {"required": ["source_dataset_refs"]},
        {"required": ["source_strategy_spec_id"]}
      ]
    },
    "binding_intent": {
      "description": "Non-authoritative target for a later governed DeploymentPlan; this object never mutates RuntimeBinding.",
      "type": "object",
      "required": [
        "persona_id",
        "persona_capital_binding_id",
        "observed_placeholder_artifact_id",
        "observed_at",
        "evidence_ref",
        "replacement_task_id"
      ],
      "properties": {
        "persona_id": {"type": "string", "minLength": 1},
        "persona_name": {"type": "string", "minLength": 1},
        "persona_capital_binding_id": {"type": "string", "minLength": 1},
        "observed_runtime_binding_id": {"type": "string", "minLength": 1},
        "observed_runtime_id": {"type": "string", "minLength": 1},
        "observed_deployment_plan_id": {"type": "string", "minLength": 1},
        "observed_capital_pool_id": {"type": "string", "minLength": 1},
        "observed_placeholder_artifact_id": {"type": "string", "minLength": 1},
        "observed_placeholder_artifact_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "observed_binding_status": {"type": "string", "minLength": 1},
        "observed_deployment_mode": {"enum": ["paper", "canary", "live", "frozen"]},
        "observed_effective_at": {"type": "string", "format": "date-time"},
        "observed_at": {"type": "string", "format": "date-time"},
        "evidence_ref": {"type": "string", "minLength": 1},
        "replacement_task_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "expression_policy": {
      "description": "Deterministic per-persona instrument expression policy for paper/live execution.",
      "type": "object",
      "required": [
        "version",
        "kind",
        "parameters"
      ],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "kind": {
          "const": "notional_target_v1"
        },
        "parameters": {
          "type": "object",
          "required": [
            "lever_min_strength",
            "notional_fraction_at_full_strength",
            "allow_pyramiding",
            "close_before_reverse"
          ],
          "propertyNames": {
            "not": {
              "pattern": "^prefer_.*_when_.*$"
            }
          },
          "properties": {
            "lever_min_strength": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "notional_fraction_at_full_strength": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1.0
            },
            "allow_pyramiding": {
              "type": "boolean"
            },
            "close_before_reverse": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "provenance_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "const_param_ref": {
      "type": "object",
      "required": ["const_param"],
      "properties": {
        "const_param": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "additionalProperties": false
    },
    "input_ref": {
      "type": "object",
      "required": ["ref"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        }
      },
      "additionalProperties": false
    },
    "factor_expression": {
      "oneOf": [
        { "$ref": "#/$defs/const_param_ref" },
        { "$ref": "#/$defs/input_ref" },
        {
          "type": "object",
          "required": ["op", "args"],
          "properties": {
            "op": {
              "enum": [
                "lag",
                "delta",
                "pct_change",
                "ts_mean",
                "ts_std",
                "ts_zscore",
                "ts_rank",
                "ts_min",
                "ts_max",
                "ts_sum",
                "ts_corr",
                "ts_cov",
                "ts_slope",
                "ts_rsquare",
                "ts_resi",
                "ts_quantile",
                "ts_argmax",
                "ts_argmin",
                "ts_decay_linear",
                "ratio",
                "add",
                "sub",
                "mul",
                "div",
                "abs",
                "sign",
                "clip01",
                "log",
                "signed_power",
                "max2",
                "min2",
                "gt",
                "lt",
                "and",
                "or",
                "not"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/factor_expression"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "strategy_logic": {
            "properties": {
              "kind": {
                "const": "persona_portfolio_v1"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "mutation_surface": {
            "properties": {
              "controls": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}

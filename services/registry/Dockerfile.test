FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m ensurepip --upgrade \
    && pip install --no-cache-dir \
       fastapi==0.141.1 \
       pydantic==2.13.5 \
       pytest==9.1.1 \
       httpx==0.28.1 \
       jsonschema==4.26.0 \
       uvicorn==0.53.0

COPY . .

CMD ["pytest", "services/registry/test_service.py", "services/registry/test_strategy_artifact.py", "-v"]

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pantheon/trade_journey/research_journey/v1",
  "title": "ResearchJourney",
  "type": "object",
  "required": [
    "research_journey_id",
    "title",
    "hypothesis",
    "objective",
    "status",
    "created_at",
    "updated_at",
    "persona_id",
    "evidence_refs"
  ],
  "properties": {
    "research_journey_id": {
      "type": "string",
      "pattern": "^rj_[a-zA-Z0-9_-]+$"
    },
    "title": {
      "type": "string"
    },
    "hypothesis": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["active", "succeeded", "rejected", "superseded"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "persona_id": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref_type", "ref_id"],
        "properties": {
          "ref_type": {
            "type": "string"
          },
          "ref_id": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

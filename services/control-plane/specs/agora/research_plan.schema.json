{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pantheon/agora/research_plan/v1",
  "title": "ResearchPlan",
  "description": "Structured research plan emitted by a persona in response to a workshop or ask query. Authorises the research plane to begin an experiment run.",
  "type": "object",
  "required": [
    "spec_version",
    "plan_id",
    "strategy_ref",
    "emitted_by_persona_id",
    "status",
    "objectives",
    "data_requirements",
    "evaluation_criteria",
    "created_at"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique research plan identifier."
    },
    "strategy_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Strategy ID or StrategySpec this plan targets."
    },
    "workshop_id": {
      "type": "string",
      "description": "Optional originating workshop session."
    },
    "completeness_id": {
      "type": "string",
      "description": "Optional StrategyCompleteness that cleared the plan for emission."
    },
    "emitted_by_persona_id": {
      "type": "string",
      "minLength": 1,
      "description": "Persona that emitted this plan."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "running", "completed", "cancelled"],
      "description": "Plan lifecycle state."
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Research objectives to be addressed by the run."
    },
    "data_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "kind"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["dataset", "feature_set", "market_data", "alternative_data", "internal_signal"]
          },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "evaluation_criteria": {
      "type": "object",
      "required": ["primary_metric", "min_sharpe", "max_drawdown"],
      "properties": {
        "primary_metric": {
          "type": "string",
          "minLength": 1
        },
        "min_sharpe": {
          "type": "number"
        },
        "max_drawdown": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "additional_metrics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "oos_period": {
          "type": "string",
          "description": "Out-of-sample validation period (e.g. '2023-01-01/2023-12-31')."
        }
      },
      "additionalProperties": false
    },
    "execution_constraints": {
      "type": "object",
      "properties": {
        "max_runtime_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "compute_tier": {
          "type": "string",
          "enum": ["light", "standard", "heavy"]
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["research", "paper"]
          },
          "description": "Permitted execution environments. Never includes 'live' or 'canary'."
        }
      },
      "additionalProperties": false
    },
    "run_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Research run IDs spawned from this plan.",
      "default": []
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

{
  "manifest_version": "1.11",
  "capabilities": [
    {
      "id": "durable_workshop_operation_lifecycle",
      "name": "agora.workshop.operations.durable.v1",
      "implementation_status": "implemented",
      "routes": [
        "POST /bff/agora/workshops/{workshop_id}/research-runs",
        "POST /bff/agora/workshops/{workshop_id}/consultations",
        "POST /bff/agora/workshops/{workshop_id}/conclude"
      ],
      "authoritative_sources": {
        "strategy_spec_json": "strategy_registry",
        "research_task_and_run": "research_orchestrator",
        "consultation_lifecycle": "consultation_service",
        "approval_decision": "approval_decision_store",
        "command_receipts_and_terminal_state": "strategy_workshop_postgres"
      },
      "durability": {
        "backend": "postgres",
        "restart_persistent": true,
        "downstream_ids_recorded_in_canonical_refs": true,
        "replay_returns_recorded_downstream_ids": true
      },
      "concurrency": {
        "if_match_required": true,
        "idempotency_key_required": true,
        "request_id_required": true,
        "duplicate_requests_do_not_redispatch_downstream": true,
        "conclude_atomic_terminal_cas": true
      },
      "isolation": {
        "tenant_scoped": true,
        "user_scoped": true,
        "mfa_required": true,
        "two_person_approval_operations": [
          "dispatch_research",
          "conclude"
        ]
      },
      "failure_semantics": {
        "downstream_failure_records_failed_receipt": true,
        "failed_key_replay_returns_conflict": true,
        "consultation_commit_failure_compensates_downstream_cancel": true,
        "fabricated_completed_results_forbidden": true
      },
      "conclusion_rules": {
        "requires_in_review_status": true,
        "final_version_must_be_selected": true,
        "registry_readback_digest_must_match_durable_link": true,
        "terminal_state": "concluded"
      },
      "execution_authority": "none"
    }
  ],

  "capabilities": [
    {
      "id": "strategy_performance_truth",
      "name": "agora.performance.truth.v1",
      "version": "1.0",
      "description": "User-private per-strategy/per-period compliance, intervention, canonical execution identity, warning, and governed adjustment-suggestion truth with explicit freshness and availability.",
      "schemas": [
        "SourceAvailability",
        "ComplianceMetric",
        "InterventionRecord",
        "ExecutionHistoryRow",
        "PerformanceWarning",
        "SuggestionProvenance",
        "AdjustmentSuggestion",
        "StrategyPerformanceProjection",
        "PerformanceProjectionEnvelope",
        "SuggestionActionRequest",
        "SuggestionActionReceipt",
        "SuggestionActionEnvelope",
        "TradingRoomPerformanceAttributionEnvelope"
      ],
      "routes": [
        "GET /bff/agora/trading-room/strategies/{strategy_id}/performance",
        "POST /bff/agora/trading-room/strategies/{strategy_id}/performance/suggestions/{suggestion_id}/actions",
        "GET /bff/agora/performance/action-receipts/{receipt_id}",
        "GET /bff/agora/trading-room/performance-attribution/by-strategy"
      ],
      "implementation_status": "implemented"
    },
    {
      "id": "durable_workshop_versions",
      "name": "agora.workshop.versions.durable.v1",
      "implementation_status": "implemented",
      "routes": [
        "GET /bff/agora/workshops/{workshop_id}/versions",
        "POST /bff/agora/workshops/{workshop_id}/versions",
        "POST /bff/agora/workshops/{workshop_id}/versions/{version_id}/select"
      ],
      "authoritative_sources": {
        "strategy_spec_json": "strategy_registry",
        "version_link_and_selection": "strategy_workshop_postgres"
      },
      "durability": {
        "backend": "postgres",
        "restart_persistent": true,
        "legacy_active_pointer_backfill": "deterministic"
      },
      "concurrency": {
        "create_idempotency_key_required": true,
        "select_idempotency_key_required": true,
        "select_if_match_required": true,
        "select_atomic_cas": true
      },
      "isolation": {
        "tenant_scoped": true,
        "user_scoped": true,
        "registry_scope_readback_validated_when_present": true
      },
      "execution_authority": "none"
    },
    {
      "id": "durable_workshop_operation_lifecycle",
      "name": "agora.workshop.operations.durable.v1",
      "implementation_status": "implemented",
      "routes": [
        "POST /bff/agora/workshops/{workshop_id}/research-runs",
        "POST /bff/agora/workshops/{workshop_id}/consultations",
        "POST /bff/agora/workshops/{workshop_id}/conclude"
      ],
      "authoritative_sources": {
        "strategy_spec_json": "strategy_registry",
        "research_task_and_run": "research_orchestrator",
        "consultation_lifecycle": "consultation_service",
        "approval_decision": "approval_decision_store",
        "command_receipts_and_terminal_state": "strategy_workshop_postgres"
      },
      "durability": {
        "backend": "postgres",
        "restart_persistent": true,
        "downstream_ids_recorded_in_canonical_refs": true,
        "replay_returns_recorded_downstream_ids": true
      },
      "concurrency": {
        "if_match_required": true,
        "idempotency_key_required": true,
        "request_id_required": true,
        "duplicate_requests_do_not_redispatch_downstream": true,
        "conclude_atomic_terminal_cas": true
      },
      "isolation": {
        "tenant_scoped": true,
        "user_scoped": true,
        "mfa_required": true,
        "two_person_approval_operations": [
          "dispatch_research",
          "conclude"
        ]
      },
      "failure_semantics": {
        "downstream_failure_records_failed_receipt": true,
        "failed_key_replay_returns_conflict": true,
        "consultation_commit_failure_compensates_downstream_cancel": true,
        "fabricated_completed_results_forbidden": true
      },
      "conclusion_rules": {
        "requires_in_review_status": true,
        "final_version_must_be_selected": true,
        "registry_readback_digest_must_match_durable_link": true,
        "terminal_state": "concluded"
      },
      "execution_authority": "none"
    },
    {
      "id": "candidate_member_truth_projection_contract",
      "name": "agora.candidate.truth.v1",
      "version": "1.0",
      "description": "Every rendered candidate field (rationale, concerns, next event, evidence, details) is either projected verbatim from a durable record of the same candidate with provenance and as-of, or explicitly typed unavailable. Available values are bound to field-specific schemas. Evidence requires a persisted governed ref; no generated narrative, synthetic evidence refs, cross-candidate sample text, or raw private explanations appear in list/viewer projections, and a Sharpe-derived score is never presented as a generic confidence score.",
      "schemas": [
        "FieldProvenance",
        "UnavailableField",
        "ComponentDigest",
        "CandidateRationaleValue",
        "CandidateConcernsValue",
        "CandidateNextEventValue",
        "CandidateEvidenceItem",
        "CandidateEvidenceValue",
        "CandidateDetailsValue",
        "CandidateRationaleAvailableField",
        "CandidateConcernsAvailableField",
        "CandidateNextEventAvailableField",
        "CandidateEvidenceAvailableField",
        "CandidateDetailsAvailableField",
        "CandidateFieldState",
        "CandidateRationaleFieldState",
        "CandidateConcernsFieldState",
        "CandidateNextEventFieldState",
        "CandidateEvidenceFieldState",
        "CandidateDetailsFieldState",
        "CandidateTruthFields",
        "ScoreSemanticsEntry",
        "CandidateScoreSemantics",
        "CandidateMemberTruthProjection",
        "CandidateMemberPageInfo",
        "CandidateMemberListFreshness"
      ],
      "routes": [
        "GET /bff/agora/candidate-pools/{pool_id}/members",
        "GET /bff/agora/candidate-pools/{pool_id}/members/{artifact_id}"
      ],
      "implementation_status": "implemented"
    }
  ],

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pantheon/agora/workshop_card/v1",
  "title": "WorkshopCard",
  "description": "Typed envelope for all 12 workshop card types. Payload shape is constrained by card_type; frontend renders markdown inside typed fields but never infers card type from free LLM output.",
  "type": "object",
  "required": [
    "spec_version",
    "card_id",
    "card_type",
    "workshop_id",
    "sequence_no",
    "status",
    "title",
    "payload",
    "created_at"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "card_id": {
      "type": "string"
    },
    "card_type": {
      "type": "string",
      "enum": [
        "user_strategy_description",
        "servant_reconstruction",
        "completeness_update",
        "missing_definition",
        "next_question",
        "research_plan_proposal",
        "research_progress",
        "research_result",
        "consult_result",
        "version_patch_proposal",
        "version_compare",
        "readiness_gate"
      ]
    },
    "workshop_id": {
      "type": "string"
    },
    "sequence_no": {
      "type": "integer",
      "minimum": 1
    },
    "source_event_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "workshop_version_id": {
      "type": "string"
    },
    "strategy_spec_registry_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "informational",
        "action_required",
        "running",
        "completed",
        "failed",
        "stale"
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": { "$ref": "#/definitions/evidence_ref" }
    },
    "allowed_actions": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "card_type": { "const": "user_strategy_description" } },
        "required": ["card_type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/definitions/payload_user_strategy_description" }
        }
      }
    },
    {
      "if": {
        "properties": { "card_type": { "const": "servant_reconstruction" } },
        "required": ["card_type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/definitions/payload_servant_reconstruction" }
        }
      }
    },
    {
      "if": {
        "properties": { "card_type": { "const": "completeness_update" } },
        "required": ["card_type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/definitions/payload_completeness_update" }
        }
      }
    },
    {
      "if": {
        "properties": { "card_type": { "const": "missing_definition" } },
        "required": ["card_type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/definitions/payload_missing_definition" }
        }
      }
    },
    {
      "if": {
        "properties": { "card_type": { "const": "next_question" } },
        "required": ["card_type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/definitions/payload_next_question" }
        }
      }
    },
    {
      "if": {
        "properties": { "card_type": { "const": "research_plan_proposal" } },
        "required": ["card_type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/definitions/payload_research_plan_proposal" }
        }
      }
    },
    {
      "if": {
        "properties": { "card_type": { "const": "research_progress" } },
        "required": ["card_type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/definitions/payload_research_progress" }
        }
      }
    },
    {
      "if": {
        "properties": { "card_type": { "const": "research_result" } },
        "required": ["card_type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/definitions/payload_research_result" }
        }
      }
    },
    {
      "if": {
        "properties": { "card_type": { "const": "consult_result" } },
        "required": ["card_type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/definitions/payload_consult_result" }
        }
      }
    },
    {
      "if": {
        "properties": { "card_type": { "const": "version_patch_proposal" } },
        "required": ["card_type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/definitions/payload_version_patch_proposal" }
        }
      }
    },
    {
      "if": {
        "properties": { "card_type": { "const": "version_compare" } },
        "required": ["card_type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/definitions/payload_version_compare" }
        }
      }
    },
    {
      "if": {
        "properties": { "card_type": { "const": "readiness_gate" } },
        "required": ["card_type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/definitions/payload_readiness_gate" }
        }
      }
    }
  ],
  "additionalProperties": false,
  "definitions": {
    "evidence_ref": {
      "type": "object",
      "required": ["ref_type", "ref_id"],
      "properties": {
        "ref_type": {
          "type": "string",
          "enum": [
            "evidence_bundle",
            "evidence_item",
            "source_record",
            "citation",
            "experiment_artifact",
            "registry_entry",
            "consult_memo",
            "research_run",
            "telemetry_snapshot",
            "market_context"
          ]
        },
        "ref_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "data_cutoff": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },

    "payload_user_strategy_description": {
      "type": "object",
      "required": ["owner_visible_content", "message_event_id", "created_at"],
      "properties": {
        "owner_visible_content": { "type": "string" },
        "redacted_summary": { "type": "string" },
        "attachment_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "message_event_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },

    "payload_servant_reconstruction": {
      "type": "object",
      "required": ["strategy_title", "causal_chain"],
      "properties": {
        "strategy_title": { "type": "string" },
        "causal_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step_id", "premise", "mechanism", "expected_observation", "confidence"],
            "properties": {
              "step_id": { "type": "string" },
              "premise": { "type": "string" },
              "mechanism": { "type": "string" },
              "expected_observation": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "evidence_refs": {
                "type": "array",
                "items": { "$ref": "#/definitions/evidence_ref" }
              }
            },
            "additionalProperties": false
          }
        },
        "explicit_definitions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "servant_inferences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["statement", "confidence", "needs_confirmation"],
            "properties": {
              "statement": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "needs_confirmation": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "uncertainties": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contradictions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "proposed_next_actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "patch_proposal_ref": { "type": "string" }
      },
      "additionalProperties": false
    },

    "payload_completeness_update": {
      "type": "object",
      "required": ["overall_grade", "dimension_updates", "research_ready"],
      "properties": {
        "overall_grade": { "type": "string" },
        "dimension_updates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dimension", "prior_grade", "current_grade"],
            "properties": {
              "dimension": { "type": "string" },
              "prior_grade": { "type": "string" },
              "current_grade": { "type": "string" },
              "gaps": {
                "type": "array",
                "items": { "type": "string" }
              },
              "required_actions": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "research_ready": { "type": "boolean" },
        "readiness_gates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "change_since_previous": { "type": "string" }
      },
      "additionalProperties": false
    },

    "payload_missing_definition": {
      "type": "object",
      "required": ["gap_id", "category", "severity", "missing_definition", "why_it_matters"],
      "properties": {
        "gap_id": { "type": "string" },
        "category": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "missing_definition": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "downstream_blocked_capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "suggested_temporary_assumption": { "type": "string" },
        "answer_options": {
          "type": "array",
          "items": { "type": "string" }
        },
        "can_defer": { "type": "boolean" },
        "deferral_consequence": { "type": "string" }
      },
      "additionalProperties": false
    },

    "payload_next_question": {
      "type": "object",
      "required": ["question_id", "question", "why_now", "score_total"],
      "properties": {
        "question_id": { "type": "string" },
        "question": { "type": "string" },
        "why_now": { "type": "string" },
        "score_total": { "type": "number" },
        "score_components": {
          "type": "object",
          "properties": {
            "information_gain": { "type": "number" },
            "downstream_blocking_weight": { "type": "number" },
            "risk_impact": { "type": "number" },
            "research_cost_reduction": { "type": "number" },
            "user_relevance": { "type": "number" },
            "penalties": { "type": "number" }
          },
          "additionalProperties": false
        },
        "answer_options": {
          "type": "array",
          "items": { "type": "string" }
        },
        "freeform_allowed": { "type": "boolean" },
        "defer_allowed": { "type": "boolean" },
        "defer_consequence": { "type": "string" },
        "golden_case_ref": { "type": "string" }
      },
      "additionalProperties": false
    },

    "payload_research_plan_proposal": {
      "type": "object",
      "required": ["plan_id", "objectives", "stages"],
      "properties": {
        "plan_id": { "type": "string" },
        "objectives": {
          "type": "array",
          "items": { "type": "string" }
        },
        "data_requirements": {
          "type": "array",
          "items": { "type": "string" }
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stage_id", "stage_type", "purpose"],
            "properties": {
              "stage_id": { "type": "string" },
              "stage_type": { "type": "string" },
              "purpose": { "type": "string" },
              "preferred_backend": { "type": "string" },
              "dependencies": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "evaluation_criteria": { "type": "string" },
        "budget": {
          "type": "object",
          "properties": {
            "compute_tier": { "type": "string" },
            "max_runtime_seconds": { "type": "integer" },
            "max_parallel_stages": { "type": "integer" }
          },
          "additionalProperties": false
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "approval_requirement": { "type": "string" }
      },
      "additionalProperties": false
    },

    "payload_research_progress": {
      "type": "object",
      "required": ["run_id", "plan_id", "stage_id", "stage_type", "execution_status", "progress", "backend"],
      "properties": {
        "run_id": { "type": "string" },
        "plan_id": { "type": "string" },
        "stage_id": { "type": "string" },
        "stage_type": { "type": "string" },
        "execution_status": {
          "type": "string",
          "enum": ["queued", "dispatching", "running", "succeeded", "failed", "cancelled", "timed_out"]
        },
        "progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "backend": { "type": "string" },
        "latest_progress_message": { "type": "string" },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blocking_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "started_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },

    "payload_research_result": {
      "type": "object",
      "required": ["run_id", "outcome"],
      "properties": {
        "run_id": { "type": "string" },
        "outcome": {
          "type": "string",
          "enum": ["pending", "pass", "fail", "inconclusive"]
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "name", "value", "gate_result"],
            "properties": {
              "category": {
                "type": "string",
                "enum": ["performance", "risk", "cost", "capacity", "robustness", "calibration", "data_quality"]
              },
              "name": { "type": "string" },
              "value": { "type": "number" },
              "unit": { "type": "string" },
              "gate_result": {
                "type": "string",
                "enum": ["pass", "fail", "not_applicable", "not_evaluated"]
              }
            },
            "additionalProperties": false
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finding_id", "severity", "summary"],
            "properties": {
              "finding_id": { "type": "string" },
              "severity": {
                "type": "string",
                "enum": ["info", "watch", "warning", "high", "critical"]
              },
              "summary": { "type": "string" },
              "detail": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blocking_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "artifact_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/evidence_ref" }
        },
        "gate_impacts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recommended_patch_proposal_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "backend": {
          "type": "object",
          "required": ["effective", "mode"],
          "properties": {
            "effective": { "type": "string" },
            "mode": {
              "type": "string",
              "enum": ["real", "fixture", "stub"]
            }
          },
          "additionalProperties": false
        },
        "data_cutoff": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },

    "payload_consult_result": {
      "type": "object",
      "required": ["consultation_id", "consultation_type", "status"],
      "properties": {
        "consultation_id": { "type": "string" },
        "consultation_type": { "type": "string" },
        "participant_persona_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "completed", "inconclusive", "cancelled"]
        },
        "consensus_summary": { "type": "string" },
        "disagreements": {
          "type": "array",
          "items": { "type": "string" }
        },
        "risk_notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "conditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/definitions/evidence_ref" }
        },
        "freshness": {
          "type": "string",
          "enum": ["fresh", "stale", "expired"]
        }
      },
      "additionalProperties": false
    },

    "payload_version_patch_proposal": {
      "type": "object",
      "required": ["proposal_id", "base_version", "rationale", "status"],
      "properties": {
        "proposal_id": { "type": "string" },
        "base_version": { "type": "string" },
        "change_summary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "summary"],
            "properties": {
              "path": { "type": "string" },
              "summary": { "type": "string" },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "rationale": { "type": "string" },
        "predicted_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metric", "direction", "confidence"],
            "properties": {
              "metric": { "type": "string" },
              "direction": {
                "type": "string",
                "enum": ["increase", "decrease", "unchanged", "uncertain"]
              },
              "estimated_delta": { "type": "number" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        },
        "validation": {
          "type": "object",
          "properties": {
            "path_policy_valid": { "type": "boolean" },
            "base_hash_valid": { "type": "boolean" },
            "strategy_schema_valid": { "type": "boolean" },
            "policy_valid": { "type": "boolean" },
            "conflicts": {
              "type": "array",
              "items": { "type": "string" }
            },
            "warnings": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "status": {
          "type": "string",
          "enum": ["draft", "validating", "validated", "invalid", "accepted", "rejected", "superseded"]
        }
      },
      "additionalProperties": false
    },

    "payload_version_compare": {
      "type": "object",
      "required": ["base_version", "candidate_versions", "field_diffs", "metric_diffs", "readiness_diffs"],
      "properties": {
        "base_version": {
          "type": "object",
          "required": ["workshop_version_id", "strategy_spec_registry_id", "label"],
          "properties": {
            "workshop_version_id": { "type": "string" },
            "strategy_spec_registry_id": { "type": "string" },
            "label": { "type": "string" }
          },
          "additionalProperties": false
        },
        "candidate_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["workshop_version_id", "strategy_spec_registry_id", "label"],
            "properties": {
              "workshop_version_id": { "type": "string" },
              "strategy_spec_registry_id": { "type": "string" },
              "label": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "field_diffs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "change_kind", "candidate_version_id"],
            "properties": {
              "path": { "type": "string" },
              "change_kind": {
                "type": "string",
                "enum": ["added", "removed", "changed", "unchanged"]
              },
              "candidate_version_id": { "type": "string" },
              "materiality": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"]
              }
            },
            "additionalProperties": false
          }
        },
        "metric_diffs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metric", "candidate_version_id", "evidence_class"],
            "properties": {
              "metric": { "type": "string" },
              "candidate_version_id": { "type": "string" },
              "base_value": { "type": ["number", "null"] },
              "candidate_value": { "type": ["number", "null"] },
              "absolute_delta": { "type": ["number", "null"] },
              "evidence_class": {
                "type": "string",
                "enum": ["predicted", "backtested_in_sample", "backtested_oos", "paper_observed"]
              }
            },
            "additionalProperties": false
          }
        },
        "risk_diffs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["candidate_version_id", "risk_domain", "change"],
            "properties": {
              "candidate_version_id": { "type": "string" },
              "risk_domain": { "type": "string" },
              "change": {
                "type": "string",
                "enum": ["improved", "worsened", "unchanged", "uncertain"]
              },
              "summary": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "readiness_diffs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["candidate_version_id", "gate", "base_state", "candidate_state"],
            "properties": {
              "candidate_version_id": { "type": "string" },
              "gate": {
                "type": "string",
                "enum": ["preliminary_research", "full_validation", "trading_room"]
              },
              "base_state": { "type": "string" },
              "candidate_state": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "recommendation": {
          "type": "object",
          "properties": {
            "recommended_version_id": { "type": "string" },
            "rationale": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "limitations": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "payload_readiness_gate": {
      "type": "object",
      "required": ["gates", "assessed_at"],
      "properties": {
        "gates": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["gate", "state", "requirements"],
            "properties": {
              "gate": {
                "type": "string",
                "enum": ["preliminary_research", "full_validation", "trading_room"]
              },
              "state": {
                "type": "string",
                "enum": ["not_assessed", "blocked", "conditional", "ready", "stale"]
              },
              "requirements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["requirement_id", "title", "hardness", "state"],
                  "properties": {
                    "requirement_id": { "type": "string" },
                    "title": { "type": "string" },
                    "hardness": {
                      "type": "string",
                      "enum": ["hard", "soft"]
                    },
                    "state": {
                      "type": "string",
                      "enum": ["missing", "partial", "satisfied", "waived", "stale"]
                    },
                    "summary": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "blocking_requirement_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "conditional_assumptions": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "hard_blockers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "temporary_assumptions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "staleness_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "highest_ready_gate": {
          "type": ["string", "null"],
          "enum": ["preliminary_research", "full_validation", "trading_room", null]
        },
        "assessed_at": { "type": "string", "format": "date-time" },
        "valid_until": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pantheon/agora/dashboard_recipe/v2",
  "title": "DashboardRecipeV2",
  "type": "object",
  "required": ["spec_version", "recipe_id", "tenant_id", "user_id", "strategy_id", "strategy_version_id", "workspace", "phase", "views", "generated_by", "change_reason", "version", "status", "created_at", "updated_at"],
  "properties": {
    "spec_version": {"type": "string", "const": "2.0"},
    "recipe_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "strategy_version_id": {"type": "string", "minLength": 1},
    "workspace": {"enum": ["trading_room", "strategy_workshop", "strategy_performance"]},
    "phase": {"enum": ["candidate_review", "monitoring", "position_monitoring", "post_trade_review"]},
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/dashboard_view"}
    },
    "generated_by": {"enum": ["system_default", "servant", "user", "learned"]},
    "change_reason": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "previous_version": {"type": ["integer", "null"], "minimum": 1},
    "status": {"enum": ["proposal", "active", "archived", "rolled_back"]},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "definitions": {
    "dashboard_view": {
      "type": "object",
      "required": ["view_id", "title", "purpose", "layout_template_id", "breakpoints", "placements", "widgets"],
      "properties": {
        "view_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "purpose": {"type": "string"},
        "layout_template_id": {"type": "string", "minLength": 1},
        "breakpoints": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "placements": {"type": "array", "items": {"$ref": "#/definitions/widget_placement"}},
        "widgets": {"type": "array", "items": {"$ref": "widget_spec_v2.schema.json"}}
      },
      "additionalProperties": false
    },
    "widget_placement": {
      "type": "object",
      "required": ["widget_id", "x", "y", "w", "h", "min_w", "min_h"],
      "properties": {
        "widget_id": {"type": "string", "minLength": 1},
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "w": {"type": "integer", "minimum": 1},
        "h": {"type": "integer", "minimum": 1},
        "min_w": {"type": "integer", "minimum": 1},
        "min_h": {"type": "integer", "minimum": 1},
        "max_w": {"type": "integer", "minimum": 1},
        "max_h": {"type": "integer", "minimum": 1},
        "pinned": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

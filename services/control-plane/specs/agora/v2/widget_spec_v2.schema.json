{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pantheon/agora/widget_spec/v2",
  "title": "WidgetSpecV2",
  "description": "Safe, registry-backed widget specification for the Agora Trading Desk.",
  "type": "object",
  "required": ["spec_version", "widget_id", "widget_type", "title", "data_source_id", "query", "chart_spec", "interactions", "sensitivity", "can_export", "registry_version", "version", "created_at"],
  "properties": {
    "spec_version": {"type": "string", "const": "2.0"},
    "widget_id": {"type": "string", "minLength": 1},
    "widget_type": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "why_this_widget": {"type": "string"},
    "data_source_id": {"type": "string", "minLength": 1, "description": "Logical allowlisted data-source ID; raw arbitrary URLs are forbidden."},
    "query": {
      "type": "object",
      "required": ["filters"],
      "properties": {
        "filters": {"type": "object", "additionalProperties": true},
        "sort": {"type": "object", "additionalProperties": {"enum": ["asc", "desc"]}},
        "limit": {"type": "integer", "minimum": 1, "maximum": 10000},
        "window": {"type": "string"}
      },
      "additionalProperties": false
    },
    "chart_spec": {"$ref": "chart_spec_v1.schema.json"},
    "interactions": {
      "type": "array",
      "items": {"$ref": "chart_spec_v1.schema.json#/definitions/interaction"},
      "default": []
    },
    "sensitivity": {"enum": ["public_market", "user_private", "broker_sensitive", "restricted"]},
    "can_export": {"type": "boolean"},
    "registry_version": {"type": "string", "const": "widget_registry.v1"},
    "layout_constraints": {
      "type": "object",
      "properties": {
        "min_w": {"type": "integer", "minimum": 1},
        "min_h": {"type": "integer", "minimum": 1},
        "max_w": {"type": "integer", "minimum": 1},
        "max_h": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "version": {"type": "integer", "minimum": 1},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}

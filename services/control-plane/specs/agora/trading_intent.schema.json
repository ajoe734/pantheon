{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pantheon/agora/trading_intent/v1",
  "title": "TradingIntent",
  "description": "Expressed trading intent from an operator or persona in the Agora. Records the stated intent for learning and analysis purposes only — never routes live orders.",
  "type": "object",
  "required": [
    "spec_version",
    "intent_id",
    "operator_id",
    "intent_type",
    "direction",
    "subject",
    "expressed_at",
    "no_order_route_proof"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "intent_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique intent identifier."
    },
    "operator_id": {
      "type": "string",
      "minLength": 1,
      "description": "Operator who expressed this intent."
    },
    "persona_id": {
      "type": "string",
      "description": "Persona that captured or co-expressed this intent."
    },
    "session_id": {
      "type": "string",
      "description": "Agora session context."
    },
    "intent_type": {
      "type": "string",
      "enum": [
        "buy_interest",
        "sell_interest",
        "hold_decision",
        "reduce_exposure",
        "increase_exposure",
        "hedge_intent",
        "exit_intent",
        "entry_interest"
      ],
      "description": "Category of trading intent."
    },
    "direction": {
      "type": "string",
      "enum": ["long", "short", "neutral", "reduce", "exit"],
      "description": "Direction of the expressed intent."
    },
    "subject": {
      "type": "object",
      "required": ["symbol"],
      "properties": {
        "symbol": { "type": "string", "minLength": 1 },
        "asset_class": { "type": "string" },
        "venue": { "type": "string" },
        "strategy_ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "rationale": {
      "type": "string",
      "description": "Free-text rationale for the intent (valuable for imitation learning)."
    },
    "size_hint": {
      "type": "string",
      "enum": ["small", "medium", "large", "full_position"],
      "description": "Approximate size intent. Not a binding order quantity."
    },
    "timeframe_hint": {
      "type": "string",
      "description": "Approximate intended holding period (e.g. 'intraday', '1-3 days', 'swing')."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Operator's self-reported confidence in this intent."
    },
    "linked_event_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "TradingEvent IDs that triggered or informed this intent.",
      "default": []
    },
    "learning_eligible": {
      "type": "boolean",
      "description": "Whether this intent may be used as imitation-learning ground truth.",
      "default": true
    },
    "no_order_route_proof": {
      "type": "string",
      "enum": ["agora_intent_record_only"],
      "description": "Proof claim that this intent record never routes live orders."
    },
    "expressed_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

{
  "manifest_version": "1.10",
  "extends": "v1.9",
  "description": "Additive authoritative Strategy Performance and durable Workshop version contracts. Both capabilities are scoped, governed, restart-persistent, and execution-authority-free.",
  "schema_bundle_index": "services/control-plane/specs/agora/bundle_index.v1_10.json",
  "openapi_ref": "services/control-plane/openapi/agora_v1_10.openapi.yaml",
  "capabilities": [
    {
      "id": "strategy_performance_truth",
      "name": "agora.performance.truth.v1",
      "version": "1.0",
      "description": "User-private per-strategy/per-period compliance, intervention, canonical execution identity, warning, and governed adjustment-suggestion truth with explicit freshness and availability.",
      "schemas": [
        "SourceAvailability",
        "ComplianceMetric",
        "InterventionRecord",
        "ExecutionHistoryRow",
        "PerformanceWarning",
        "SuggestionProvenance",
        "AdjustmentSuggestion",
        "StrategyPerformanceProjection",
        "PerformanceProjectionEnvelope",
        "SuggestionActionRequest",
        "SuggestionActionReceipt",
        "SuggestionActionEnvelope"
      ],
      "routes": [
        "GET /bff/agora/trading-room/strategies/{strategy_id}/performance",
        "POST /bff/agora/trading-room/strategies/{strategy_id}/performance/suggestions/{suggestion_id}/actions",
        "GET /bff/agora/performance/action-receipts/{receipt_id}"
      ],
      "implementation_status": "implemented"
    },
    {
      "id": "durable_workshop_versions",
      "name": "agora.workshop.versions.durable.v1",
      "implementation_status": "implemented",
      "routes": [
        "GET /bff/agora/workshops/{workshop_id}/versions",
        "POST /bff/agora/workshops/{workshop_id}/versions",
        "POST /bff/agora/workshops/{workshop_id}/versions/{version_id}/select"
      ],
      "authoritative_sources": {
        "strategy_spec_json": "strategy_registry",
        "version_link_and_selection": "strategy_workshop_postgres"
      },
      "durability": {
        "backend": "postgres",
        "restart_persistent": true,
        "legacy_active_pointer_backfill": "deterministic"
      },
      "concurrency": {
        "create_idempotency_key_required": true,
        "select_idempotency_key_required": true,
        "select_if_match_required": true,
        "select_atomic_cas": true
      },
      "isolation": {
        "tenant_scoped": true,
        "user_scoped": true,
        "registry_scope_readback_validated_when_present": true
      },
      "execution_authority": "none"
    }
  ],

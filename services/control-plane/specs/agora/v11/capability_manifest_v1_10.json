    "lifecycle_execution_projection": "canonical_trade_journey_projector",
    "compliance_intervention_warning_payloads": "source_owned_fields_on_canonical_lifecycle_events",
    "suggestion_source_and_disposition": "agora_performance_sqlite",
    "action_receipt": "agora_performance_sqlite",
    "audit_event": "agora_performance_sqlite",
    "workshop_version_link_and_selection": "strategy_workshop_postgres",
    "strategy_spec_json": "strategy_registry",
    "frontend": "cache_only_no_authority"
  },
  "migration": {
    "legacy_rows_preserve_existing_payload_fields": true,
    "lock_version_unchanged": true,
    "updated_at_unchanged": true,
    "selected_aliases_only_populated_when_null": true
  },
  "safety_boundary": {
    "missing_data_fabrication": false,
    "local_toast_is_receipt": false,
    "direct_order_route": false,
    "broker_call": false,
    "capital_binding": false,
    "runtime_binding_write": false,
    "live_capital_change": false,
    "execution_authority": "none"

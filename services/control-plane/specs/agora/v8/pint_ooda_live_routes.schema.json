{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pantheon.example/specs/agora/v8/pint_ooda_live_routes.schema.json",
  "title": "Agora PINT and OODA live route payloads",
  "definitions": {
    "ContextRef": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["strategy", "position", "decision_event", "journal_entry", "persona", "performance_window"]
        },
        "id": {"type": "string", "minLength": 1},
        "version_id": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "strategy"}}},
          "then": {
            "required": ["version_id"],
            "properties": {"version_id": {"type": "string", "minLength": 1}}
          }
        }
      ],
      "additionalProperties": false
    },
    "ResolveContextRequest": {
      "type": "object",
      "required": ["context_refs"],
      "properties": {
        "context_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/ContextRef"}
        },
        "workshop_id": {"type": ["string", "null"], "minLength": 1},
        "environment": {
          "enum": ["research", "shadow", "paper", "canary", "live"],
          "default": "research"
        }
      },
      "additionalProperties": false
    },
    "EligibilityRequest": {
      "type": "object",
      "required": ["workshop_id", "mode"],
      "properties": {
        "workshop_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["ask", "challenge", "consult", "propose_action", "reflect"]},
        "environment": {
          "enum": ["research", "shadow", "paper", "canary", "live"],
          "default": "research"
        },
        "required_capability": {"type": "string", "minLength": 1, "default": "persona_opinion"}
      },
      "additionalProperties": false
    },
    "SubmitInteractionRequest": {
      "type": "object",
      "required": ["workshop_id", "mode", "topic", "participant_persona_ids", "context_refs"],
      "properties": {
        "workshop_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["ask", "challenge", "consult", "propose_action", "reflect"]},
        "environment": {
          "enum": ["research", "shadow", "paper", "canary", "live"],
          "default": "research"
        },
        "required_capability": {"type": "string", "minLength": 1, "default": "persona_opinion"},
        "interaction_id": {"type": ["string", "null"], "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "participant_persona_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "context_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/ContextRef"}
        }
      },
      "additionalProperties": false
    },
    "ProposalCreateRequest": {
      "type": "object",
      "required": [
        "proposal_type", "target_kind", "target_id", "target_version",
        "current_value", "proposed_value", "rationale", "evidence_refs",
        "confidence", "expected_benefit", "adverse_scenarios",
        "environment_ceiling", "expires_at", "validation_plan",
        "rollback_trigger", "rollback_action", "required_permissions",
        "required_reviewers"
      ],
      "properties": {
        "proposal_type": {
          "enum": [
            "strategy_patch", "condition_change", "risk_limit_recommendation",
            "research_request", "paper_candidate_request", "allocation_review_request",
            "containment_recommendation", "journal_lesson", "memory_candidate",
            "persona_mutation_review"
          ]
        },
        "target_kind": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "target_version": {"type": "string", "minLength": 1},
        "current_value": {},
        "proposed_value": {},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "expected_benefit": {"type": "string", "minLength": 1},
        "adverse_scenarios": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "environment_ceiling": {"enum": ["analysis", "research", "shadow", "paper", "canary", "live"]},
        "expires_at": {"type": "string", "format": "date-time"},
        "validation_plan": {"type": "object"},
        "rollback_trigger": {"type": "string", "minLength": 1},
        "rollback_action": {"type": "string", "minLength": 1},
        "required_permissions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_reviewers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "human_gate": {"type": "boolean", "default": true},
        "consultation_refs": {"type": "array", "items": {"type": "string"}},
        "workshop_refs": {"type": "array", "items": {"type": "string"}},
        "dependency_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "ProposalActionRequest": {
      "type": "object",
      "required": ["action", "reason"],
      "properties": {
        "action": {"enum": ["request_review", "request_research", "modify", "validate", "approve", "reject", "defer", "cancel"]},
        "reason": {"type": "string", "minLength": 1},
        "proposed_value": {},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "approval_refs": {"type": "array", "items": {"type": "string"}},
        "validation_result": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    },
    "OodaPacket": {
      "type": "object",
      "required": ["packet_id"],
      "properties": {
        "packet_id": {"type": "string", "minLength": 1},
        "status": {"type": "string"},
        "stage": {"enum": ["observe", "orient", "decide", "act", "learn"]},
        "strategy_id": {"type": ["string", "null"]},
        "runtime_id": {"type": ["string", "null"]},
        "evolution_program_id": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  }
}

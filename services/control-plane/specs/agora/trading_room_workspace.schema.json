{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trading_room_workspace.schema.json",
  "title": "TradingRoomWorkspaceContract",
  "description": "V11 Trading Room dynamic workspace proposal, workspace, view, widget, and layout operation contract.",
  "oneOf": [
    {"$ref": "#/definitions/TradingRoomWorkspaceProposal"},
    {"$ref": "#/definitions/TradingRoomWorkspace"},
    {"$ref": "#/definitions/TradingRoomViewSpec"},
    {"$ref": "#/definitions/TradingRoomWidgetSpec"},
    {"$ref": "#/definitions/WorkspaceLayoutOperation"},
    {"$ref": "#/definitions/WidgetRevisionProposal"},
    {"$ref": "#/definitions/TradingRoomDashboardVersion"}
  ],
  "definitions": {
    "TradingRoomWorkspaceProposal": {
      "type": "object",
      "required": [
        "strategyId",
        "strategyVersion",
        "proposalId",
        "generatedAt",
        "status",
        "views",
        "rationale",
        "dataAvailability",
        "warnings",
        "personalizationApplied"
      ],
      "properties": {
        "strategyId": {"type": "string", "minLength": 1},
        "strategyVersion": {"type": "string", "minLength": 1},
        "proposalId": {"type": "string", "minLength": 1},
        "generatedAt": {"type": "string", "format": "date-time"},
        "status": {"enum": ["generating", "preview", "accepted", "cancelled", "superseded"]},
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/TradingRoomViewSpec"}
        },
        "rationale": {"type": "string", "minLength": 1},
        "dataAvailability": {"$ref": "#/definitions/DataAvailabilitySummary"},
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        },
        "personalizationApplied": {"$ref": "#/definitions/PersonalizationSummary"}
      },
      "additionalProperties": false
    },
    "TradingRoomWorkspace": {
      "type": "object",
      "required": [
        "id",
        "userId",
        "strategyId",
        "strategyVersion",
        "dashboardVersion",
        "activeViewId",
        "views",
        "status",
        "generatedBy",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "userId": {"type": "string", "minLength": 1},
        "strategyId": {"type": "string", "minLength": 1},
        "strategyVersion": {"type": "string", "minLength": 1},
        "dashboardVersion": {"type": "integer", "minimum": 1},
        "activeViewId": {"type": "string", "minLength": 1},
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/TradingRoomViewSpec"}
        },
        "status": {"enum": ["generating", "preview", "editing", "active", "stale", "archived"]},
        "generatedBy": {"enum": ["trading_servant", "user_modified", "learned_personalization"]},
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "TradingRoomViewSpec": {
      "type": "object",
      "required": ["id", "title", "purpose", "order", "layoutTemplate", "widgetCount", "widgets"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "layoutTemplate": {"type": "string", "minLength": 1},
        "thumbnailRef": {"type": "string"},
        "widgetCount": {"type": "integer", "minimum": 0},
        "rationale": {"type": "string"},
        "dataAvailability": {"enum": ["complete", "partial", "unavailable"]},
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        },
        "widgets": {
          "type": "array",
          "items": {"$ref": "#/definitions/TradingRoomWidgetSpec"}
        }
      },
      "additionalProperties": false
    },
    "TradingRoomWidgetSpec": {
      "type": "object",
      "required": [
        "id",
        "widgetType",
        "title",
        "purpose",
        "whyIncluded",
        "dataSource",
        "query",
        "chartSpec",
        "interactions",
        "placement",
        "minSize",
        "maxSize",
        "sensitivity"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "widgetType": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "whyIncluded": {"type": "string", "minLength": 1},
        "dataSource": {
          "type": "string",
          "minLength": 1,
          "description": "Logical allowlisted data-source ID; arbitrary URLs are forbidden."
        },
        "query": {
          "type": "object",
          "required": ["filters"],
          "properties": {
            "filters": {"type": "object", "additionalProperties": true},
            "sort": {"type": "object", "additionalProperties": {"enum": ["asc", "desc"]}},
            "limit": {"type": "integer", "minimum": 1, "maximum": 10000},
            "window": {"type": "string"}
          },
          "additionalProperties": false
        },
        "chartSpec": {"$ref": "v2/chart_spec_v1.schema.json"},
        "interactions": {
          "type": "array",
          "items": {"$ref": "v2/chart_spec_v1.schema.json#/definitions/interaction"}
        },
        "placement": {"$ref": "#/definitions/WidgetPlacement"},
        "minSize": {"$ref": "#/definitions/WidgetSize"},
        "maxSize": {"$ref": "#/definitions/WidgetSize"},
        "sensitivity": {"enum": ["public_market", "user_private", "broker_sensitive", "restricted"]},
        "visible": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "WidgetPlacement": {
      "type": "object",
      "required": ["x", "y", "width", "height", "minWidth", "minHeight"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "minWidth": {"type": "integer", "minimum": 1},
        "minHeight": {"type": "integer", "minimum": 1},
        "maxWidth": {"type": "integer", "minimum": 1},
        "maxHeight": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "WidgetSize": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "DataAvailabilitySummary": {
      "type": "object",
      "required": ["status", "sources"],
      "properties": {
        "status": {"enum": ["complete", "partial", "unavailable"]},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dataSource", "status"],
            "properties": {
              "dataSource": {"type": "string", "minLength": 1},
              "status": {"enum": ["complete", "partial", "unavailable"]},
              "reason": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "PersonalizationSummary": {
      "type": "object",
      "required": ["status", "items"],
      "properties": {
        "status": {"enum": ["applied", "not_applied"]},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "value"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "value": {}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "WorkspaceLayoutOperation": {
      "type": "object",
      "required": ["kind", "payload"],
      "properties": {
        "kind": {
          "enum": [
            "move_widget",
            "resize_widget",
            "remove_widget",
            "add_registered_widget",
            "replace_chart_spec",
            "update_widget_query"
          ]
        },
        "widgetId": {"type": "string"},
        "payload": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "WidgetRevisionProposal": {
      "type": "object",
      "required": [
        "id",
        "workspaceId",
        "viewId",
        "widgetId",
        "instruction",
        "beforeSpec",
        "proposedSpec",
        "rationale",
        "warnings",
        "dataAvailability",
        "status"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "workspaceId": {"type": "string", "minLength": 1},
        "viewId": {"type": "string", "minLength": 1},
        "widgetId": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1},
        "beforeSpec": {"$ref": "#/definitions/TradingRoomWidgetSpec"},
        "proposedSpec": {"$ref": "#/definitions/TradingRoomWidgetSpec"},
        "rationale": {"type": "string", "minLength": 1},
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        },
        "dataAvailability": {"enum": ["complete", "partial", "unavailable"]},
        "status": {"enum": ["preview", "accepted", "rejected", "superseded"]}
      },
      "additionalProperties": false
    },
    "TradingRoomDashboardVersion": {
      "type": "object",
      "required": [
        "id",
        "userId",
        "strategyId",
        "strategyVersion",
        "dashboardVersion",
        "generatedBy",
        "previousVersionId",
        "changeSummary",
        "views",
        "createdAt",
        "status",
        "changeLog"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "userId": {"type": "string", "minLength": 1},
        "strategyId": {"type": "string", "minLength": 1},
        "strategyVersion": {"type": "string", "minLength": 1},
        "dashboardVersion": {"type": "integer", "minimum": 1},
        "generatedBy": {"enum": ["trading_servant", "user_modified", "learned_personalization"]},
        "previousVersionId": {"type": ["string", "null"]},
        "changeSummary": {"type": "string", "minLength": 1},
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/TradingRoomViewSpec"}
        },
        "createdAt": {"type": "string", "format": "date-time"},
        "status": {"enum": ["active", "superseded", "rolled_back", "archived"]},
        "changeLog": {"$ref": "#/definitions/WorkspaceChangeLogEntry"}
      },
      "additionalProperties": false
    },
    "WorkspaceChangeLogEntry": {
      "type": "object",
      "required": [
        "changedAt",
        "changedBy",
        "reason",
        "affectedViews",
        "affectedWidgets",
        "effectEvaluation",
        "rollbackAvailable"
      ],
      "properties": {
        "changedAt": {"type": "string", "format": "date-time"},
        "changedBy": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "affectedViews": {
          "type": "array",
          "items": {"type": "string"}
        },
        "affectedWidgets": {
          "type": "array",
          "items": {"type": "string"}
        },
        "effectEvaluation": {"type": "string", "minLength": 1},
        "rollbackAvailable": {"type": "boolean"},
        "sourceRevisionProposalId": {"type": ["string", "null"]},
        "rollbackOfVersionId": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "WorkspaceError": {
      "type": "object",
      "required": ["code", "message", "reason"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "reason": {"type": "string"},
        "details": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    }
  }
}

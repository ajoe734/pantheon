{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pantheon/strategy-spec/v1",
  "title": "StrategySpec",
  "type": "object",
  "required": [
    "spec_version",
    "strategy_id",
    "title",
    "hypothesis",
    "objective",
    "market_scope",
    "data_dependencies",
    "execution_profile",
    "evaluation_plan",
    "governance",
    "provenance"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "draft",
        "candidate",
        "review",
        "approved",
        "archived",
        "rejected",
        "superseded"
      ]
    },
    "market_scope": {
      "type": "object",
      "required": [
        "symbols",
        "frequency"
      ],
      "properties": {
        "symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "asset_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "venues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "frequency": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "data_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "kind"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "dataset",
              "feature_set",
              "paper",
              "repo",
              "note",
              "source_record"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "execution_profile": {
      "type": "object",
      "required": [
        "signal_schema_version",
        "quantity_type"
      ],
      "properties": {
        "signal_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "quantity_type": {
          "type": "string",
          "enum": [
            "SHARES",
            "CASH_VALUE",
            "PERCENT_PORTFOLIO"
          ]
        },
        "rebalance_cadence": {
          "type": "string"
        },
        "execution_mode_hint": {
          "type": "string",
          "enum": [
            "research",
            "paper",
            "canary",
            "live"
          ]
        }
      },
      "additionalProperties": false
    },
    "evaluation_plan": {
      "type": "object",
      "required": [
        "metrics"
      ],
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "candidate_gate": {
          "type": "string",
          "minLength": 1
        },
        "paper_gate": {
          "type": "string",
          "minLength": 1
        },
        "live_gate": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "required": [
        "approval_required"
      ],
      "properties": {
        "approval_required": {
          "type": "boolean"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "risk_profile": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_kind",
        "created_at"
      ],
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "manual",
            "paper",
            "repo",
            "note",
            "workflow"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "created_by": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref_type",
          "ref_id"
        ],
        "properties": {
          "ref_type": {
            "type": "string",
            "enum": [
              "evidence_bundle",
              "evidence_item",
              "source_record",
              "citation",
              "experiment_artifact",
              "registry_entry"
            ]
          },
          "ref_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_item_id": {
            "type": "string",
            "minLength": 1
          },
          "citation_ref": {
            "type": "string",
            "minLength": 1
          },
          "association": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "code_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repo_ref",
          "path"
        ],
        "properties": {
          "repo_ref": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "association": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

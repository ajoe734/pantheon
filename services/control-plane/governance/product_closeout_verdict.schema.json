{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pantheon.local/schemas/product-closeout-verdict.schema.json",
  "title": "Protected product closeout verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "program_id",
    "catalog_sha256",
    "task_id",
    "closeout_manifest_sha256",
    "target_environment",
    "frontend_sha",
    "bff_sha",
    "verdict_id",
    "verifier_capability_sha256",
    "signature_algorithm",
    "key_id",
    "policy_version",
    "signature",
    "revocation_checked_at",
    "ledger_entry_id",
    "actor_id",
    "actor_role",
    "decision",
    "issued_at",
    "expires_at",
    "nonce"
  ],
  "properties": {
    "program_id": {"type": "string", "minLength": 1},
    "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_id": {"type": "string", "minLength": 1},
    "closeout_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_environment": {"type": "string", "minLength": 1},
    "frontend_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "bff_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "verdict_id": {"type": "string", "minLength": 1},
    "verifier_capability_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature_algorithm": {"const": "ed25519"},
    "key_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "minLength": 1},
    "revocation_checked_at": {"type": "string", "format": "date-time"},
    "ledger_entry_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "actor_role": {"enum": ["human", "ops", "human_ops"]},
    "decision": {"enum": ["approved", "rejected"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "minLength": 16}
  }
}

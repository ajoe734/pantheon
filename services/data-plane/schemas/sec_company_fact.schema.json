    "company_name": {"type": ["string", "null"]},
    "taxonomy": {"type": "string"},
    "concept": {"type": "string"},
    "unit": {"type": "string"},
    "value": {},
    "fiscal_year": {"type": ["integer", "string", "null"]},
    "fiscal_period": {"type": ["string", "null"]},
    "form_type": {"type": ["string", "null"]},
    "filed_date": {"type": "string"},
    "end_date": {"type": ["string", "null"]},
    "available_time": {"type": "string"},
    "raw_row": {"type": "object"}
  },
  "additionalProperties": true
}

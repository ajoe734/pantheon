{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MacroFredObservation",
  "type": "object",
  "required": [
    "schema_version",
    "target_table",
    "provider",
    "series_id",
    "observation_date",
    "value",
    "frequency",
    "available_time"
  ],
  "properties": {
    "schema_version": {"const": "macro_fred_observation.v1"},
    "target_table": {"const": "macro_fred_observation"},
    "provider": {"const": "FRED"},
    "series_id": {"type": "string"},
    "observation_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "value": {"type": ["number", "null"]},
    "realtime_start": {"type": ["string", "null"]},
    "realtime_end": {"type": ["string", "null"]},
    "frequency": {"type": "string"},
    "release_lag_days": {"type": ["integer", "null"]},
    "available_time": {"type": "string"},
    "raw_row": {"type": "object"}
  },
  "additionalProperties": true
}

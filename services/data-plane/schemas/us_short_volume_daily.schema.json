{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "USShortVolumeDaily",
  "type": "object",
  "required": [
    "schema_version",
    "target_table",
    "provider",
    "symbol",
    "symbol_canonical",
    "trade_date",
    "short_volume",
    "short_exempt_volume",
    "total_volume",
    "available_time"
  ],
  "properties": {
    "schema_version": {"const": "us_short_volume_daily.v1"},
    "target_table": {"const": "us_short_volume_daily"},
    "provider": {"const": "FINRA"},
    "symbol": {"type": "string"},
    "symbol_canonical": {"type": "string", "pattern": "^[A-Z0-9.-]+\\.US$"},
    "trade_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "market": {"type": ["string", "null"]},
    "short_volume": {"type": ["integer", "null"], "minimum": 0},
    "short_exempt_volume": {"type": ["integer", "null"], "minimum": 0},
    "total_volume": {"type": ["integer", "null"], "minimum": 0},
    "short_volume_ratio": {"type": ["number", "null"], "minimum": 0},
    "available_time": {"type": "string"},
    "raw_row": {"type": "object"}
  },
  "additionalProperties": true
}

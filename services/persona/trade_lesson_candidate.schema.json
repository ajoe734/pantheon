{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pantheon/trade-lesson-candidate/v1",
  "title": "TradeLessonCandidate",
  "description": "Schema representing a memory lesson candidate generated by trade reflections, subject to memory governance gates.",
  "type": "object",
  "required": [
    "lesson_candidate_id",
    "reflection_id",
    "trade_episode_ids",
    "persona_id",
    "scope",
    "proposed_change",
    "confidence",
    "review_state",
    "created_at",
    "updated_at",
    "expiry"
  ],
  "properties": {
    "lesson_candidate_id": {
      "type": "string",
      "format": "uuid"
    },
    "reflection_id": {
      "type": "string",
      "format": "uuid"
    },
    "trade_episode_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "persona_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "proposed_change": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_state": {
      "type": "string",
      "enum": ["proposed", "pending_review", "endorsed", "merged", "quarantined", "rejected", "expired"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expiry": {
      "type": "string",
      "format": "date-time"
    },
    "receipt": {
      "type": ["object", "null"],
      "required": ["operator_id", "decided_at", "action", "reason"],
      "properties": {
        "operator_id": { "type": "string" },
        "decided_at": { "type": "string", "format": "date-time" },
        "action": { "type": "string", "enum": ["endorse", "reject", "quarantine", "expire"] },
        "reason": { "type": "string" },
        "audit_receipt_id": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

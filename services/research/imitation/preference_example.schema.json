{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pantheon/research/imitation/preference-example/v1",
  "title": "PreferenceExample",
  "description": "Governed preference-learning example derived from human trader feedback. It records the chosen/rejected artifact pair used for preference or imitation-adjacent training without granting registry, runtime, or live execution authority.",
  "type": "object",
  "required": [
    "schema_version",
    "example_id",
    "strategy_id",
    "source_feedback_event_id",
    "actor_id",
    "actor_role",
    "action",
    "target",
    "chosen_artifact",
    "rejected_artifact",
    "confidence",
    "observed_at",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "example_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "source_feedback_event_id": {
      "type": "string",
      "minLength": 1
    },
    "correction_trace_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_role": {
      "type": "string",
      "enum": [
        "operator",
        "approver"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "approve",
        "edit",
        "reject"
      ]
    },
    "target": {
      "$ref": "#/definitions/governedTrainingTarget"
    },
    "chosen_artifact": {
      "$ref": "#/definitions/nullableArtifactSnapshot"
    },
    "rejected_artifact": {
      "$ref": "#/definitions/nullableArtifactSnapshot"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "approve"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "chosen_artifact": {
            "$ref": "#/definitions/artifactSnapshot"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "reject"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "rejected_artifact": {
            "$ref": "#/definitions/artifactSnapshot"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "edit"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "correction_trace_id"
        ],
        "properties": {
          "chosen_artifact": {
            "$ref": "#/definitions/artifactSnapshot"
          },
          "rejected_artifact": {
            "$ref": "#/definitions/artifactSnapshot"
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "definitions": {
    "artifactSnapshot": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "nullableArtifactSnapshot": {
      "anyOf": [
        {
          "$ref": "#/definitions/artifactSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "governedTrainingTarget": {
      "type": "object",
      "required": [
        "strategy_id",
        "promotion_state"
      ],
      "properties": {
        "registry_id": {
          "type": "string",
          "minLength": 1
        },
        "strategy_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_type": {
          "type": "string",
          "enum": [
            "strategy_spec",
            "model_artifact",
            "feature_set",
            "prompt_bundle",
            "signal_snapshot",
            "execution_bundle"
          ]
        },
        "promotion_state": {
          "type": "string",
          "enum": [
            "candidate",
            "paper"
          ]
        },
        "lineage_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "registry_id"
          ]
        },
        {
          "required": [
            "artifact_version",
            "artifact_type"
          ]
        },
        {
          "required": [
            "lineage_ref",
            "artifact_type"
          ]
        }
      ]
    }
  }
}

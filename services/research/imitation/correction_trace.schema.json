{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pantheon/research/imitation/correction-trace/v1",
  "title": "CorrectionTrace",
  "description": "Append-only trace of a human correction that can be converted into an edit preference example. It records before/after artifacts and edit operations, but does not mutate registry state or execution behavior.",
  "type": "object",
  "required": [
    "schema_version",
    "trace_id",
    "strategy_id",
    "source_feedback_event_id",
    "actor_id",
    "actor_role",
    "target",
    "before_artifact",
    "after_artifact",
    "operations",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "source_feedback_event_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_role": {
      "type": "string",
      "enum": [
        "operator",
        "approver"
      ]
    },
    "target": {
      "$ref": "#/definitions/governedTrainingTarget"
    },
    "before_artifact": {
      "$ref": "#/definitions/artifactSnapshot"
    },
    "after_artifact": {
      "$ref": "#/definitions/artifactSnapshot"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/correctionOperation"
      }
    },
    "rationale": {
      "type": "string"
    },
    "task_ref": {
      "type": "string",
      "minLength": 1
    },
    "decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "definitions": {
    "artifactSnapshot": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "correctionOperation": {
      "type": "object",
      "required": [
        "path",
        "operation"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "enum": [
            "replace",
            "append",
            "remove",
            "annotate"
          ]
        },
        "old_value": {},
        "new_value": {},
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "governedTrainingTarget": {
      "type": "object",
      "required": [
        "strategy_id",
        "promotion_state"
      ],
      "properties": {
        "registry_id": {
          "type": "string",
          "minLength": 1
        },
        "strategy_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_type": {
          "type": "string",
          "enum": [
            "strategy_spec",
            "model_artifact",
            "behavior_policy",
            "feature_set",
            "prompt_bundle",
            "signal_snapshot",
            "execution_bundle"
          ]
        },
        "promotion_state": {
          "type": "string",
          "enum": [
            "candidate",
            "paper"
          ]
        },
        "lineage_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "registry_id"
          ]
        },
        {
          "required": [
            "artifact_version",
            "artifact_type"
          ]
        },
        {
          "required": [
            "lineage_ref",
            "artifact_type"
          ]
        }
      ]
    }
  }
}

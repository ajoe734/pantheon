{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pantheon/consultation/consult-memo/v1",
  "title": "ConsultMemo",
  "description": "Canonical consultation memo contract. A ConsultMemo records advisory committee, red-team, risk, data, execution, or dissent findings linked to a ConsultRequest. It may recommend review outcomes, but it does not itself execute deployment, rollback, broker, or capital actions.",
  "type": "object",
  "required": [
    "memo_id",
    "request_id",
    "memo_type",
    "author_type",
    "author_ref",
    "target_type",
    "target_id",
    "summary",
    "findings",
    "recommendation",
    "confidence",
    "status",
    "trace_id",
    "created_at",
    "published_at"
  ],
  "properties": {
    "memo_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "memo_type": {
      "type": "string",
      "enum": [
        "committee_summary",
        "redteam_report",
        "risk_review",
        "data_review",
        "execution_review",
        "dissent"
      ]
    },
    "author_type": {
      "type": "string",
      "enum": [
        "persona",
        "human",
        "committee",
        "system"
      ]
    },
    "author_ref": {
      "type": "string",
      "minLength": 1
    },
    "target_type": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/finding"
      }
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "approve",
        "approve_with_conditions",
        "reject",
        "request_more_research",
        "freeze",
        "rollback",
        "escalate"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "published",
        "superseded"
      ]
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "published_at": {
      "$ref": "#/definitions/nullableDateTime"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "published_at": {
            "type": "string",
            "format": "date-time",
            "minLength": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "definitions": {
    "finding": {
      "type": "object",
      "required": [
        "severity",
        "category",
        "claim",
        "evidence_refs",
        "recommendation"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "nullableDateTime": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
